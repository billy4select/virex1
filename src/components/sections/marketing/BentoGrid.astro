---
/**
 * BentoGrid - Equal size card grid
 */

import { Icon } from 'astro-icon/components';

interface BentoItem {
  title: string;
  description: string;
  icon?: string;
  image?: string;
  size?: 'small' | 'medium' | 'large';
  accent?: 'primary' | 'blue' | 'green' | 'purple' | 'orange';
  href?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: BentoItem[];
  background?: 'default' | 'muted' | 'accent';
}

const { title, subtitle, items, background = 'default' } = Astro.props;

const bgClass = {
  default: 'bg-background',
  muted: 'bg-surface',
  accent: 'bg-primary/5',
}[background];

const accentColors = {
  primary: 'from-primary/20 to-primary/5 text-primary',
  blue: 'from-blue-500/20 to-blue-500/5 text-blue-500',
  green: 'from-green-500/20 to-green-500/5 text-green-500',
  purple: 'from-purple-500/20 to-purple-500/5 text-purple-500',
  orange: 'from-orange-500/20 to-orange-500/5 text-orange-500',
};

const hasHeading = title || subtitle;
---

<section class:list={['py-section', bgClass]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {
      hasHeading && (
        <div class="text-center mb-12">
          {title && <h2 class="text-3xl sm:text-4xl font-bold text-text">{title}</h2>}
          {subtitle && <p class="mt-4 text-lg text-text-muted max-w-2xl mx-auto">{subtitle}</p>}
        </div>
      )
    }

    <!-- 兩欄等寬、等高卡片 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:auto-rows-fr">

      {
        items.map((item) => {
          const accent = item.accent || 'primary';
          const Tag = item.href ? 'a' : 'div';

          return (
            <Tag
              href={item.href}
              class:list={[
                'group relative flex flex-col h-full min-h-[220px] p-8 rounded-2xl border border-border bg-background overflow-hidden transition-all duration-300',
                item.href && 'hover:border-primary/50 hover:shadow-lg cursor-pointer',
              ]}
            >
              <!-- Background gradient -->
              <div
                class:list={[
                  'absolute inset-0 bg-linear-to-br opacity-50 transition-opacity group-hover:opacity-70',
                  accentColors[accent],
                ]}
              />

              <!-- Content -->
              <div class="relative z-10 flex flex-col h-full">

                <!-- Icon or Image -->
                {item.image ? (
                  <div class="mb-5 -mx-8 -mt-8">
                    <img
                      src={item.image}
                      alt={item.title}
                      class="w-full h-32 object-cover"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  item.icon && (
                    <div
                      class:list={[
                        'w-14 h-14 rounded-xl flex items-center justify-center mb-5',
                        `bg-linear-to-br ${accentColors[accent]}`,
                      ]}
                    >
                      <Icon name={item.icon} class="w-7 h-7" />
                    </div>
                  )
                )}

                <h3 class="text-xl font-semibold text-text mb-3">
                  {item.title}
                </h3>

                <p class="text-base text-text-muted leading-relaxed flex-1">
                  {item.description}
                </p>

                {item.href && (
                  <div class="mt-5 flex items-center gap-1 text-sm font-medium text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                    Learn more
                    <Icon name="lucide:arrow-right" class="w-4 h-4" />
                  </div>
                )}

              </div>
            </Tag>
          );
        })
      }

    </div>
  </div>
</section>
