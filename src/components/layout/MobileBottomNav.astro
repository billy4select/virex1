---
/**
 * MobileBottomNav - 手機底部快速切換
 * 僅在 md 以下顯示，對齊主導覽精簡項目。
 */
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href);
};

const items = [
  { label: '首頁', href: '/', icon: 'lucide:home' },
  { label: '主題', href: '/topics/', icon: 'lucide:layout-grid' },
  { label: '文章', href: '/blog/', icon: 'lucide:book-open' },
  { label: '工具箱', href: '/resources/', icon: 'lucide:wrench' },
  { label: '關於', href: '/about/', icon: 'lucide:user' },
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-background/95 backdrop-blur-md md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
  aria-label="手機底部導覽"
>
  <ul class="mx-auto grid max-w-lg grid-cols-5">
    {
      items.map((item) => {
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                'flex flex-col items-center gap-0.5 px-1 py-2.5 text-[10px] font-medium transition-colors',
                active ? 'text-primary' : 'text-text-muted hover:text-text',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              <Icon name={item.icon} class="h-5 w-5" aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
