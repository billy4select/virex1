---
/**
 * Header - 全站導覽與文章搜尋入口
 */
import { siteConfig } from '@/config';
import { Icon } from 'astro-icon/components';
import ThemeToggle from '@ui/ThemeToggle.astro';
import BlogSearch from '@/components/blog/BlogSearch.astro';
import type { FeatureFlags } from '@/lib/types';

const { features, navigation } = siteConfig;
const { header: headerNav } = navigation;

// 根據 Feature Flags 過濾導覽專案
const mainNavItems = headerNav.main.filter(
  (item) => !item.feature || features[item.feature as keyof FeatureFlags]
);

// 分離 CTA 按鈕
const ghostCTAs = headerNav.cta.filter((cta) => cta.variant === 'ghost');
const primaryCTA = headerNav.cta.find((cta) => cta.variant === 'primary');

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const normalized = href.endsWith('/') ? href : `${href}/`;
  return normalized === '/' ? currentPath === '/' : currentPath.startsWith(normalized);
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 p-1.5 bg-background/80 backdrop-blur-md border-b border-surface"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="主要導覽">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 group">
        {
          siteConfig.logo ? (
            <img 
              src={siteConfig.logo} 
              alt={siteConfig.name} 
              width="44" 
              height="44"
              loading="eager"
              fetchpriority="high"
              class="h-10 w-10 md:h-11 md:w-11 rounded-full object-cover border-2 border-primary/20 group-hover:border-primary transition-all duration-300 shadow-sm" 
            />
          ) : null
        }
        <div class="flex flex-col leading-none">
          <span class="font-bold text-lg md:text-xl text-text tracking-tight">
            {siteConfig.name.split(' | ')[0]}
          </span>
          <span class="text-[10px] md:text-xs text-text-muted mt-1 font-medium">
            {siteConfig.name.split(' | ')[1] || '比利陳 Billy Chen'}
          </span>
        </div>
      </a>

      <div class="hidden md:flex items-center gap-6">
        {
          mainNavItems.map((item, index) =>
            item.children && item.children.length > 0 ? (
              <div class="relative" data-nav-dropdown>
                <div
                  class:list={[
                    'inline-flex items-center rounded-md transition-colors',
                    isActive(item.href) ? 'bg-surface text-text' : 'text-text-muted hover:text-text',
                  ]}
                >
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class="rounded-l-md py-1 pl-2 pr-1 text-sm font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    data-nav-dropdown-toggle
                    aria-expanded="false"
                    aria-controls={`desktop-dropdown-${index}`}
                    aria-label={`展開${item.label}分類選單`}
                    class="inline-flex items-center rounded-r-md py-1 pl-0.5 pr-1.5 text-current focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    <Icon
                      name="lucide:chevron-down"
                      data-nav-dropdown-chevron
                      class="h-3.5 w-3.5 transition-transform duration-200"
                      aria-hidden="true"
                    />
                  </button>
                </div>

                <div
                  id={`desktop-dropdown-${index}`}
                  data-nav-dropdown-menu
                  hidden
                  class="absolute left-1/2 top-full z-50 w-[560px] max-w-[calc(100vw-2rem)] -translate-x-1/2 pt-2.5"
                >
                  <div class="rounded-2xl border border-border bg-background/95 p-3 shadow-xl backdrop-blur-md">
                    <div class="grid grid-cols-2 gap-1">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                          class:list={[
                            'group rounded-xl px-3 py-2.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary',
                            isActive(child.href) ? 'bg-primary/10 text-primary' : 'hover:bg-surface',
                          ]}
                        >
                          <span
                            class:list={[
                              'block text-sm font-semibold leading-snug transition-colors',
                              isActive(child.href) ? 'text-primary' : 'text-text group-hover:text-primary',
                            ]}
                          >
                            {child.label}
                          </span>
                          {child.description && (
                            <span class="mt-0.5 block line-clamp-1 text-xs text-text-muted">
                              {child.description}
                            </span>
                          )}
                        </a>
                      ))}
                    </div>
                    <div class="mt-2 flex items-center justify-between border-t border-border px-3 pt-2.5 pb-0.5 text-xs">
                      <a
                        href={item.href}
                        class="font-semibold text-primary transition-colors hover:text-primary-dark"
                      >
                        查看全部{item.label}總覽 →
                      </a>
                      <a
                        href="/blog/"
                        class="font-medium text-text-muted transition-colors hover:text-text"
                      >
                        依時間看全部文章 →
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors text-sm font-medium rounded-md px-2 py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background focus:outline-none',
                  isActive(item.href) ? 'text-text bg-surface' : 'text-text-muted hover:text-text',
                ]}
              >
                {item.label}
              </a>
            )
          )
        }
      </div>

      <div class="hidden md:flex items-center gap-4">
        <button
          type="button"
          data-header-search-toggle
          aria-expanded="false"
          aria-controls="header-search-panel"
          aria-label="搜尋文章"
          class="inline-flex h-9 items-center gap-2 rounded-md px-2 text-sm font-medium text-text-muted transition-colors hover:bg-surface hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon name="lucide:search" class="h-4 w-4" aria-hidden="true" />
          <span class="hidden xl:inline">搜尋</span>
        </button>
        <ThemeToggle />
        {
          ghostCTAs.map((cta) => (
            <a
              href={cta.href}
              class="text-text-muted hover:text-text transition-colors text-sm font-medium rounded-md px-2 py-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background focus:outline-none"
            >
              {cta.label}
            </a>
          ))
        }
        {
          primaryCTA && (
            <a
              href={primaryCTA.href}
              class="px-4 py-2 rounded-md bg-primary text-white text-sm font-medium hover:bg-primary-dark transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {primaryCTA.label}
            </a>
          )
        }
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <button
          type="button"
          data-header-search-toggle
          aria-expanded="false"
          aria-controls="header-search-panel"
          aria-label="搜尋文章"
          class="rounded-md p-2 transition-colors hover:bg-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon name="lucide:search" class="h-5 w-5 text-text" aria-hidden="true" />
        </button>
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="開啟導覽選單"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded-md hover:bg-surface transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <Icon
            name="lucide:menu"
            id="menu-icon-open"
            class="w-6 h-6 text-text"
            aria-hidden="true"
          />
          <Icon
            name="lucide:x"
            id="menu-icon-close"
            class="hidden w-6 h-6 text-text"
            aria-hidden="true"
          />
        </button>
      </div>
    </div>
  </nav>
</header>

<div
  id="header-search-backdrop"
  class="fixed inset-0 z-30 hidden bg-black/20 backdrop-blur-[2px]"
  aria-hidden="true"
></div>
<div
  id="header-search-panel"
  hidden
  class="fixed left-0 right-0 z-40 max-h-[calc(100vh-4.75rem)] overflow-y-auto border-b border-border bg-background shadow-xl"
>
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">
      <div class="mb-1 flex items-center justify-end">
        <button
          type="button"
          data-header-search-close
          aria-label="關閉搜尋"
          class="rounded-md p-1.5 text-text-muted transition-colors hover:bg-surface hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <Icon name="lucide:x" class="h-5 w-5" aria-hidden="true" />
        </button>
      </div>
      <BlogSearch />
    </div>
  </div>
</div>

<script is:inline src="/js/blog-search.js" defer></script>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="行動版導覽選單"
>
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-background/80 backdrop-blur-sm"></div>
  <nav
    id="mobile-menu-panel"
    class="absolute left-0 right-0 max-h-[calc(100vh-4.75rem)] overflow-y-auto bg-surface border-b border-background shadow-lg"
    aria-label="行動版導覽"
  >
    <div class="px-4 py-4 space-y-1">
      {
        mainNavItems.map((item, index) =>
          item.children && item.children.length > 0 ? (
            <div data-mobile-dropdown>
              <div class="flex items-center justify-between gap-2">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex-1 rounded-md px-3 py-3 text-base font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset',
                    isActive(item.href)
                      ? 'bg-background font-semibold text-text'
                      : 'text-text-muted hover:bg-background hover:text-text',
                  ]}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  data-mobile-dropdown-toggle
                  aria-expanded="false"
                  aria-controls={`mobile-dropdown-${index}`}
                  aria-label={`展開${item.label}分類`}
                  class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-text-muted transition-colors hover:bg-background hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
                >
                  <Icon
                    name="lucide:chevron-down"
                    data-mobile-dropdown-chevron
                    class="h-4 w-4 transition-transform duration-200"
                    aria-hidden="true"
                  />
                </button>
              </div>
              <div
                id={`mobile-dropdown-${index}`}
                data-mobile-dropdown-menu
                hidden
                class="mt-1 mb-2 ml-3 space-y-0.5 border-l-2 border-border pl-3"
              >
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    aria-current={isActive(child.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-md px-3 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset',
                      isActive(child.href)
                        ? 'bg-background font-semibold text-primary'
                        : 'text-text-muted hover:bg-background hover:text-text',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block px-3 py-3 rounded-md transition-colors text-base font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset',
                isActive(item.href) ? 'text-text bg-background font-semibold' : 'text-text-muted hover:text-text hover:bg-background',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
      <div class="border-t border-border my-2"></div>
      {
        ghostCTAs.map((cta) => (
          <a
            href={cta.href}
            class="block px-3 py-3 rounded-md text-text-muted hover:text-text hover:bg-background transition-colors text-base font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
          >
            {cta.label}
          </a>
        ))
      }
      {
        primaryCTA && (
          <a
            href={primaryCTA.href}
            class="block px-3 py-3 rounded-md bg-primary text-white hover:bg-primary-dark transition-colors text-base font-medium text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
          >
            {primaryCTA.label}
          </a>
        )
      }
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const headerSearchPanel = document.getElementById('header-search-panel');
  const headerSearchBackdrop = document.getElementById('header-search-backdrop');
  const headerSearchToggles = document.querySelectorAll<HTMLElement>('[data-header-search-toggle]');
  const headerSearchClose = document.querySelector<HTMLElement>('[data-header-search-close]');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuPanel = document.getElementById('mobile-menu-panel');
  const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');
  const desktopDropdowns = document.querySelectorAll<HTMLElement>('[data-nav-dropdown]');
  const mobileDropdowns = document.querySelectorAll<HTMLElement>('[data-mobile-dropdown]');

  function closeDesktopDropdown(dropdown: HTMLElement) {
    const toggle = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-toggle]');
    const menu = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-menu]');
    const chevron = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-chevron]');
    if (!menu) return;
    menu.hidden = true;
    toggle?.setAttribute('aria-expanded', 'false');
    chevron?.classList.remove('rotate-180');
  }

  function closeAllDesktopDropdowns() {
    desktopDropdowns.forEach(closeDesktopDropdown);
  }

  function openDesktopDropdown(dropdown: HTMLElement) {
    closeHeaderSearch();
    desktopDropdowns.forEach((other) => {
      if (other !== dropdown) closeDesktopDropdown(other);
    });
    const toggle = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-toggle]');
    const menu = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-menu]');
    const chevron = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-chevron]');
    if (!menu) return;
    menu.hidden = false;
    toggle?.setAttribute('aria-expanded', 'true');
    chevron?.classList.add('rotate-180');
  }

  desktopDropdowns.forEach((dropdown) => {
    const toggle = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-toggle]');
    const menu = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-menu]');
    let closeTimer: number | undefined;

    dropdown.addEventListener('mouseenter', () => {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
      openDesktopDropdown(dropdown);
    });

    dropdown.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(() => {
        closeDesktopDropdown(dropdown);
      }, 140);
    });

    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (menu?.hidden) {
        openDesktopDropdown(dropdown);
      } else {
        closeDesktopDropdown(dropdown);
      }
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node | null;
    if (!target) return;
    desktopDropdowns.forEach((dropdown) => {
      if (!dropdown.contains(target)) {
        closeDesktopDropdown(dropdown);
      }
    });
  });

  mobileDropdowns.forEach((dropdown) => {
    const toggle = dropdown.querySelector<HTMLElement>('[data-mobile-dropdown-toggle]');
    const menu = dropdown.querySelector<HTMLElement>('[data-mobile-dropdown-menu]');
    const chevron = dropdown.querySelector<HTMLElement>('[data-mobile-dropdown-chevron]');

    toggle?.addEventListener('click', () => {
      if (!menu) return;
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      chevron?.classList.toggle('rotate-180', willOpen);
    });
  });

  function updateMenuPosition() {
    if (header && mobileMenuPanel) {
      const headerRect = header.getBoundingClientRect();
      mobileMenuPanel.style.top = `${headerRect.bottom}px`;
    }
  }

  function updateHeaderSearchPosition() {
    if (header && headerSearchPanel && headerSearchBackdrop) {
      const bottom = header.getBoundingClientRect().bottom;
      headerSearchPanel.style.top = `${bottom}px`;
      headerSearchBackdrop.style.top = `${bottom}px`;
    }
  }

  function openHeaderSearch() {
    if (!headerSearchPanel || !headerSearchBackdrop) return;
    closeAllDesktopDropdowns();
    closeMobileMenu();
    updateHeaderSearchPosition();
    headerSearchPanel.hidden = false;
    headerSearchBackdrop.classList.remove('hidden');
    headerSearchToggles.forEach((button) => button.setAttribute('aria-expanded', 'true'));
    window.setTimeout(() => {
      headerSearchPanel.querySelector<HTMLInputElement>('input')?.focus();
    }, 60);
  }

  function closeHeaderSearch() {
    if (!headerSearchPanel || !headerSearchBackdrop) return;
    headerSearchPanel.hidden = true;
    headerSearchBackdrop.classList.add('hidden');
    headerSearchToggles.forEach((button) => button.setAttribute('aria-expanded', 'false'));
  }

  function toggleHeaderSearch() {
    if (!headerSearchPanel) return;
    if (headerSearchPanel.hidden) {
      openHeaderSearch();
    } else {
      closeHeaderSearch();
    }
  }

  headerSearchToggles.forEach((button) => {
    button.addEventListener('click', toggleHeaderSearch);
  });
  headerSearchBackdrop?.addEventListener('click', closeHeaderSearch);
  headerSearchClose?.addEventListener('click', closeHeaderSearch);

  window.addEventListener('resize', () => {
    if (headerSearchPanel && !headerSearchPanel.hidden) updateHeaderSearchPosition();
  });

  function openMobileMenu() {
    closeAllDesktopDropdowns();
    closeHeaderSearch();
    updateMenuPosition();
    mobileMenu?.classList.remove('hidden');
    mobileMenuButton?.setAttribute('aria-expanded', 'true');
    menuIconOpen?.classList.add('hidden');
    menuIconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    mobileMenuButton?.setAttribute('aria-expanded', 'false');
    menuIconOpen?.classList.remove('hidden');
    menuIconClose?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function toggleMobileMenu() {
    const isExpanded = mobileMenuButton?.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMobileMenu);
  mobileMenuBackdrop?.addEventListener('click', closeMobileMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const openDropdown = Array.from(desktopDropdowns).find((dropdown) => {
        const menu = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-menu]');
        return menu && !menu.hidden;
      });
      if (openDropdown) {
        closeDesktopDropdown(openDropdown);
        openDropdown.querySelector<HTMLElement>('[data-nav-dropdown-toggle]')?.focus();
        return;
      }
      if (headerSearchPanel && !headerSearchPanel.hidden) {
        closeHeaderSearch();
        headerSearchToggles[0]?.focus();
        return;
      }
      if (mobileMenuButton?.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
        mobileMenuButton?.focus();
      }
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>