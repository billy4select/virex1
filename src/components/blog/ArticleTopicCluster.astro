---
import type { ArticleTopicCluster } from '@/lib/topic-curation';

interface Props {
  cluster?: ArticleTopicCluster;
}

const { cluster } = Astro.props;
---

{
  cluster && (
    <section
      aria-label="同主題支柱與延伸閱讀"
      class="not-prose mt-10 rounded-2xl border border-border bg-surface/50 p-5 sm:p-6"
      data-pagefind-ignore
    >
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
        <div>
          <p class="text-[11px] font-bold tracking-[0.15em] text-primary">
            主題聚焦 · {cluster.areaName}
          </p>
          <h2 class="mt-1 text-base font-bold tracking-tight text-text sm:text-lg">
            <a href={cluster.pillarHref} class="transition-colors hover:text-primary">
              {cluster.pillarName}
            </a>
          </h2>
        </div>

        <a
          href={cluster.pillarHref}
          class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-primary transition-colors hover:text-primary-dark"
        >
          查看完整主題路線
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        cluster.relatedPosts.length > 0 && (
          <ul class="mt-4 divide-y divide-border/80 border-t border-border/80">
            {cluster.relatedPosts.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-start justify-between gap-4 py-3.5 transition-colors"
                >
                  <div class="min-w-0">
                    <p class="text-sm font-semibold leading-snug text-text transition-colors group-hover:text-primary">
                      {item.title}
                    </p>
                    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-text-muted">
                      {item.summary}
                    </p>
                  </div>
                  <span
                    class="mt-0.5 shrink-0 text-xs font-semibold text-text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-primary"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  )
}
