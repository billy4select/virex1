---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  headings: Heading[];
  faq?: FaqItem[];
}

const { headings, faq = [] } = Astro.props;

const contentHeadings = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .filter((heading) => heading.text?.trim())
  .map((heading) => ({
    depth: heading.depth,
    slug: heading.slug,
    text: heading.text.trim(),
  }));

const faqItems = faq.map((item, index) => ({
  depth: 3,
  slug: `faq-${index + 1}`,
  text: item.q,
}));

const items = [
  ...contentHeadings,
  ...(faqItems.length > 0
    ? [{ depth: 2, slug: 'faq', text: '常見問題' }, ...faqItems]
    : []),
];

const uniqueItems = items.filter(
  (item, index, all) => all.findIndex((candidate) => candidate.slug === item.slug) === index
);

// 太短的文章不需要目錄；FAQ 也會計入可跳讀單位。
if (uniqueItems.length < 4) return null;

const tocId = 'article-toc';
---

<nav
  aria-label="文章目錄"
  class="mb-6 min-w-0 lg:sticky lg:top-24 lg:mb-0 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto"
>
  <div class="rounded-2xl border border-border bg-surface/60 p-4 lg:border-0 lg:bg-transparent lg:p-0">
    <div class="flex items-center justify-between gap-4">
      <p class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
        <span class="h-px w-5 bg-primary" aria-hidden="true"></span>
        目錄
      </p>

      <button
        type="button"
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1.5 text-xs font-medium text-text-muted transition-colors hover:text-primary lg:hidden"
        aria-expanded="false"
        aria-controls={tocId}
        data-toc-toggle
      >
        <span>展開</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
    </div>

    <ul id={tocId} class="mt-3 hidden space-y-0.5 border-l border-border pl-3 lg:mt-4 lg:block">
      {
        uniqueItems.map((item) => (
          <li class:list={[item.depth === 3 && 'pl-3']}>
            <a
              href={`#${item.slug}`}
              class:list={[
                'block rounded-r-md py-1 text-sm leading-snug transition-colors',
                item.depth === 2
                  ? 'font-semibold text-text hover:text-primary'
                  : 'text-text-muted hover:text-primary',
              ]}
              data-toc-link
              data-target={item.slug}
            >
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const initArticleToc = () => {
    document.querySelectorAll('[data-toc-toggle]').forEach((button) => {
      const controls = button.getAttribute('aria-controls');
      const list = controls ? document.getElementById(controls) : null;
      if (!list) return;

      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        list.classList.toggle('hidden');
        const label = button.querySelector('span');
        if (label) label.textContent = expanded ? '展開' : '收合';
      });
    });

    const links = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLElement[];
    if (links.length === 0) return;

    const targets = links
      .map((link) => {
        const id = link.dataset.target;
        return id ? document.getElementById(id) : null;
      })
      .filter((target): target is HTMLElement => Boolean(target));

    if (targets.length === 0) return;

    let ticking = false;

    const update = () => {
      let current = targets[0]?.id ?? '';
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= 120) {
          current = target.id;
        }
      }

      links.forEach((link) => {
        const active = link.dataset.target === current;
        link.classList.toggle('text-primary', active);
        link.classList.toggle('font-semibold', active);
        link.classList.toggle('text-text-muted', !active);
        if (active) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleToc);
  } else {
    initArticleToc();
  }
</script>
