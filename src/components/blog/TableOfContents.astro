---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  headings: Heading[];
  faq?: FaqItem[];
  readingTime?: number;
}

const { headings, faq = [], readingTime = 0 } = Astro.props;

// 桌面只留 H2；手機的「跳到段落」也用同一組，不再把 H3 全部塞進來。
const h2Items = headings
  .filter((heading) => heading.depth === 2 && heading.text?.trim())
  .map((heading) => ({
    depth: 2,
    slug: heading.slug,
    text: heading.text.trim(),
  }));

const items = [
  ...h2Items,
  ...(faq.length > 0 ? [{ depth: 2, slug: 'faq', text: '常見問題' }] : []),
].filter(
  (item, index, all) => all.findIndex((candidate) => candidate.slug === item.slug) === index
);

// 太短的文章不需要目錄。
if (items.length < 3) return null;

const tocId = 'article-toc-mobile';
---

<nav
  aria-label="文章目錄"
  class="not-prose sticky top-16 z-30 -mx-4 mb-6 bg-background/95 px-4 py-2 backdrop-blur-sm lg:top-24 lg:z-auto lg:mx-0 lg:mb-0 lg:self-start lg:bg-transparent lg:p-0 lg:backdrop-blur-none"
>
  {/* 手機：閱讀位置 + 進度 + 跳到段落 */}
  <div class="rounded-2xl border border-border bg-background shadow-sm lg:hidden">
    <div class="flex items-center gap-3 px-3.5 py-3">
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-text" data-reading-current>文章開頭</p>
        <p class="mt-0.5 text-[11px] text-text-muted">
          <span data-reading-percent data-reading-time={readingTime}>0%</span>
          <span aria-hidden="true"> · </span>
          約剩 <span data-reading-remaining>{readingTime}</span> 分鐘
        </p>
      </div>

      <button
        type="button"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1.5 text-xs font-semibold text-text transition-colors hover:text-primary"
        aria-expanded="false"
        aria-controls={tocId}
        data-toc-toggle
      >
        <span>跳到段落</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
    </div>

    <div id={tocId} hidden class="rounded-b-2xl border-t border-border bg-background px-2 py-2">
      <ol class="space-y-0.5">
        {
          items.map((item, index) => (
            <li>
              <a
                href={`#${item.slug}`}
                class="flex items-center gap-3 rounded-lg px-2.5 py-2 text-sm text-text-muted transition-colors hover:bg-background hover:text-primary"
                data-toc-mobile-link
                data-target={item.slug}
              >
                <span class="w-5 shrink-0 text-[10px] font-bold tabular-nums text-text-muted">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0 flex-1 leading-snug">{item.text}</span>
                <span class="text-primary" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  {/* 桌面：只留 H2 */}
  <div class="hidden lg:block">
    <ul class="space-y-0.5 border-l border-border pl-3">
      {
        items.map((item) => (
          <li>
            <a
              href={`#${item.slug}`}
              class="block rounded-r-md py-1 text-sm leading-snug text-text-muted transition-colors hover:text-primary"
              data-toc-link
              data-target={item.slug}
            >
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const initArticleToc = () => {
    const buttons = document.querySelectorAll<HTMLElement>('[data-toc-toggle]');
    const mobileLinks = Array.from(
      document.querySelectorAll<HTMLElement>('[data-toc-mobile-link]')
    );
    const desktopLinks = Array.from(
      document.querySelectorAll<HTMLElement>('[data-toc-link]')
    );

    buttons.forEach((button) => {
      const controls = button.getAttribute('aria-controls');
      const panel = controls ? document.getElementById(controls) : null;
      if (!panel) return;

      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;
      });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          panel.hidden = true;
          button.setAttribute('aria-expanded', 'false');
        });
      });
    });

    const allLinks = [...desktopLinks, ...mobileLinks];
    const targets = allLinks
      .map((link) => {
        const id = link.dataset.target;
        return id ? document.getElementById(id) : null;
      })
      .filter((target): target is HTMLElement => Boolean(target));

    if (targets.length === 0) return;

    const currentLabel = document.querySelector<HTMLElement>('[data-reading-current]');
    const percentLabel = document.querySelector<HTMLElement>('[data-reading-percent]');
    const remainingLabel = document.querySelector<HTMLElement>('[data-reading-remaining]');
    const articleBody = document.querySelector<HTMLElement>('[data-reading-body]');

    let ticking = false;
    let bodyTop = 0;
    let bodyHeight = 1;

    const measure = () => {
      if (!articleBody) return;
      const rect = articleBody.getBoundingClientRect();
      bodyTop = rect.top + window.scrollY;
      bodyHeight = Math.max(1, articleBody.offsetHeight);
    };

    const update = () => {
      let current: HTMLElement | null = null;
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= window.innerHeight * 0.55) current = target;
      }

      const currentText = current
        ? allLinks.find((link) => link.dataset.target === current?.id)?.textContent?.trim() ||
          '文章開頭'
        : '文章開頭';
      if (currentLabel) currentLabel.textContent = currentText;

      allLinks.forEach((link) => {
        const active = Boolean(current) && link.dataset.target === current?.id;
        link.classList.toggle('text-primary', active);
        link.classList.toggle('font-semibold', active);
        link.classList.toggle('text-text-muted', !active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });

      if (articleBody && percentLabel) {
        const viewportAnchor = window.scrollY + 150;
        const progress = Math.min(
          100,
          Math.max(0, Math.round(((viewportAnchor - bodyTop) / Math.max(1, bodyHeight - 200)) * 100))
        );
        const remaining = Math.max(0, Math.round(Number(percentLabel.dataset.readingTime || 0) * (1 - progress / 100)));

        percentLabel.textContent = `${progress}%`;
        if (remainingLabel && Number(percentLabel.dataset.readingTime || 0) > 0) {
          remainingLabel.textContent = String(remaining);
        }
      }

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const initialize = () => {
      measure();
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => {
        measure();
        update();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize);
    } else {
      initialize();
    }
  };

  initArticleToc();
</script>
