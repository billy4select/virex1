---
/**
 * BlogSearch - 文章全文搜尋（Pagefind）
 *
 * 索引在 `npm run build` 之後才會產生（見 package.json 的 build 指令），
 * 所以 `npm run dev` 看不到搜尋結果，會顯示提示文字。
 * 只有 BlogLayout 裡標了 data-pagefind-body 的文章內容會被索引，
 * /threads、/ai-work-team 等靜態頁不會進來。
 */
---

<div class="mb-5">
  <div id="blog-search"></div>
  <p id="blog-search-fallback" class="hidden mt-2 text-xs text-text-muted">
    搜尋索引要在 <code>npm run build</code> 之後才會產生，本機 <code>npm run dev</code> 看不到。
  </p>
</div>

<style is:global>
  /* 讓搜尋框跟主站一致：膠囊圓角（同標籤）、一般字重、跟標籤同級的小字 */
  #blog-search .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #ff6a00;
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-background);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 9999px;
    --pagefind-ui-font: inherit;
  }

  #blog-search .pagefind-ui__search-input {
    height: 44px;
    padding-left: 48px;
    padding-right: 72px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 400;
    background-color: var(--color-surface);
    border: 1px solid transparent;
    transition: border-color 0.2s, background-color 0.2s;
  }
  #blog-search .pagefind-ui__search-input::placeholder {
    font-weight: 400;
    opacity: 0.6;
  }
  #blog-search .pagefind-ui__search-input:focus {
    outline: none;
    border-color: #ff6a00;
    background-color: var(--color-background);
  }
  #blog-search .pagefind-ui__form::before {
    top: 14px;
    left: 18px;
    width: 16px;
    height: 16px;
    opacity: 0.5;
  }
  #blog-search .pagefind-ui__search-clear {
    top: 0;
    right: 8px;
    height: 44px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    background: transparent;
  }
  #blog-search .pagefind-ui__drawer {
    margin-top: 8px;
  }
  #blog-search .pagefind-ui__message {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    height: auto;
    padding: 16px 0 8px;
  }
  #blog-search .pagefind-ui__result {
    padding: 18px 0;
    border-top: 1px solid var(--color-border);
  }
  #blog-search .pagefind-ui__result-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
  }
  #blog-search .pagefind-ui__result-link {
    font-weight: 700;
  }
  #blog-search .pagefind-ui__result-link:hover {
    color: #ff6a00;
  }
  #blog-search .pagefind-ui__result-excerpt {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  #blog-search .pagefind-ui__result-excerpt mark {
    background: #fff0e6;
    color: #e85d00;
    border-radius: 3px;
    padding: 0 2px;
  }
  #blog-search .pagefind-ui__button {
    height: 38px;
    padding: 0 20px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }
  #blog-search .pagefind-ui__button:hover {
    border-color: #ff6a00;
    color: #ff6a00;
    background: var(--color-background);
  }
</style>

<script>
  const mount = document.getElementById('blog-search');

  if (mount) {
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(css);

    const js = document.createElement('script');
    js.src = '/pagefind/pagefind-ui.js';
    js.onload = () => {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      new (window as any).PagefindUI({
        element: '#blog-search',
        showImages: false,
        showSubResults: false,
        pageSize: 8,
        excerptLength: 40,
        resetStyles: false,
        translations: {
          placeholder: '搜尋文章，例如：幻覺、提案、PDF',
          clear_search: '清除',
          load_more: '載入更多結果',
          search_label: '搜尋文章',
          filters_label: '篩選',
          zero_results: '找不到相關文章，換個關鍵字試試',
          many_results: '找到 [COUNT] 篇相關文章',
          one_result: '找到 [COUNT] 篇相關文章',
          alt_search: '找不到完全相符的結果，以下是相近的結果',
          search_suggestion: '找不到相關文章，可以試試其他關鍵字：',
          searching: '搜尋中…',
        },
      });
    };
    js.onerror = () => {
      document.getElementById('blog-search-fallback')?.classList.remove('hidden');
    };
    document.head.appendChild(js);
  }
</script>
