---
import { postUrl } from '@/lib/blog';
import type { BlogPost } from '@/lib/blog';
import { calculateReadingTime } from '@/lib/utils';
import { getThemeByName } from '@/lib/themes';

interface Props {
  post: BlogPost;
  showCategory?: boolean;
}

const { post, showCategory = true } = Astro.props;
const readingTime = calculateReadingTime(post.body || '');
const theme = getThemeByName(post.data.category);
const publishedDate = post.data.publishedDate.toISOString().slice(0, 10).replaceAll('-', '.');
const image = post.data.image;
---

<a
  href={postUrl(post.id)}
  data-blog-post
  data-theme={theme.slug}
  class:list={[
    'group grid gap-4 border-b border-border py-5 transition-colors hover:border-primary/40 sm:items-center',
    image
      ? 'sm:grid-cols-[minmax(0,1fr)_140px]'
      : 'sm:grid-cols-[minmax(0,1fr)_auto]',
  ]}
>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium text-text-muted">
      {showCategory && (
        <>
          <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/5 px-2 py-0.5 text-[11px] font-semibold tracking-wide text-primary">
            {theme.name}
          </span>
          <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true" />
        </>
      )}
      <time datetime={post.data.publishedDate.toISOString()}>
        {publishedDate}
      </time>
      <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
      <span>{readingTime} 分鐘閱讀</span>
    </div>
    <h3 class="mt-2 text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary">
      {post.data.title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-text-muted">
      {post.data.description}
    </p>
  </div>

  {
    image ? (
      <div class="order-first overflow-hidden rounded-xl border border-border bg-surface sm:order-none">
        <img
          src={image}
          alt=""
          width="280"
          height="158"
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </div>
    ) : (
      <span class="hidden text-xs font-semibold text-primary underline decoration-primary/30 decoration-1 underline-offset-4 sm:block">
        閱讀文章 →
      </span>
    )
  }
</a>
