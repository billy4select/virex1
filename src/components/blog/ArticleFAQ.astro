---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs?: FaqItem[];
}

const { faqs = [] } = Astro.props;
---

{
  faqs.length > 0 && (
    <section
      id="faq"
      class="not-prose mt-14 scroll-mt-24 border-t border-border pt-8"
      aria-labelledby="faq-title"
    >
      <h2 id="faq-title" class="text-2xl font-bold tracking-tight text-text">
        常見問題
      </h2>

      <div class="mt-6 divide-y divide-border">
        {faqs.map((item, index) => (
          <div class="py-5 first:pt-0 last:pb-0">
            <h3
              id={`faq-${index + 1}`}
              class="scroll-mt-24 text-base font-bold leading-relaxed text-text"
            >
              {item.q}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  )
}
