---
import { Icon } from 'astro-icon/components';

export interface ArticleSource {
  label: string;
  url: string;
}

interface Props {
  testedAt?: string;
  testNotes?: string;
  sources?: ArticleSource[];
}

const { testedAt, testNotes, sources = [] } = Astro.props;
const hasEvidence = Boolean(testedAt || testNotes || sources.length > 0);
---

{
  hasEvidence && (
    <section
      aria-label="實測條件與官方出處"
      class="not-prose mt-10 rounded-2xl border border-border bg-surface/65 p-5 sm:p-6"
      data-pagefind-ignore
    >
      <div class="flex items-center gap-2 text-xs font-bold tracking-[0.14em] text-primary">
        <Icon name="lucide:shield-check" class="h-4 w-4" aria-hidden="true" />
        <span>實測條件與官方參考出處</span>
      </div>

      {
        (testedAt || testNotes) && (
          <div class="mt-3 space-y-1.5 text-sm leading-relaxed text-text-muted">
            {testedAt && (
              <p>
                <span class="font-semibold text-text">測試日期與環境：</span>
                {testedAt}
              </p>
            )}
            {testNotes && (
              <p>
                <span class="font-semibold text-text">驗證條件：</span>
                {testNotes}
              </p>
            )}
          </div>
        )
      }

      {
        sources.length > 0 && (
          <div class={testedAt || testNotes ? 'mt-4 border-t border-border/80 pt-4' : 'mt-3'}>
            <p class="text-xs font-semibold text-text">參考官方文件與公開來源</p>
            <ol class="mt-2.5 space-y-2 text-sm">
              {sources.map((source, index) => (
                <li class="flex items-baseline gap-2.5">
                  <span class="shrink-0 font-mono text-xs font-semibold text-primary">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-baseline gap-1 font-medium text-text-muted underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary/40"
                  >
                    <span>{source.label}</span>
                    <span class="text-xs" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </section>
  )
}
