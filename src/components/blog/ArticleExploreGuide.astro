---
/**
 * ArticleExploreGuide - 單篇文章底部的全站延伸閱讀引導框
 *
 * 引導讀者前往「從這裡開始」（/start-here/）與「4 大教學專題總覽」（/series/）。
 */
const guideLinks = [
  {
    tag: '新訪客路線',
    title: '從這裡開始',
    href: '/start-here/',
    summary: '依 AI 工作流、行銷診斷、職涯轉型與一人事業，挑一條最適合你現階段的閱讀順序。',
  },
  {
    tag: '系統化實作',
    title: '瀏覽 4 大教學專題',
    href: '/series/',
    summary: '照章節走完打造 AI 團隊、Threads 經營、行銷從診斷開始與 SEO 從零開始完整教學。',
  },
];
---

<section
  aria-label="全站閱讀指南與教學專題"
  class="not-prose mt-10 rounded-2xl border border-border bg-surface/50 p-5 sm:p-6"
  data-pagefind-ignore
>
  <p class="text-[11px] font-bold tracking-[0.15em] text-primary">全站延伸入口</p>
  <h2 class="mt-1 text-base font-bold tracking-tight text-text sm:text-lg">
    想看更多系統化整理，或第一次逛這個網站？
  </h2>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      guideLinks.map((item) => (
        <a
          href={item.href}
          class="group flex flex-col justify-between rounded-xl border border-border bg-background p-4 transition-colors hover:border-primary/40 hover:bg-primary/5"
        >
          <div>
            <span class="text-[11px] font-semibold tracking-wider text-primary">{item.tag}</span>
            <h3 class="mt-1.5 flex items-center justify-between gap-2 text-sm font-bold text-text transition-colors group-hover:text-primary sm:text-base">
              <span>{item.title}</span>
              <span
                class="text-text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-primary"
                aria-hidden="true"
              >
                →
              </span>
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-text-muted sm:text-sm">{item.summary}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
