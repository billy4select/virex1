---
import { themeUrl, type BlogTheme } from '@/lib/themes';

interface Props {
  items: { theme: BlogTheme; count: number }[];
  current?: string;
  variant?: 'cards' | 'pills' | 'tabs';
}

const { items, current, variant = 'cards' } = Astro.props;
const totalCount = items.reduce((sum, item) => sum + item.count, 0);
---

{
  variant === 'cards' ? (
    <nav aria-label="文章研究主題" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {items.map(({ theme, count }) => (
        <a
          href={themeUrl(theme.slug)}
          aria-current={current === theme.slug ? 'page' : undefined}
          class:list={[
            'group flex min-h-36 flex-col justify-between rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md',
            current === theme.slug
              ? 'border-primary bg-primary/10'
              : 'border-border bg-surface hover:border-primary/40 hover:bg-primary/5',
          ]}
        >
          <div>
            <div class="flex items-center justify-end gap-3">
              <span class="text-[11px] font-medium text-text-muted">{count} 篇</span>
            </div>
            <h2 class="mt-3 text-lg font-bold tracking-tight text-text group-hover:text-primary">
              {theme.name}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-text-muted line-clamp-3">
              {theme.description}
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-primary">看這個主題 →</span>
        </a>
      ))}
    </nav>
  ) : variant === 'pills' ? (
    <nav aria-label="文章主題篩選" class="flex flex-wrap items-center gap-2">
      <a
        href="/blog/"
        data-blog-filter="all"
        aria-current={!current ? 'page' : undefined}
        class:list={[
          'rounded-full border px-4 py-2 text-xs font-medium transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md',
          !current
            ? 'border-primary bg-primary/10 font-semibold text-primary'
            : 'border-transparent bg-surface text-text-muted hover:bg-primary/10 hover:text-primary',
        ]}
      >
        全部文章
        <span class="ml-1 opacity-50">{totalCount}</span>
      </a>
      {items.map(({ theme, count }) => (
        <a
          href={`/blog/?theme=${theme.slug}`}
          data-blog-filter={theme.slug}
          aria-current={current === theme.slug ? 'page' : undefined}
          class:list={[
            'rounded-full border px-4 py-2 text-xs font-medium transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md',
            current === theme.slug
              ? 'border-primary bg-primary/10 font-semibold text-primary'
              : 'border-transparent bg-surface text-text-muted hover:bg-primary/10 hover:text-primary',
          ]}
        >
          {theme.shortName}
          <span class="ml-1 opacity-50">{count}</span>
        </a>
      ))}
    </nav>
  ) : (
    <nav aria-label="文章主題">
      <div class="flex flex-wrap items-center gap-2 border-b border-border pb-4 sm:flex-nowrap sm:gap-7 sm:overflow-x-auto sm:pb-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <a
          href="/blog/"
          aria-current={!current ? 'page' : undefined}
          class:list={[
            'inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs transition-colors sm:rounded-none sm:border-x-0 sm:border-t-0 sm:border-b-2 sm:px-0 sm:pb-3.5 sm:pt-0 sm:text-sm',
            !current
              ? 'border-primary bg-primary/10 font-bold text-primary sm:border-b-primary sm:bg-transparent sm:text-text'
              : 'border-border bg-surface font-medium text-text-muted hover:text-text sm:border-b-transparent sm:bg-transparent',
          ]}
        >
          全部
          <span
            class:list={[
              'text-[11px] font-medium tabular-nums',
              !current ? 'text-primary' : 'text-text-muted',
            ]}
          >
            {totalCount}
          </span>
        </a>

        {items.map(({ theme, count }) => (
          <a
            href={themeUrl(theme.slug)}
            aria-current={current === theme.slug ? 'page' : undefined}
            class:list={[
              'inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs transition-colors sm:rounded-none sm:border-x-0 sm:border-t-0 sm:border-b-2 sm:px-0 sm:pb-3.5 sm:pt-0 sm:text-sm',
              current === theme.slug
                ? 'border-primary bg-primary/10 font-bold text-primary sm:border-b-primary sm:bg-transparent sm:text-text'
                : 'border-border bg-surface font-medium text-text-muted hover:text-text sm:border-b-transparent sm:bg-transparent',
            ]}
          >
            {theme.shortName}
            <span
              class:list={[
                'text-[11px] font-medium tabular-nums',
                current === theme.slug ? 'text-primary' : 'text-text-muted',
              ]}
            >
              {count}
            </span>
          </a>
        ))}
      </div>
    </nav>
  )
}
