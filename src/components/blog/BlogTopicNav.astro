---
import { themeUrl, type BlogTheme } from '@/lib/themes';

interface Props {
  items: { theme: BlogTheme; count: number }[];
  current?: string;
  variant?: 'cards' | 'pills';
}

const { items, current, variant = 'cards' } = Astro.props;
---

{
  variant === 'cards' ? (
    <nav aria-label="文章研究主題" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {items.map(({ theme, count }) => (
        <a
          href={themeUrl(theme.slug)}
          aria-current={current === theme.slug ? 'page' : undefined}
          class:list={[
            'group flex min-h-36 flex-col justify-between rounded-2xl border p-5 transition-all',
            current === theme.slug
              ? 'border-primary bg-[#FFF0E6]'
              : 'border-border bg-surface hover:border-primary/40 hover:bg-[#FFF0E6]/40',
          ]}
        >
          <div>
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
                {theme.eyebrow}
              </span>
              <span class="text-[11px] font-medium text-text-muted">{count} 篇</span>
            </div>
            <h2 class="mt-3 text-lg font-bold tracking-tight text-text group-hover:text-primary">
              {theme.name}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-text-muted line-clamp-3">
              {theme.description}
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-primary">看這個主題 →</span>
        </a>
      ))}
    </nav>
  ) : (
    <nav aria-label="文章研究主題" class="flex flex-wrap items-center gap-2">
      <a
        href="/blog/"
        aria-current={!current ? 'page' : undefined}
        class:list={[
          'rounded-full border px-4 py-2 text-xs font-medium transition-all',
          !current
            ? 'border-[#FF6A00] bg-[#FFF0E6] font-semibold text-[#E85D00]'
            : 'border-transparent bg-surface text-text-muted hover:bg-primary/10 hover:text-primary',
        ]}
      >
        全部文章
      </a>
      {items.map(({ theme, count }) => (
        <a
          href={themeUrl(theme.slug)}
          aria-current={current === theme.slug ? 'page' : undefined}
          class:list={[
            'rounded-full border px-4 py-2 text-xs font-medium transition-all',
            current === theme.slug
              ? 'border-[#FF6A00] bg-[#FFF0E6] font-semibold text-[#E85D00]'
              : 'border-transparent bg-surface text-text-muted hover:bg-primary/10 hover:text-primary',
          ]}
        >
          {theme.shortName}
          <span class="ml-1 opacity-50">{count}</span>
        </a>
      ))}
    </nav>
  )
}
