---
/**
 * ArticleActions - 按讚、分享、留言
 * 按讚：本機記錄（localStorage）
 * 分享：Web Share API / 複製連結
 * 留言：導向討論區（Threads）並提供錨點
 */
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';

interface Props {
  title: string;
  url?: string;
}

const { title, url } = Astro.props;
const pageUrl = url || Astro.url.href;
const threadsUrl =
  siteConfig.social?.threads ||
  siteConfig.social?.x ||
  'https://www.threads.net/@billy4select';
---

<div
  class="not-prose mt-10 rounded-2xl border border-border bg-surface p-6"
  data-article-actions
  data-article-url={pageUrl}
  data-article-title={title}
>
  <p class="text-sm font-semibold text-text">這篇文章對你有幫助嗎？</p>
  <p class="mt-1 text-sm text-text-muted">按讚留下記錄，或分享給需要的人。</p>

  <div class="mt-5 flex flex-wrap gap-3">
    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2.5 text-sm font-semibold text-text transition-all duration-300 hover:border-primary/40 hover:text-primary data-[liked=true]:border-primary data-[liked=true]:bg-primary/10 data-[liked=true]:text-primary"
      data-action="like"
      aria-pressed="false"
    >
      <Icon name="lucide:heart" class="h-4 w-4" data-like-icon aria-hidden="true" />
      <span data-like-label>按讚</span>
    </button>

    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2.5 text-sm font-semibold text-text transition-all duration-300 hover:border-primary/40 hover:text-primary"
      data-action="share"
    >
      <Icon name="lucide:share-2" class="h-4 w-4" aria-hidden="true" />
      <span data-share-label>分享</span>
    </button>

    <a
      href="#comments"
      class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2.5 text-sm font-semibold text-text transition-all duration-300 hover:border-primary/40 hover:text-primary"
    >
      <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
      留言
    </a>
  </div>

  <p class="mt-3 hidden text-xs text-text-muted" data-action-status role="status"></p>
</div>

<section id="comments" class="not-prose mt-10 scroll-mt-24 rounded-2xl border border-border bg-surface p-6">
  <h2 class="text-lg font-bold tracking-tight text-text">留言討論</h2>
  <p class="mt-2 text-sm leading-relaxed text-text-muted">
    目前留言開放在 Threads 討論。歡迎分享你的做法、疑問或不同看法。
  </p>
  <div class="mt-5 flex flex-wrap gap-3">
    <a
      href={threadsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
    >
      <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
      到 Threads 留言
    </a>
    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-5 py-2.5 text-sm font-semibold text-text transition-all duration-300 hover:border-primary/40 hover:text-primary"
      data-action="copy-link"
    >
      <Icon name="lucide:link" class="h-4 w-4" aria-hidden="true" />
      複製文章連結
    </button>
  </div>
</section>

<script>
  function initArticleActions() {
    const root = document.querySelector('[data-article-actions]');
    if (!root || root instanceof HTMLElement === false) return;

    const url = root.getAttribute('data-article-url') || window.location.href;
    const title = root.getAttribute('data-article-title') || document.title;
    const storageKey = `article-liked:${url}`;
    const status = root.querySelector('[data-action-status]');
    const likeBtn = root.querySelector('[data-action="like"]');
    const shareBtn = root.querySelector('[data-action="share"]');
    const shareLabel = root.querySelector('[data-share-label]');
    const likeLabel = root.querySelector('[data-like-label]');

    const setStatus = (text) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = text;
      status.classList.remove('hidden');
      window.setTimeout(() => {
        status.classList.add('hidden');
      }, 2200);
    };

    const setLiked = (liked) => {
      if (!(likeBtn instanceof HTMLButtonElement)) return;
      likeBtn.dataset.liked = liked ? 'true' : 'false';
      likeBtn.setAttribute('aria-pressed', liked ? 'true' : 'false');
      if (likeLabel) likeLabel.textContent = liked ? '已按讚' : '按讚';
    };

    setLiked(localStorage.getItem(storageKey) === '1');

    likeBtn?.addEventListener('click', () => {
      const liked = localStorage.getItem(storageKey) === '1';
      if (liked) {
        localStorage.removeItem(storageKey);
        setLiked(false);
        setStatus('已取消按讚');
      } else {
        localStorage.setItem(storageKey, '1');
        setLiked(true);
        setStatus('已按讚，感謝你的回饋');
      }
    });

    const copyLink = async () => {
      try {
        await navigator.clipboard.writeText(url);
        setStatus('已複製連結');
        if (shareLabel) shareLabel.textContent = '已複製';
        window.setTimeout(() => {
          if (shareLabel) shareLabel.textContent = '分享';
        }, 1600);
      } catch {
        setStatus('無法複製，請手動複製網址列');
      }
    };

    shareBtn?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          setStatus('已開啟分享');
          return;
        } catch {
          // user cancelled or failed -> fallback
        }
      }
      await copyLink();
    });

    document.querySelectorAll('[data-action="copy-link"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        void copyLink();
      });
    });
  }

  initArticleActions();
  document.addEventListener('astro:page-load', initArticleActions);
</script>
