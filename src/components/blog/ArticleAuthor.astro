---
import { author, authorBio, logo } from '@/config';

---

<section class="not-prose mt-8 rounded-2xl border border-border bg-surface/60 p-6 md:p-7">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <img
      src={logo}
      alt={author}
      class="h-16 w-16 shrink-0 rounded-full border border-border object-cover"
      loading="lazy"
      width="64"
      height="64"
    />

    <div class="min-w-0">
      <h2 class="text-lg font-bold tracking-tight text-text">{author}</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-muted">{authorBio}</p>
      <p class="mt-3 text-xs">
        <a
          href="/about/"
          class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-primary-dark"
        >
          了解作者與內容來源 →
        </a>
      </p>
    </div>
  </div>
</section>
