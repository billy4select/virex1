---
import { logo } from '@/config';
import { entityConfig } from '@/config/entity';

const quickProfiles = entityConfig.externalProfiles.filter((item) =>
  ['portaly', 'youtube', 'substack', 'threads'].includes(item.id)
);
---

<section
  aria-label="關於作者"
  class="not-prose mt-8 rounded-2xl border border-border bg-surface/60 p-6"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <a href="/about/" rel="author" class="shrink-0">
      <img
        src={logo}
        alt={entityConfig.canonicalBrand}
        class="h-16 w-16 rounded-full border border-border object-cover transition-opacity hover:opacity-90"
        loading="lazy"
        width="64"
        height="64"
      />
    </a>

    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-bold tracking-[0.14em] text-primary">關於作者</p>
      <h2 class="mt-1 text-base font-bold tracking-tight text-text sm:text-lg">
        <a href="/about/" rel="author" class="transition-colors hover:text-primary">
          {entityConfig.canonicalBrand}
        </a>
      </h2>
      <p class="mt-1 text-xs font-medium text-text/80">
        {entityConfig.shortCredentials}
      </p>
      <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-text-muted">
        {entityConfig.bio}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
        <a
          href="/about/"
          rel="author"
          class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-primary-dark"
        >
          完整經歷、五本著作與查核原則 →
        </a>

        <span class="hidden text-border sm:inline" aria-hidden="true">|</span>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-text-muted">
          {
            quickProfiles.map((profile) => (
              <a
                href={profile.href}
                target="_blank"
                rel="me noopener noreferrer"
                class="transition-colors hover:text-primary"
              >
                {profile.id === 'portaly' ? 'Portaly' : profile.id === 'substack' ? 'Substack' : profile.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
