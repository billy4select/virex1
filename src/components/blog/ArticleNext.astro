---
import { postUrl } from '@/lib/blog';

interface NextPost {
  id: string;
  title: string;
  description: string;
  category?: string;
}

interface Props {
  post?: NextPost;
}

const { post } = Astro.props;
---

{
  post && (
    <a
      href={postUrl(post.id)}
      class="not-prose group mt-12 block border-t border-border pt-8"
    >
      <div class="flex items-start justify-between gap-6">
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-primary">
            下一篇
          </p>
          {post.category && (
            <p class="mt-2 text-[11px] font-medium text-text-muted">{post.category}</p>
          )}
          <h2 class="mt-3 text-xl font-bold leading-snug tracking-tight text-text transition-colors group-hover:text-primary md:text-2xl">
            {post.title}
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-muted line-clamp-2">
            {post.description}
          </p>
        </div>

        <span class="mt-1 hidden shrink-0 text-xs font-semibold text-text-muted transition-colors group-hover:text-primary sm:inline-flex sm:items-center sm:gap-2">
          繼續讀
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </span>
      </div>
    </a>
  )
}
