---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  ariaLabel?: string;
  class?: string;
}

const { items, ariaLabel = '麵包屑', class: className = '' } = Astro.props;
---

<nav
  aria-label={ariaLabel}
  class:list={['bg-background', className]}
  data-pagefind-ignore
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ol
      class="flex min-h-10 flex-wrap items-center gap-x-1.5 gap-y-0.5 py-2.5 text-xs font-medium text-text-muted"
      role="list"
    >
      {
        items.map((item, index) => {
          const isCurrent = index === items.length - 1 || !item.href;
          return (
            <li class="flex min-w-0 items-center gap-x-1.5">
              {index > 0 && (
                <span aria-hidden="true" class="text-text-muted/45">
                  ›
                </span>
              )}
              {isCurrent ? (
                <span class="truncate text-text" aria-current="page">
                  {item.label}
                </span>
              ) : (
                <a
                  href={item.href}
                  class="shrink-0 transition-colors hover:text-primary"
                >
                  {item.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</nav>
