---
import { Icon } from 'astro-icon/components';
import type { HomeSeries } from '@/lib/homepage';

interface Props {
  series: HomeSeries[];
}

const { series } = Astro.props;
---

<section id="series" class="bg-surface py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          深入學習
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted md:text-right">
        兩個可以照順序讀完的系列。
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        series.map((item, sIndex) => (
          <article class="group flex h-full flex-col rounded-2xl border border-border bg-background p-6 transition-all duration-300 hover:border-primary/40 hover:shadow-md">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-sm font-medium tabular-nums text-primary">
                {String(sIndex + 1).padStart(2, '0')}
              </span>
              <span class="text-[11px] font-bold tracking-[0.15em] text-text-muted">
                {item.theme}
              </span>
            </div>

            <h3 class="mt-5 text-xl font-extrabold tracking-tight text-text md:text-2xl">
              {item.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted md:text-base">
              {item.description}
            </p>

            <ul class="mt-6 space-y-0 border-t border-border">
              {
                item.chapters.map((chapter, index) => (
                  <li class="border-b border-border">
                    <a
                      href={chapter.href}
                      class="group flex items-center gap-3 py-3.5 transition-colors hover:text-primary"
                    >
                      <span class="font-mono text-xs tabular-nums text-primary/40">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="flex-1 text-sm font-medium text-text transition-colors group-hover:text-primary">
                        {chapter.label}
                      </span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="h-3.5 w-3.5 shrink-0 text-text-muted transition-colors group-hover:text-primary"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-auto pt-6">
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-colors hover:underline"
              >
                進入系列
                <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
