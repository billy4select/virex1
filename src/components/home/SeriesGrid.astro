---
import { Icon } from 'astro-icon/components';
import type { HomeSeries } from '@/lib/homepage';

interface Props {
  series: HomeSeries[];
}

const { series } = Astro.props;
---

<section id="series" class="bg-background py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl">
        深入學習
      </h2>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        series.map((item) => (
          <article class="flex h-full flex-col rounded-3xl border border-border bg-background p-6 md:p-8">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-primary/10 px-3 py-1 text-[11px] font-semibold text-primary">
                {item.theme}
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
              {item.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted md:text-base">
              {item.description}
            </p>

            <ul class="mt-6 space-y-1.5 border-t border-border pt-4">
              {
                item.chapters.map((chapter, index) => (
                  <li>
                    <a
                      href={chapter.href}
                      class="group flex items-center gap-3 rounded-xl px-2 py-2.5 transition-colors hover:bg-surface"
                    >
                      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-[10px] font-bold text-primary">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="flex-1 text-sm font-medium text-text transition-colors group-hover:text-primary">
                        {chapter.label}
                      </span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="h-3.5 w-3.5 shrink-0 text-text-muted transition-colors group-hover:text-primary"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-auto border-t border-border pt-5">
              <a
                href={item.href}
                class="inline-flex items-center gap-1 rounded-full border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white"
              >
                進入專題
                <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
