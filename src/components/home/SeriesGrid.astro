---
import { Icon } from 'astro-icon/components';
import type { HomeSeries } from '@/lib/homepage';

interface Props {
  series: HomeSeries[];
}

const { series } = Astro.props;
---

<section id="series" class="bg-surface py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
          完整專題
        </p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-text md:text-4xl">
          不想只看單篇文章，走一條完整路線。
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          兩個專題各有明確目標。從第一個單元開始，一路走到可以實際使用的成果。
        </p>
      </div>
      <a
        href="/blog/"
        class="hidden items-center gap-1 text-sm font-semibold text-primary transition-colors hover:text-primary-dark sm:inline-flex"
      >
        先看所有文章
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        series.map((item) => (
          <article class="flex h-full flex-col rounded-3xl border border-border bg-background p-6 md:p-8">
            <div class="flex items-center justify-between gap-4">
              <span class="rounded-full bg-primary/10 px-3 py-1 text-[11px] font-semibold text-primary">
                {item.theme}
              </span>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
            </div>

            <h3 class="mt-6 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
              {item.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted md:text-base">
              {item.description}
            </p>

            <div class="mt-5 rounded-2xl bg-surface p-4">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
                走完你會得到
              </p>
              <p class="mt-2 text-sm leading-relaxed text-text">
                {item.outcome}
              </p>
            </div>

            <ul class="mt-5 hidden space-y-2 sm:block">
              {
                item.chapters.map((chapter, index) => (
                  <li>
                    <a
                      href={chapter.href}
                      class="group flex items-center gap-3 rounded-xl px-2 py-2.5 transition-colors hover:bg-surface"
                    >
                      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-[10px] font-bold text-primary">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="flex-1 text-sm font-medium text-text transition-colors group-hover:text-primary">
                        {chapter.label}
                      </span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="h-3.5 w-3.5 shrink-0 text-text-muted transition-colors group-hover:text-primary"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
              >
                進入專題
                <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
              </a>
              <span class="text-xs font-medium text-text-muted">{item.meta}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
