---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '@/lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section id="thinking" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          一些值得思考的事
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted md:text-right">
        關於工作、學習、商業與成長的觀察。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        posts.map((post, index) => (
          <a
            href={postUrl(post.id)}
            class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
          >
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-sm font-medium tabular-nums text-primary">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary">
                閱讀
                <Icon
                  name="lucide:arrow-right"
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                />
              </span>
            </div>
            <h3 class="mt-4 text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary md:text-xl">
              {post.data.title}
            </h3>
            <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-text-muted">
              {post.data.description}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
