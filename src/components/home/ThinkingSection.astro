---
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '@/lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section id="thinking" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-bold tracking-[0.2em] text-primary">02</p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          一些值得思考的事
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted md:text-right">
        關於工作、學習、商業與成長的觀察。
      </p>
    </div>

    <ol class="mt-12 space-y-0 border-t border-border">
      {
        posts.map((post, index) => (
          <li>
            <a
              href={postUrl(post.id)}
              class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-border py-6 transition-colors hover:bg-background/50 md:grid-cols-[4rem_1fr_20rem] md:gap-8 md:py-7"
            >
              <span class="font-mono text-xl font-light tabular-nums text-primary/40 transition-colors group-hover:text-primary md:text-2xl">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="text-lg font-semibold leading-snug text-text transition-colors group-hover:text-primary md:text-xl">
                {post.data.title}
              </h3>
              <p class="col-start-2 mt-1 line-clamp-2 text-sm leading-relaxed text-text-muted md:col-start-3 md:mt-0 md:text-right">
                {post.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
