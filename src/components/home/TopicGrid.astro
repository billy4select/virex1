---
import { Icon } from 'astro-icon/components';
import type { HomeTopic } from '@/lib/homepage';

interface Props {
  topics: HomeTopic[];
}

const { topics } = Astro.props;
---

<section id="topics" class="bg-surface pb-16 pt-10 md:pb-20 md:pt-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl">
        三個主題
      </h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted">
        能力、商業與個人發展。從你現在最想解決的問題開始。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        topics.map((topic) => (
          <a
            href={topic.href}
            class="group flex h-full flex-col rounded-2xl border border-border bg-background p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
          >
            <h3 class="text-2xl font-bold tracking-tight text-text transition-colors group-hover:text-primary">
              {topic.name}
            </h3>
            <p class="mt-2 text-sm font-semibold leading-relaxed text-primary">
              {topic.question}
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
              {topic.description}
            </p>


            <span class="mt-6 inline-flex w-fit items-center gap-1 rounded-full border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-white">
              進入主題
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
