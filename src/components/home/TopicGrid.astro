---
import { Icon } from 'astro-icon/components';
import type { HomeTopic } from '@/lib/homepage';

interface Props {
  topics: HomeTopic[];
}

const { topics } = Astro.props;
---

<section id="topics" class="bg-surface py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-bold tracking-[0.2em] text-primary">02</p>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-text md:text-4xl">
          探索四大主題
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted md:text-right">
        從問題出發，找到適合的閱讀起點。
      </p>
    </div>

    <div class="mt-12 space-y-0 border-t border-border">
      {
        topics.map((topic, index) => (
          <a
            href={topic.href}
            class="group grid grid-cols-[auto_1fr_auto] items-start gap-4 border-b border-border py-7 transition-colors hover:bg-background/60 md:grid-cols-[4rem_12rem_1fr_auto] md:items-center md:gap-8 md:py-8"
          >
            <span class="font-mono text-2xl font-light tabular-nums text-primary/50 transition-colors group-hover:text-primary md:text-3xl">
              {String(index + 1).padStart(2, '0')}
            </span>

            <h3 class="text-xl font-bold tracking-tight text-text transition-colors group-hover:text-primary md:text-2xl">
              {topic.name}
            </h3>

            <div class="col-span-2 mt-1 md:col-span-1 md:mt-0">
              <p class="text-sm font-semibold leading-relaxed text-primary md:text-base">
                {topic.question}
              </p>
              <p class="mt-1.5 text-sm leading-relaxed text-text-muted">
                {topic.description}
              </p>
            </div>

            <span class="hidden items-center justify-center rounded-full border border-border p-2.5 text-text-muted transition-all group-hover:border-primary group-hover:bg-primary group-hover:text-white md:inline-flex">
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
