---
import { Icon } from 'astro-icon/components';
import type { HomeTopic } from '@/lib/homepage';

interface Props {
  topics: HomeTopic[];
}

const { topics } = Astro.props;
---

<section id="topics" class="bg-background pb-16 pt-10 md:pb-20 md:pt-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
        三個研究方向
      </p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-text md:text-4xl">
        先選你現在想解決的問題。
      </h2>
      <p class="mt-4 text-base leading-relaxed text-text-muted">
        能力、商業與個人發展，三個主題各自回答不同的問題。不用從頭看完，先從最接近你現況的那一個開始。
      </p>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        主題是長期方向，專題是有順序的完整路線，問題入口則是單篇文章。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        topics.map((topic, index) => (
          <a
            href={topic.href}
            class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:bg-primary/5 hover:shadow-lg"
          >
            <div class="flex items-start justify-between gap-4">
              <span class="text-[11px] font-bold tracking-[0.2em] text-primary">
                0{index + 1}
              </span>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon name={topic.icon} class="h-5 w-5" />
              </span>
            </div>

            <h3 class="mt-6 text-xl font-bold tracking-tight text-text transition-colors group-hover:text-primary">
              {topic.name}
            </h3>
            <p class="mt-2 text-sm font-semibold leading-relaxed text-primary">
              {topic.question}
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
              {topic.description}
            </p>

            <ul class="mt-5 space-y-2 border-t border-border pt-4">
              {topic.points.map((point) => (
                <li class="flex items-start gap-2 text-xs leading-relaxed text-text-muted">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>

            <div class="mt-6 flex items-center gap-1 text-xs font-semibold text-primary">
              進入主題
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
