---
interface ReaderFeedbackItem {
  quote: string;
  author: string;
  role: string;
  company: string;
  avatar?: string;
}

interface Props {
  testimonials: ReaderFeedbackItem[];
}

const { testimonials } = Astro.props;

const getInitials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);

const getContext = (role: string, company: string) => {
  if (!company) return role;
  if (company === '電子書') return '電子書讀者';
  if (company === '比利社群') return '社群讀者';
  return `${company}讀者`;
};
---

<section id="feedback" class="bg-surface py-16 md:py-24" aria-labelledby="feedback-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 id="feedback-title" class="text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          讀者怎麼說
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          來自我過去寫的電子書、課程與社群讀者。
        </p>
      </div>
      <a
        href="/testimonials/"
        class="inline-flex items-center gap-1 text-sm font-semibold text-primary underline decoration-primary/30 decoration-1 underline-offset-4 transition-colors hover:text-primary-dark hover:decoration-primary"
      >
        看更多讀者怎麼說
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        testimonials.map((item) => (
          <figure class="flex h-full flex-col rounded-2xl border border-border bg-background p-6">
            <span class="font-serif text-3xl leading-none text-primary/40" aria-hidden="true">
              “
            </span>
            <blockquote class="mt-3 flex-1 text-lg font-medium leading-relaxed text-text">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-border pt-4">
              {item.avatar ? (
                <img
                  src={item.avatar}
                  alt={item.author}
                  class="h-10 w-10 rounded-full object-cover"
                  loading="lazy"
                />
              ) : (
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
                  {getInitials(item.author)}
                </span>
              )}
              <div>
                <div class="text-sm font-bold text-text">{item.author}</div>
                <div class="mt-0.5 text-xs text-text-muted">
                  {getContext(item.role, item.company)}
                </div>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-6 text-xs leading-relaxed text-text-muted">
      回饋來自讀者親身使用後的分享，不代表每個人都會有一樣的結果。
    </p>
  </div>
</section>
