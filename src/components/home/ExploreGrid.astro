---
import { Icon } from 'astro-icon/components';
import type { HomeExploreEntry } from '@/lib/homepage';

interface Props {
  entries: HomeExploreEntry[];
}

const { entries } = Astro.props;
---

<section id="explore" class="bg-surface py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-bold tracking-[0.2em] text-primary">01</p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          從你感興趣的事情開始
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted md:text-right">
        先選你現在最想解決的事。
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        entries.map((item, index) => (
          <a
            href={item.href}
            class="group flex h-full flex-col rounded-2xl border border-border bg-background p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
          >
            <span class="font-mono text-sm font-medium tabular-nums text-primary">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="mt-4 text-[11px] font-bold uppercase tracking-[0.2em] text-text-muted">
              {item.label}
            </span>
            <h3 class="mt-2 text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary md:text-xl">
              {item.question}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
              {item.description}
            </p>
            <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-primary">
              開始探索
              <Icon
                name="lucide:arrow-right"
                class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
