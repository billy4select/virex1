---
import { Icon } from 'astro-icon/components';
import type { HomeExploreEntry } from '@/lib/homepage';

interface Props {
  entries: HomeExploreEntry[];
}

const { entries } = Astro.props;
---

<section id="explore" class="bg-background py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl">
        從你感興趣的事情開始
      </h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        不一定要從主題進去。先選你現在最想解決的事。
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        entries.map((item) => (
          <a
            href={item.href}
            class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
          >
            <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
              {item.label}
            </span>
            <h3 class="mt-3 text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary">
              {item.question}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
              {item.description}
            </p>
            <span class="mt-5 inline-flex w-fit items-center gap-1 text-xs font-semibold text-primary">
              開始探索
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
