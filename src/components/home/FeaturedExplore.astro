---
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '@/lib/blog';
import { calculateReadingTime } from '@/lib/utils';
import { getThemeByName } from '@/lib/themes';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section id="featured-explore" class="bg-background py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl">
        近期值得探索
      </h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        編輯精選，優先呈現能代表網站價值的內容。
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        posts.map((post) => {
          const theme = getThemeByName(post.data.category);
          const readingTime = calculateReadingTime(post.data.description || '');
          return (
            <a
              href={postUrl(post.id)}
              class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
            >
              <span class="text-[11px] font-bold uppercase tracking-[0.15em] text-primary">
                {theme?.shortName || post.data.category}
              </span>
              <h3 class="mt-3 text-base font-bold leading-snug text-text transition-colors group-hover:text-primary md:text-lg">
                {post.data.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted line-clamp-3">
                {post.data.description}
              </p>
              <div class="mt-4 flex items-center gap-2 text-xs text-text-muted">
                <time datetime={post.data.publishedDate.toISOString()}>
                  {post.data.publishedDate.toLocaleDateString('zh-TW', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span aria-hidden="true">·</span>
                <span>{readingTime} 分鐘</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
