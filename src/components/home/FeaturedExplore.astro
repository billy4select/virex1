---
import type { CollectionEntry } from 'astro:content';
import { postUrl } from '@/lib/blog';
import { getThemeByName } from '@/lib/themes';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section id="featured-explore" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-bold tracking-[0.2em] text-primary">02</p>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-text md:text-4xl">
          近期值得探索
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-muted md:text-right">
        編輯精選，優先呈現<br class="hidden md:block" />能代表網站價值的內容。
      </p>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        posts.map((post, index) => {
          const theme = getThemeByName(post.data.category);
          return (
            <li>
              <a
                href={postUrl(post.id)}
                class="group flex h-full flex-col"
              >
                <div class="flex items-baseline justify-between gap-3 border-b border-border pb-3">
                  <span class="font-mono text-2xl font-light tabular-nums text-primary/40 transition-colors group-hover:text-primary">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[11px] font-bold tracking-[0.12em] text-text-muted">
                    {theme?.shortName || post.data.category}
                  </span>
                </div>
                <h3 class="mt-4 text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-text-muted">
                  {post.data.description}
                </p>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
