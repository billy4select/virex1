---
import { postUrl } from '@/lib/blog';
import type { BlogPost } from '@/lib/blog';
import { calculateReadingTime } from '@/lib/utils';

interface Props {
  post: BlogPost;
  label?: string;
}

const { post, label = '主編精選' } = Astro.props;
const readingTime = calculateReadingTime(post.body || '');
const dateLabel = post.data.publishedDate.toISOString().slice(0, 10).replaceAll('-', '.');
---

<article class="mt-8 border-y border-border bg-background">
  <a
    href={postUrl(post.id)}
    class="group grid gap-6 px-5 py-8 md:grid-cols-[130px_minmax(0,1fr)] md:items-start md:gap-10 md:px-8 md:py-10"
  >
    <div class="flex items-start justify-between gap-4 md:h-full md:flex-col md:justify-between md:gap-8">
      <div>
        <p class="text-sm font-bold tracking-[0.16em] text-primary">{label}</p>
      </div>
      <div class="text-right text-[11px] leading-relaxed text-text-muted md:text-left">
        <time datetime={post.data.publishedDate.toISOString()}>{dateLabel}</time>
        <br />
        {readingTime} 分鐘閱讀
      </div>
    </div>

    <div>
      <p class="text-[11px] font-semibold tracking-[0.16em] text-text-muted">
        {post.data.category}
      </p>
      <h3 class="mt-3 text-3xl font-extrabold leading-[1.18] tracking-tight text-text transition-colors group-hover:text-primary md:text-4xl">
        {post.data.title}
      </h3>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-text-muted md:text-base">
        {post.data.description}
      </p>

      <span class="mt-6 inline-flex w-fit items-center gap-1 rounded-full border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors group-hover:border-primary/40 group-hover:bg-primary group-hover:text-white">
        閱讀全文
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>
