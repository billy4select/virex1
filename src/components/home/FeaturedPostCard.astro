---
import { postUrl } from '@/lib/blog';
import type { BlogPost } from '@/lib/blog';
import { calculateReadingTime } from '@/lib/utils';

interface Props {
  post: BlogPost;
  label?: string;
}

const { post, label = '主編精選' } = Astro.props;
const readingTime = calculateReadingTime(post.body || '');
const publishedDate = post.data.publishedDate.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="mt-8 overflow-hidden rounded-3xl border border-border border-l-4 border-l-primary bg-surface">
  <a href={postUrl(post.id)} class="group block p-6 md:p-8">
    <div class="flex flex-wrap items-center gap-2 text-[11px] font-medium text-text-muted">
      <span class="rounded-full bg-primary/10 px-2.5 py-1 font-bold text-primary">
        {label}
      </span>
      <span>{post.data.category}</span>
      <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
      <time datetime={post.data.publishedDate.toISOString()}>{publishedDate}</time>
      <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
      <span>{readingTime} 分鐘閱讀</span>
    </div>

    <h3 class="mt-4 text-2xl font-extrabold leading-snug tracking-tight text-text transition-colors group-hover:text-primary md:text-3xl">
      {post.data.title}
    </h3>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-text-muted md:text-base">
      {post.data.description}
    </p>

    <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary">
      閱讀這篇
      <span aria-hidden="true">→</span>
    </span>
  </a>
</article>
