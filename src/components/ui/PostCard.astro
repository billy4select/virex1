---
// src/components/ui/PostCard.astro
const { post } = Astro.props;
import { calculateReadingTime, formatCompactDate } from '@/lib/utils';
import { postUrl } from '@/lib/blog';

const readingTime = calculateReadingTime(post.body || '');
const publishedDate = formatCompactDate(post.data.publishedDate);
const category = post.data.category;
---

<article class="group border-b border-border">
  <a
    href={postUrl(post.id)}
    class="grid gap-4 py-7 transition-colors md:grid-cols-[minmax(0,1fr)_auto] md:items-start md:gap-8 md:py-8"
  >
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[11px] font-medium text-text-muted">
        {category && <span class="font-semibold text-primary">{category}</span>}
        <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
        <time datetime={post.data.publishedDate.toISOString()}>{publishedDate}</time>
        <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
        <span>{readingTime} 分鐘</span>
      </div>

      <h2 class="mt-3 text-xl font-bold leading-snug tracking-tight text-text transition-colors group-hover:text-primary md:text-[1.6rem]">
        {post.data.title}
      </h2>

      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-text-muted line-clamp-2 md:text-[15px]">
        {post.data.description}
      </p>
    </div>

    <span
      class="hidden items-center gap-2 self-center text-xs font-semibold text-text-muted transition-colors group-hover:text-primary md:inline-flex"
    >
      閱讀
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="M5 12h14"></path>
        <path d="m13 6 6 6-6 6"></path>
      </svg>
    </span>
  </a>
</article>
