---
/**
 * SEO - 完整版
 *
 * 全站唯一的 title / description / canonical / Open Graph / JSON-LD 出口。
 * 呼叫端可以傳入已含品牌的名稱，這裡會自動避免重複附加站名。
 */
import { siteConfig } from '@/config';
import { getThemeBySlug } from '@/lib/themes';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  section?: string;
  sectionUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedDate,
  modifiedDate,
  author,
  tags = [],
  section,
  sectionUrl,
  noindex = false,
} = Astro.props;

const brand = siteConfig.name;
const normalizedTitle = title.trim();
const fullTitle = normalizedTitle.includes(brand)
  ? normalizedTitle
  : `${normalizedTitle} | ${brand}`;
const cleanTitle =
  normalizedTitle
    .replace(` - ${brand}`, '')
    .replace(` | ${brand}`, '')
    .trim() || normalizedTitle;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
const isDefaultImage = !image;
const imageUrl = image || siteConfig.ogImage;
const ogImage = imageUrl ? new URL(imageUrl, siteConfig.url).href : undefined;
const ogImageAlt = isDefaultImage ? brand : cleanTitle;

const socialUrls = Object.values(siteConfig.social).filter(Boolean);

// JSON-LD 結構化資料
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand,
  description: siteConfig.description,
  url: siteConfig.url,
  inLanguage: 'zh-Hant-TW',
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand,
  url: siteConfig.url,
  logo: new URL(siteConfig.logo, siteConfig.url).href,
  ...(socialUrls.length > 0 ? { sameAs: socialUrls } : {}),
};

const articleSchema =
  type === 'article' && publishedDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: cleanTitle,
        description,
        image: ogImage,
        inLanguage: 'zh-Hant-TW',
        ...(section ? { articleSection: section } : {}),
        datePublished: publishedDate.toISOString(),
        dateModified: (modifiedDate || publishedDate).toISOString(),
        author: {
          '@type': 'Person',
          name: author || siteConfig.author,
          url: new URL('/about/', siteConfig.url).href,
          ...(socialUrls.length > 0 ? { sameAs: socialUrls } : {}),
        },
        publisher: {
          '@type': 'Organization',
          name: brand,
          logo: {
            '@type': 'ImageObject',
            url: new URL(siteConfig.logo, siteConfig.url).href,
          },
        },
        isPartOf: {
          '@type': 'Blog',
          '@id': `${siteConfig.url}/blog/#blog`,
          name: `${brand} 文章`,
          url: `${siteConfig.url}/blog/`,
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL.href,
        },
        url: canonicalURL.href,
      }
    : null;

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const isBlogPath = pathSegments[0] === 'blog';
const isCategoryPath =
  isBlogPath && pathSegments[1] === 'category' && Boolean(pathSegments[2]);

const breadcrumbItems = [{ name: '首頁', item: new URL('/', siteConfig.url).href }];

if (isBlogPath) {
  breadcrumbItems.push({ name: '文章', item: new URL('/blog/', siteConfig.url).href });
}

if (isCategoryPath) {
  const theme = getThemeBySlug(pathSegments[2]);
  breadcrumbItems.push({
    name: theme?.name ?? cleanTitle,
    item: canonicalURL.href,
  });
} else if (isBlogPath && pathSegments.length === 2) {
  if (section && sectionUrl) {
    breadcrumbItems.push({ name: section, item: sectionUrl });
  }
  breadcrumbItems.push({ name: cleanTitle, item: canonicalURL.href });
} else if (pathSegments.length > 0 && !isBlogPath) {
  breadcrumbItems.push({ name: cleanTitle, item: canonicalURL.href });
}
const breadcrumbSchema =
  breadcrumbItems.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.item,
        })),
      }
    : null;
---

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={siteConfig.author} />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={brand} />
<meta property="og:locale" content="zh_TW" />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}

{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{type === 'article' && (modifiedDate || publishedDate) && (
  <meta
    property="article:modified_time"
    content={(modifiedDate || publishedDate).toISOString()}
  />
)}
{type === 'article' && <meta property="article:author" content={author || siteConfig.author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta property="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
{ogImage && <meta property="twitter:image" content={ogImage} />}
{ogImage && <meta property="twitter:image:alt" content={ogImageAlt} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
{breadcrumbSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
{articleSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon-32x32.png" />
