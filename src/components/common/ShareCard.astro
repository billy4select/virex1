---
import { Icon } from 'astro-icon/components';
import { buildShareChannels } from '@/lib/share';

interface Props {
  title: string;
  description?: string;
  url: string;
  eyebrow?: string;
  heading?: string;
  subtext?: string;
}

const {
  title,
  description = '',
  url,
  eyebrow = '分享這篇文章',
  heading = '覺得這篇有幫助嗎？',
  subtext = '轉給正在思考這個問題的朋友，也許剛好能幫上忙。',
} = Astro.props;

const channels = buildShareChannels(title, url);
---

<section
  aria-label={eyebrow}
  class="not-prose relative mt-12 rounded-2xl border border-border bg-gradient-to-br from-surface via-surface/75 to-background p-5 sm:p-6"
  data-pagefind-ignore
>
  {/* 柔和角落光暈（獨立裁切，避免遮擋按鈕上方的提示標籤） */}
  <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl" aria-hidden="true">
    <div class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-primary/[0.08] blur-2xl" />
  </div>

  <div class="relative flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="inline-flex items-center gap-2 text-[11px] font-bold tracking-[0.14em] text-primary">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" />
        {eyebrow}
      </p>
      <h2 class="mt-1.5 text-base font-bold tracking-tight text-text sm:text-lg">
        {heading}
      </h2>
      <p class="mt-1 text-xs leading-relaxed text-text-muted sm:text-sm">
        {subtext}
      </p>
    </div>

    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <button
        type="button"
        class="share-copy-pill inline-flex h-10 cursor-pointer items-center gap-2 rounded-full bg-text px-4 text-xs font-semibold text-background shadow-xs transition-all duration-200 hover:bg-primary hover:text-white active:scale-[0.97]"
        data-share-copy
        data-copied="false"
        data-share-title={title}
        data-share-url={url}
      >
        <Icon name="lucide:link" class="h-3.5 w-3.5" data-share-icon-default aria-hidden="true" />
        <Icon name="lucide:check" class="hidden h-3.5 w-3.5" data-share-icon-done aria-hidden="true" />
        <span data-share-label-default>複製連結</span>
        <span class="hidden" data-share-label-done>已複製</span>
      </button>

      {
        channels.map((channel) => (
          <a
            href={channel.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={channel.ariaLabel}
            data-share-platform={channel.id}
            data-share-title={title}
            data-share-url={url}
            class="group relative inline-flex h-10 w-10 items-center justify-center rounded-full border border-border bg-background text-text-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:bg-primary/5 hover:text-primary hover:shadow-sm active:translate-y-0"
          >
            <Icon name={channel.icon} class="h-4 w-4" aria-hidden="true" />
            <span
              class="pointer-events-none absolute -top-9 left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-lg bg-text px-2 py-1 text-[11px] font-medium text-background opacity-0 shadow-md transition-all duration-150 group-hover:-top-10 group-hover:opacity-100 sm:block"
              aria-hidden="true"
            >
              {channel.label}
            </span>
          </a>
        ))
      }

      <button
        type="button"
        hidden
        aria-label="使用系統分享選單"
        data-share-native
        data-share-title={title}
        data-share-description={description}
        data-share-url={url}
        class="inline-flex h-10 cursor-pointer items-center gap-1.5 rounded-full border border-border bg-background px-3.5 text-xs font-semibold text-text-muted transition-all duration-200 hover:border-primary/40 hover:bg-primary/5 hover:text-primary active:scale-[0.97]"
      >
        <Icon name="lucide:share" class="h-3.5 w-3.5" aria-hidden="true" />
        <span>更多</span>
      </button>
    </div>
  </div>
</section>

<script>
  import '@/scripts/share';
</script>
