---
/** 主題卡：讀者的處境 + 一句話承諾 + 篇數 */
interface Props {
  href: string;
  name: string;
  lead: string;
  count: number;
}

const { href, name, lead, count } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-border bg-background p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
>
  <h3 class="text-base font-bold leading-snug text-text transition-colors group-hover:text-primary md:text-lg">
    {name}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{lead}</p>
  <span class="mt-4 flex items-center justify-between text-xs">
    <span class="text-text-muted">{count} 篇</span>
    <span class="font-semibold text-primary">
      開始讀
      <span aria-hidden="true">→</span>
    </span>
  </span>
</a>
