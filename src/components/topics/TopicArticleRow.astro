---
/** 專題頁「方向」底下的單列文章：標題 + 閱讀時間 */
interface Props {
  href: string;
  title: string;
  minutes: number;
}

const { href, title, minutes } = Astro.props;
---

<li class="border-b border-border">
  <a
    href={href}
    class="group flex items-baseline gap-3 py-3 transition-colors hover:bg-surface/70"
  >
    <span
      class="min-w-0 flex-1 text-[15px] font-semibold leading-snug text-text transition-colors group-hover:text-primary"
    >
      {title}
    </span>
    <span class="whitespace-nowrap text-xs text-text-muted">{minutes} 分鐘</span>
    <span
      aria-hidden="true"
      class="text-primary transition-transform group-hover:translate-x-0.5">→</span
    >
  </a>
</li>
