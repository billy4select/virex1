---
import MarketingLayout from './MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import ArticleEvidence, { type ArticleSource } from '@/components/blog/ArticleEvidence.astro';
import ArticleFAQ from '@/components/blog/ArticleFAQ.astro';
import ArticleTopicCluster from '@/components/blog/ArticleTopicCluster.astro';
import ArticleNext from '@/components/blog/ArticleNext.astro';
import ArticleExploreGuide from '@/components/blog/ArticleExploreGuide.astro';
import ArticleAuthor from '@/components/blog/ArticleAuthor.astro';
import ArticleNewsletter from '@/components/blog/ArticleNewsletter.astro';
import ShareTrigger from '@/components/common/ShareTrigger.astro';
import ShareCard from '@/components/common/ShareCard.astro';
import { Icon } from 'astro-icon/components';
import { calculateReadingTime, formatDate } from '@/lib/utils';
import { tagUrl } from '@/lib/blog';
import { themeUrl, type BlogTheme } from '@/lib/themes';
import type { ArticleTopicCluster as TopicClusterData } from '@/lib/topic-curation';
import { siteConfig } from '@/config';
import { entityConfig } from '@/config/entity';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NextPost {
  id: string;
  title: string;
  description: string;
  category?: string;
}

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  updatedDate?: Date;
  author: string;
  image?: string;
  tags?: string[];
  content: string;
  displayTitle?: string;
  schemaType?: 'HowTo' | 'FAQ' | 'Article';
  steps?: { name: string; text: string }[];
  faq?: { q: string; a: string }[];
  headings?: Heading[];
  category?: BlogTheme;
  postId?: string;
  nextPost?: NextPost;
  topicCluster?: TopicClusterData;
  testedAt?: string;
  testNotes?: string;
  sources?: ArticleSource[];
}

const {
  title,
  description,
  publishedDate,
  updatedDate,
  author,
  image,
  tags = [],
  content,
  displayTitle: propsDisplayTitle,
  schemaType,
  steps,
  faq = [],
  headings = [],
  category,
  postId,
  nextPost,
  topicCluster,
  testedAt,
  testNotes,
  sources = [],
} = Astro.props;

const readingTime = calculateReadingTime(content);
const formattedDate = formatDate(publishedDate, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const hasUpdate =
  updatedDate !== undefined && updatedDate.getTime() > publishedDate.getTime();
const formattedUpdated = hasUpdate
  ? formatDate(updatedDate, { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const displayTitle = propsDisplayTitle || (title ? title.split(/ [|-] /)[0] : '');
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;

const tocCount =
  headings.filter((heading) => heading.depth === 2).length +
  (faq.length > 0 ? 1 : 0);
const hasToc = tocCount >= 3;

const articleGridClass = 'lg:grid lg:grid-cols-[220px_minmax(0,760px)] lg:gap-12';

const topicPillar = topicCluster
  ? {
      name: topicCluster.pillarName,
      url: new URL(topicCluster.pillarHref, siteConfig.url).href,
    }
  : undefined;

const citations = sources.map((source) => source.url);
---

<MarketingLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedDate={publishedDate}
  modifiedDate={hasUpdate ? updatedDate : undefined}
  author={author}
  tags={tags}
  schemaType={schemaType}
  steps={steps}
  faq={faq}
  section={category?.name}
  sectionUrl={category ? `${siteConfig.url}${themeUrl(category.slug)}` : undefined}
  topicPillar={topicPillar}
  citations={citations}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '文章', href: '/blog/' },
      ...(category ? [{ label: category.name, href: themeUrl(category.slug) }] : []),
      { label: displayTitle },
    ]}
  />

  {/* 文章標題區：與下方正文共用同一組兩欄網格，讓標題、說明、分享鈕與正文左右齊平 */}
  <section class="bg-background border-b border-border pt-10 pb-8 md:pt-14 md:pb-10" data-pagefind-ignore>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class={articleGridClass}>
        <header class="min-w-0 max-w-3xl lg:col-start-2 lg:max-w-none">
          <h1 class="mb-4 text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl">
            {displayTitle}
          </h1>

          {
            description && (
              <p class="mb-6 text-base leading-relaxed text-text-muted md:text-lg">
                {description}
              </p>
            )
          }

          <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-3 text-xs font-medium text-text-muted md:text-sm">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <a
                href="/about/"
                rel="author"
                class="group inline-flex items-center gap-2 text-text transition-colors hover:text-primary"
              >
                <img
                  src={siteConfig.logo}
                  alt={entityConfig.personName}
                  width="24"
                  height="24"
                  class="h-6 w-6 rounded-full border border-border object-cover"
                />
                <span class="font-semibold">{entityConfig.personName}</span>
              </a>

              <span class="text-border" aria-hidden="true">·</span>

              <span class="flex items-center gap-1.5">
                <Icon name="lucide:calendar" class="h-4 w-4" />
                {formattedDate}
              </span>

              {
                hasUpdate && (
                  <span class="flex items-center gap-1.5">
                    <Icon name="lucide:refresh-cw" class="h-4 w-4" />
                    最後更新 {formattedUpdated}
                  </span>
                )
              }

              <span class="flex items-center gap-1.5">
                <Icon name="lucide:clock" class="h-4 w-4" />
                閱讀約 {readingTime} 分鐘
              </span>
            </div>

            <ShareTrigger
              id="article-top"
              title={displayTitle}
              description={description}
              url={canonicalUrl}
            />
          </div>

          {
            tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={tagUrl(tag)}
                    class="rounded-full bg-surface px-3 py-1.5 text-[11px] font-medium text-text-muted transition-all hover:bg-[#FFF0E6] hover:text-[#E85D00] md:text-xs"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </header>
      </div>
    </div>
  </section>

  {/* 封面圖：與標題和正文共用同一條對齊軸線（自動產生的 /og/ 分享卡只給社群用，不當封面） */}
  {
    image && !image.startsWith('/og/') && (
      <section class="bg-background border-b border-border" data-pagefind-ignore>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 md:py-8">
          <div class={articleGridClass}>
            <div class="min-w-0 max-w-3xl overflow-hidden rounded-xl border border-border bg-surface lg:col-start-2 lg:max-w-none">
              <img
                src={image}
                alt={displayTitle}
                width="1200"
                height="630"
                loading="eager"
                decoding="async"
                class="aspect-[16/9] w-full object-cover"
              />
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* 文章內容 */}
  <article class="bg-background pb-12 pt-8 md:pb-16 md:pt-12" data-pagefind-body>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class={articleGridClass}>
        {
          hasToc ? (
            <TableOfContents headings={headings} faq={faq} readingTime={readingTime} />
          ) : (
            <div class="hidden lg:block" aria-hidden="true" />
          )
        }

        <div class="min-w-0 max-w-3xl lg:max-w-none">
          <span data-pagefind-meta="title" class="sr-only">{displayTitle}</span>
          <div class="prose prose-slate max-w-none prose-base md:prose-lg" data-reading-body>
            <slot name="content" />
            <slot />
          </div>

          <div data-pagefind-ignore>
            <slot name="before-faq" />
            <ArticleEvidence testedAt={testedAt} testNotes={testNotes} sources={sources} />
            <ArticleFAQ faqs={faq} />
            <ShareCard
              title={displayTitle}
              description={description}
              url={canonicalUrl}
            />
            <ArticleTopicCluster cluster={topicCluster} />
            <ArticleNext post={nextPost} />
            <ArticleExploreGuide />
            <ArticleAuthor />
            <ArticleNewsletter
              categorySlug={category?.slug}
              categoryName={category?.name}
              postId={postId}
              tags={tags}
            />
          </div>
        </div>
      </div>
    </div>
  </article>
</MarketingLayout>
