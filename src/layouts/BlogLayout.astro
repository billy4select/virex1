
---
import MarketingLayout from './MarketingLayout.astro';
import { Icon } from 'astro-icon/components';
import { calculateReadingTime, formatDate } from '@/lib/utils';
import { tagUrl } from '@/lib/blog';

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  author: string;
  image?: string;
  tags?: string[];
  content: string;
  displayTitle?: string;
  schemaType?: 'HowTo' | 'FAQ' | 'Article';
  steps?: { name: string; text: string }[];
  faq?: { q: string; a: string }[];
}

const {
  title,
  description,
  publishedDate,
  author,
  image,
  tags = [],
  content,
  displayTitle: propsDisplayTitle,
  schemaType,
  steps,
  faq
} = Astro.props;

const readingTime = calculateReadingTime(content);
const formattedDate = formatDate(publishedDate, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const displayTitle = propsDisplayTitle || (title ? title.split(/ [\|\-] /)[0] : "");
---

<MarketingLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedDate={publishedDate}
  author={author}
  tags={tags}
  schemaType={schemaType}
  steps={steps}
  faq={faq}
>

  {/* 文章標題區 */}
  <section class="bg-background border-b border-border pt-10 pb-8 md:pt-14 md:pb-10" data-pagefind-ignore>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <header>
        <h1 class="text-2xl md:text-4xl font-extrabold text-text mb-6 leading-tight tracking-tight">
          {displayTitle}
        </h1>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs md:text-sm text-text-muted font-medium">

          <span class="flex items-center gap-1.5">
            <Icon name="lucide:calendar" class="w-4 h-4" />
            {formattedDate}
          </span>

          <span class="flex items-center gap-1.5">
            <Icon name="lucide:clock" class="w-4 h-4" />
            閱讀約 {readingTime} 分鐘
          </span>

        </div>

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {tags.map((tag) => (
              <a
                href={tagUrl(tag)}
                class="px-3 py-1.5 text-[11px] md:text-xs font-medium bg-surface text-text-muted rounded-full hover:bg-[#FFF0E6] hover:text-[#E85D00] transition-all"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

      </header>
    </div>
  </section>

  {/* 文章內容 */}
  <article class="pt-8 pb-12 md:pt-12 md:pb-16 bg-background" data-pagefind-body>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <span data-pagefind-meta="title" class="sr-only">{displayTitle}</span>
      <div class="prose prose-slate prose-base md:prose-lg max-w-none">
        <slot name="content" />
        <slot />
      </div>
    </div>
  </article>

  {/* 文章延伸內容 */}
  <div data-pagefind-ignore>
    <slot name="footer" />
  </div>

</MarketingLayout>

