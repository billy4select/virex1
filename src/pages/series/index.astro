---
/**
 * 專題總覽 — 把 ai-work-team / threads / narrative-engine 收在同一個入口下
 * 讓「專題」成為主站的一級層級，而不是散在頁尾的三條連結。
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/config';

const series = [
  {
    no: '01',
    type: '專題',
    label: 'AI 工作流程',
    title: '打造 AI 工作團隊',
    audience: '想把 AI 放進日常工作，卻不知道從哪一件事開始的人',
    outcome: '一套角色分工與可重複執行的工作流程，全程使用免費工具',
    meta: '6 個主題 · 6 條流程 · 18 張任務卡',
    href: '/ai-work-team/',
  },
  {
    no: '02',
    type: '專題',
    label: '內容與自媒體',
    title: 'Threads 起步心態指南',
    audience: '想開始寫，但卡在「不夠專業、沒人看、不知道寫什麼」的人',
    outcome: '先敢寫、用對身份、寫得下去，再談節奏與變現',
    meta: '8 個主題 · 不談爆文公式',
    href: '/threads/',
  },
  {
    no: '03',
    type: '工具',
    label: 'AI 影片',
    title: 'Narrative Engine',
    audience: '需要把文字內容轉成有敘事感的影片的人',
    outcome: '用 AI 整理腳本、規劃分鏡，完成一支有結構的短影片',
    meta: '工具介紹 · 使用流程',
    href: '/narrative-engine/',
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '專題',
  description: '有順序的完整路線：從入門到可以實際執行，每個專題都有自己的章節與任務。',
  url: 'https://blog.billy4select.com/series/',
  inLanguage: 'zh-Hant-TW',
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.url,
  },
  mainEntity: {
    '@type': 'ItemList',
    name: '專題清單',
    numberOfItems: series.length,
    itemListElement: series.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: `https://blog.billy4select.com${item.href}`,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://blog.billy4select.com/' },
    { '@type': 'ListItem', position: 2, name: '專題', item: 'https://blog.billy4select.com/series/' },
  ],
};
---

<MarketingLayout
  title={`專題 - ${siteConfig.name}`}
  description="有順序的完整路線：AI 工作團隊、Threads 起步、AI 影片工具。每個專題都有自己的章節、任務與閱讀順序。"
  structuredData={[collectionSchema, breadcrumbSchema]}
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '專題' }]} />

  <section class="bg-surface pb-12 pt-10 md:pb-16 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Series</p>
        <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
          專題
        </h1>
        <p class="mt-5 text-base leading-relaxed text-text-muted md:text-lg">
          主題是長期的方向，文章是單篇的答案，專題則是有順序的完整路線。選一個你現在真的要完成的東西，從第一章開始走。
        </p>
        <p class="mt-6 text-sm font-semibold text-text-muted">
          {series.length} 個專題 · 每章都可以單獨閱讀 · 不需要照順序也能用
        </p>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20" aria-labelledby="series-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">專題清單</p>
        <h2 id="series-title" class="mt-3 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          從一個完整路線開始。
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-text-muted md:text-base">
          每個專題都有固定的章節順序與可交付的成果。不確定要讀哪一個，就先看你手上最近要交出去的東西。
        </p>
      </div>

      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {series.map((item) => (
          <a
            href={item.href}
            class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
          >
            <div class="flex items-center justify-between gap-4">
              <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-primary">{item.type} · {item.label}</span>
              <span class="text-xs font-bold text-text-muted">{item.no}</span>
            </div>
            <h3 class="mt-4 text-xl font-extrabold leading-tight tracking-tight text-text transition-colors group-hover:text-primary">
              {item.title}
            </h3>
            <dl class="mt-4 space-y-2 text-sm leading-relaxed">
              <div>
                <dt class="inline font-bold text-text">適合誰：</dt>
                <dd class="inline text-text-muted">{item.audience}</dd>
              </div>
              <div>
                <dt class="inline font-bold text-text">走完會得到：</dt>
                <dd class="inline text-text-muted">{item.outcome}</dd>
              </div>
            </dl>
            <p class="mt-5 flex-1 text-xs font-semibold text-text-muted">{item.meta}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-primary">
              進入專題 <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-border bg-background p-5 text-sm leading-relaxed text-text-muted">
        <p>
          <strong class="font-bold text-text">怎麼用：</strong>
          專題是有順序的，但不必照順序讀。每一章最後都有「下一步」與延伸文章，卡住的時候從那一章跳出去就好。想先看單篇，請到<strong class="font-bold text-text">主題</strong>與<strong class="font-bold text-text">文章</strong>。
        </p>
      </div>
    </div>
  </section>
</MarketingLayout>
