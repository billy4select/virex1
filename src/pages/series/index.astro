---
/**
 * 教學 /series/
 *
 * 獨立深度專題、互動工具與系統化章節教學的總覽頁，集中傳遞導覽列權重給靜態專題頁
 * （/ai-work-team/、/threads/、/narrative-engine/）與兩套章節式教學（/marketing/、/seo/），
 * 同時透過「延伸脈絡」將權重反哺回各 /topics/ 支柱頁。
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleAuthor from '@/components/blog/ArticleAuthor.astro';
import { siteConfig } from '@/config';
import { entityConfig } from '@/config/entity';

interface FeaturedProject {
  no: string;
  tag: string;
  title: string;
  description: string;
  meta: string;
  ctaLabel: string;
  href: string;
  image: string;
  contextLead: string;
  contextLabel: string;
  contextHref: string;
}

const featuredProjects: FeaturedProject[] = [
  {
    no: '專題 01',
    tag: '獨立專題 · AI 協作',
    title: '打造你的 AI 工作團隊',
    description:
      '給想把 AI 真正放進日常工作，卻一直卡在「每個對話視窗都要從頭交代背景」的人。這個專題把角色拆開，示範怎麼組出一套可重複使用的協作架構。',
    meta: '6 個主題 · 6 條流程 · 18 張任務卡',
    ctaLabel: '進入打造 AI 工作團隊專題頁',
    href: '/ai-work-team/',
    image: '/images/series/ai-work-team.webp',
    contextLead: '如果你想先看背後的工作流拆解邏輯，可以搭配',
    contextLabel: 'AI 工作流程與工具',
    contextHref: '/topics/ai-workflow/',
  },
  {
    no: '專題 02',
    tag: '獨立專題 · 社群實戰',
    title: 'Threads 經營實戰紀錄',
    description:
      '從 140 天 0 到 1 萬追蹤實測出發，完整拆解 Threads 帳號定位、品牌對話語氣、貼文搜尋曝光（SEO）、與 Instagram 分工策略，以及商業帳號實際落地踩坑紀錄。',
    meta: '8 個主題 · 不談爆文公式',
    ctaLabel: '進入 Threads 經營實戰專題頁',
    href: '/threads/',
    image: '/images/series/threads.webp',
    contextLead: '做社群之餘想把流量接回個人產品，可以接著逛',
    contextLabel: '自媒體與個人事業',
    contextHref: '/topics/personal-business/',
  },
  {
    no: '專題 03',
    tag: '付費工具 · 動態簡報',
    title: 'NARRATIVE ENGINE 動態簡報工作台',
    description:
      '專為知識型內容跟短影音做的動態簡報工作台。只要貼入文案或口播逐字稿，就能自動切分分鏡並套用視覺主題，不用綁定金鑰，資料也不會外洩。',
    meta: '免安裝 · 免金鑰 · 貼上逐字稿即用',
    ctaLabel: '打開 NARRATIVE ENGINE 動態簡報工作台',
    href: '/narrative-engine/',
    image: '/images/series/narrative-engine.webp',
    contextLead: '想先學會怎麼把長文章濃縮成適合口播的賣點，可以先看',
    contextLabel: '文案與賣點提煉專區',
    contextHref: '/topics/marketing/copywriting/',
  },
];

const chapterCourses = [
  {
    no: '教學 01',
    label: '8 章完整教學',
    title: '行銷從診斷開始',
    description:
      '從需求、通路、訊息三個角切入，走完四段漏斗診斷、受眾定位、廣告數字判讀與 90 天驗證計畫。',
    href: '/marketing/',
    image: '/images/series/marketing.webp',
    ctaLabel: '進入行銷教學',
    contextLabel: '行銷策略與診斷主題頁',
    contextHref: '/topics/marketing/',
  },
  {
    no: '教學 02',
    label: '7 章完整教學',
    title: 'SEO 從零開始',
    description:
      '不從工具清單開始，直接從 Google 爬取與搜尋意圖切入，走到 On-Page、內鏈架構與 30 天執行計畫。',
    href: '/seo/',
    image: '/images/series/seo.webp',
    ctaLabel: '進入 SEO 教學',
    contextLabel: '內容與 SEO 從零開始專區',
    contextHref: '/topics/marketing/seo-from-zero/',
  },
];

const allSchemaItems = [
  ...featuredProjects.map((item) => ({ name: item.title, href: item.href })),
  ...chapterCourses.map((item) => ({ name: item.title, href: item.href })),
];

const canonical = `${siteConfig.url}/series/`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: '教學：深度實作專題、章節教學與互動工具總覽',
  description:
    '整理比利陳製作的獨立深度專題、互動工具與系統化章節教學，包含打造 AI 工作團隊、Threads 經營實戰、NARRATIVE ENGINE 動態簡報工作台，以及行銷與 SEO 完整教學。',
  url: canonical,
  inLanguage: 'zh-Hant-TW',
  author: { '@id': entityConfig.ids.person },
  publisher: { '@id': entityConfig.ids.person },
  isPartOf: { '@id': entityConfig.ids.website },
  mainEntity: {
    '@type': 'ItemList',
    name: '教學與深度專題清單',
    numberOfItems: allSchemaItems.length,
    itemListElement: allSchemaItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: `${siteConfig.url}${item.href}`,
    })),
  },
};
---

<MarketingLayout
  title={`教學：深度實作專題、章節教學與互動工具總覽 - ${siteConfig.name}`}
  description="整理比利陳製作的獨立深度專題、互動工具與系統化章節教學，包含打造 AI 工作團隊、Threads 經營實戰、NARRATIVE ENGINE 動態簡報工作台，以及行銷與 SEO 完整教學。"
  structuredData={[collectionSchema]}
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '教學' }]} />

  <section class="page-band">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold tracking-[0.15em] text-primary">深度專題、章節教學與互動工具</p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
        教學
      </h1>
      <div class="mt-5 max-w-3xl space-y-4 text-base leading-8 text-text-muted md:text-lg">
        <p>一般部落格文章適合談一個觀念，或解決一個單點問題。</p>
        <p>
          但有些主題光是寫成幾千字的長文，還是很難一次講透（或是讀完之後還是不知道怎麼動手）。所以我把幾個比較完整的主題單獨拉出來，做成系統化的章節教學、獨立專題頁跟互動工具。
        </p>
        <p>
          這個頁面整理的，就是目前已經上線的完整教學與專題。每一個點進去都是完整的實作指南或工具，你可以直接挑目前最用得上的一個開始。
        </p>
      </div>
    </div>
  </section>

  {/* 主展區：三個獨立專題與互動工具 */}
  <section class="bg-background pt-12 pb-8 md:pt-16" aria-labelledby="featured-projects-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold tracking-[0.15em] text-primary">深度專題</p>
      <h2 id="featured-projects-title" class="mt-1.5 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
        獨立專題與互動工具
      </h2>

      <div class="mt-8 space-y-6">
        {
          featuredProjects.map((project) => (
            <article class="overflow-hidden rounded-2xl border border-border bg-surface transition-colors hover:border-primary/40">
              <a href={project.href} class="block border-b border-border bg-background">
                <img
                  src={project.image}
                  alt={project.title}
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full object-cover"
                />
              </a>
              <div class="p-6 md:p-8">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="font-mono text-xs font-bold tracking-[0.14em] text-primary">
                  {project.no}
                </span>
                <span class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-text-muted">
                  {project.tag}
                </span>
              </div>

              <h3 class="mt-4 text-xl font-extrabold tracking-tight text-text md:text-2xl">
                <a href={project.href} class="transition-colors hover:text-primary">
                  {project.title}
                </a>
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-text-muted md:text-base">
                {project.description}
              </p>

              <p class="mt-4 text-xs font-semibold text-text-muted">{project.meta}</p>

              <div class="mt-5 flex flex-wrap items-center gap-4">
                <a
                  href={project.href}
                  class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-primary-dark"
                >
                  {project.ctaLabel}
                  <span aria-hidden="true">→</span>
                </a>
              </div>

              <p class="mt-5 border-t border-border pt-4 text-xs leading-relaxed text-text-muted sm:text-sm">
                <strong class="font-semibold text-text">延伸脈絡：</strong>
                {project.contextLead}
                <a
                  href={project.contextHref}
                  class="mx-1 font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  {project.contextLabel}
                </a>
                一起看。
              </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 第二展區：兩套章節式完整教學 */}
  <section class="bg-background py-10 md:py-12" aria-labelledby="chapter-courses-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="border-t border-border pt-10">
        <p class="text-xs font-bold tracking-[0.15em] text-primary">系統教學</p>
        <h2 id="chapter-courses-title" class="mt-1.5 text-xl font-extrabold tracking-tight text-text md:text-2xl">
          兩套章節式完整教學
        </h2>
        <p class="mt-2 text-sm text-text-muted md:text-base">
          除了上面的獨立專題，站上也有兩套照章節排好順序的入門教學，適合系統化走完一輪。
        </p>

        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {
            chapterCourses.map((course) => (
              <article class="flex flex-col overflow-hidden rounded-2xl border border-border bg-surface/60 transition-colors hover:border-primary/40">
                <a href={course.href} class="block border-b border-border bg-background">
                  <img
                    src={course.image}
                    alt={course.title}
                    width="1200"
                    height="675"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/9] w-full object-cover"
                  />
                </a>
                <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono text-xs font-bold tracking-wider text-primary">{course.no}</span>
                  <span class="text-xs font-medium text-text-muted">{course.label}</span>
                </div>
                <h3 class="mt-3 text-lg font-extrabold tracking-tight text-text">
                  <a href={course.href} class="transition-colors hover:text-primary">
                    {course.title}
                  </a>
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{course.description}</p>
                <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4 text-xs">
                  <a
                    href={course.href}
                    class="inline-flex items-center gap-1 text-sm font-bold text-primary hover:text-primary-dark"
                  >
                    {course.ctaLabel} →
                  </a>
                  <a
                    href={course.contextHref}
                    class="text-text-muted underline decoration-border underline-offset-4 transition-colors hover:text-primary"
                  >
                    延伸：{course.contextLabel}
                  </a>
                </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* 結尾導向 /topics/、Substack 與作者實體 */}
  <section class="bg-background pb-16 pt-6 md:pb-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="border-t border-border pt-10">
        <h2 class="text-xl font-extrabold tracking-tight text-text md:text-2xl">
          找一般文章還是看教學與專題
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-text-muted md:text-base">
          如果你想按問題與領域瀏覽全站的實戰指南與筆記，可以回到
          <a
            href="/topics/"
            class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
          >
            知識主題總覽
          </a>
          。之後有新的教學、互動專題或實用工具上線，我都會先放進這個頁面，並透過
          <a
            href="https://billy4select.substack.com/"
            target="_blank"
            rel="noopener noreferrer"
            data-conversion-cta="newsletter"
            data-conversion-target="substack"
            data-conversion-category="教學"
            class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
          >
            比利陳 Substack 電子報
          </a>
          通知大家。
        </p>

        <ArticleAuthor />
      </div>
    </div>
  </section>

  <script>
    import '@/scripts/conversion';
  </script>
</MarketingLayout>
