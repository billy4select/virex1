---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/config';

const libraries = [
  {
    label: 'Prompt 範本',
    title: '可複製的 AI 指令',
    description: '13 份實戰 Prompt，涵蓋研究、企劃、編輯與品管。複製之後換成你自己的任務就能用。',
    href: '/ai-work-team/resources/prompts/',
    meta: '13 份 · 可直接複製',
    action: '打開 Prompt 範本',
  },
  {
    label: '工作流程模板',
    title: 'SOP 與職務卡',
    description: '13 份工作流程模板，把重複性工作收成標準步驟。交給 AI 或新夥伴，都能照著跑。',
    href: '/ai-work-team/resources/templates/',
    meta: '13 份 · SOP / 職務卡',
    action: '打開模板庫',
  },
  {
    label: '任務卡',
    title: '可以直接執行的任務',
    description: '18 張單一任務卡：市場掃描、會議紀錄、貼文產出。挑一張，今天就能跑完一輪。',
    href: '/ai-work-team/workflows/tasks/',
    meta: '18 張 · 研究 / 分析 / 企劃 / 編輯',
    action: '打開任務庫',
  },
  {
    label: '知識字典',
    title: 'AI 名詞與概念查詢',
    description: '15 個入門名詞的白話解釋。看到不懂的術語，先來這裡查，不用硬猜。',
    href: '/ai-work-team/resources/glossary/',
    meta: '15 個名詞 · 白話解釋',
    action: '打開知識字典',
  },
];

// Google AdSense：只有本頁載入
const ADSENSE_CLIENT = 'ca-pub-3229697751722054';
// 填上「廣告單元」的 10 位數字（AdSense → 廣告 → 按廣告單元 → 取得程式碼裡的 data-ad-slot）
// 留空則不顯示下方標示為「廣告」的版位（自動廣告仍會由 Google 自行插入）
const ADSENSE_SLOT = '5433378708'; // billy4select_resources_2026

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '免費資源',
  description: '免費的 Prompt、工作流程模板、任務卡與知識字典，讓讀者可以直接使用。',
  url: 'https://www.billy4select.com/resources/',
  inLanguage: 'zh-Hant-TW',
  dateModified: '2026-11-26',
  mainEntity: {
    '@type': 'ItemList',
    name: '免費資源分類',
    numberOfItems: libraries.length,
    itemListElement: libraries.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      description: item.description,
      url: `https://www.billy4select.com${item.href}`,
    })),
  },
};
---

<MarketingLayout
  title={`免費資源 - ${siteConfig.name}`}
  description="免費的 Prompt、工作流程模板、任務卡與知識字典。進來之後，直接拿走一個有用的東西。"
  structuredData={[collectionSchema]}
>
  <Fragment slot="head">
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    />
  </Fragment>

  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '免費資源' }]} />

  <section class="page-band">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
          免費資源
        </h1>
        <p class="mt-5 text-base leading-relaxed text-text-muted md:text-lg">
          提供免費的 Prompt、工作流程模板、任務卡與實用工具，讓你可以直接使用。這一頁不放文章、不介紹主題——想讀內容，請到「主題」與「文章」；想在這裡的，是拿走一個能用的東西。
        </p>
        <p class="mt-6 text-sm font-semibold text-text-muted">
          全部免費 · 可直接複製或執行 · 不用留 email
        </p>
      </div>
    </div>
  </section>

  {
    ADSENSE_SLOT && (
      <section class="bg-surface py-8" aria-label="廣告版位">
        <style is:inline>
          .adsbygoogle[data-ad-status="unfilled"] { display: none !important; }
          #ad-slot:has(.adsbygoogle[data-ad-status="unfilled"]) { display: none !important; }
        </style>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div id="ad-slot" class="rounded-2xl border border-border bg-background p-4">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-text-muted">廣告</p>
            <p class="mt-1 text-xs text-text-muted">以下內容由 Google AdSense 提供，非本站編輯內容。</p>
            <ins
              class="adsbygoogle mt-4 block"
              style="display:block"
              data-ad-client={ADSENSE_CLIENT}
              data-ad-slot={ADSENSE_SLOT}
              data-ad-format="auto"
              data-full-width-responsive="true"
            />
            <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-background py-16 md:py-20" aria-labelledby="library-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">免費資源分類</p>
        <h2 id="library-title" class="mt-3 text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          四種可以直接拿走的東西。
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-text-muted md:text-base">
          不用照順序看。先想你現在要完成的任務，再挑一個分類進去。
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {libraries.map((item, index) => (
          <a
            href={item.href}
            class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
          >
            <div class="flex items-center justify-between gap-4">
              <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-primary">{item.label}</span>
              <span class="text-xs font-bold text-text-muted">0{index + 1}</span>
            </div>
            <h3 class="mt-4 text-xl font-extrabold leading-tight tracking-tight text-text transition-colors group-hover:text-primary">
              {item.title}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{item.description}</p>
            <p class="mt-5 text-xs font-semibold text-text-muted">{item.meta}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-primary">
              {item.action} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-border bg-background p-5 text-sm leading-relaxed text-text-muted">
        <p>
          <strong class="font-bold text-text">授權與更新：</strong>
          這一頁的所有資源免費使用，歡迎用在自己的工作與團隊內，引用請註明來源。請不要整份轉售、包裝成自己的付費產品，或大量複製成內容農場。最後更新：<span class="whitespace-nowrap">2026-11-26</span>。
        </p>
      </div>
    </div>
  </section>
</MarketingLayout>
