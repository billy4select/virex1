---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ShareTrigger from '@/components/common/ShareTrigger.astro';
import ShareCard from '@/components/common/ShareCard.astro';
import { siteConfig } from '@/config';
import { seoChapters, seoChapterUrl, type SeoChapter } from '@/lib/seo-series';

export function getStaticPaths() {
  return seoChapters.map((chapter, index) => ({
    params: { chapter: chapter.slug },
    props: {
      chapter,
      prev: index > 0 ? seoChapters[index - 1] : undefined,
      next: index < seoChapters.length - 1 ? seoChapters[index + 1] : undefined,
    },
  }));
}

interface Props {
  chapter: SeoChapter;
  prev?: SeoChapter;
  next?: SeoChapter;
}

const { chapter, prev, next } = Astro.props;
const url = `${siteConfig.url}${seoChapterUrl(chapter.slug)}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: chapter.title,
  description: chapter.description,
  inLanguage: 'zh-Hant-TW',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@type': 'CollectionPage', name: 'SEO 教學', url: `${siteConfig.url}/seo/` },
  author: { '@type': 'Person', name: '比利陳 Billy Chen' },
  publisher: { '@type': 'Organization', name: siteConfig.name },
};
---

<MarketingLayout title={`${chapter.title} - ${siteConfig.name}`} description={chapter.description}>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '教學', href: '/series/' },
      { label: 'SEO 教學', href: '/seo/' },
      { label: `${chapter.no} ${chapter.short}`, href: seoChapterUrl(chapter.slug) },
    ]}
  />

  <section class="page-band">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm font-semibold tracking-[0.15em] text-primary">第 {chapter.no} 章 · {chapter.short}</p>
        <ShareTrigger
          id={`seo-${chapter.slug}`}
          title={chapter.title}
          description={chapter.description}
          url={url}
        />
      </div>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl">
        {chapter.title}
      </h1>
      <p class="mt-4 text-base leading-relaxed text-text-muted md:text-lg">{chapter.lead}</p>
    </div>
  </section>

  <article class="bg-background pb-16 pt-10 md:pb-24 md:pt-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl border border-border bg-surface p-5">
        <p class="text-sm font-semibold text-text">讀完這章，你會知道</p>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">{chapter.outcome}</p>
      </div>

      <div class="mt-10 space-y-10">
        {
          chapter.sections.map((section) => (
            <section>
              <h2 class="text-xl font-extrabold tracking-tight text-text md:text-2xl">{section.h2}</h2>
              {section.paras.map((para) => (
                <p class="mt-4 text-base leading-8 text-text-muted">{para}</p>
              ))}
              {section.list && (
                <ul class="mt-5 space-y-2 rounded-xl border border-border bg-surface p-5 text-sm leading-relaxed text-text">
                  {section.list.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-primary">·</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <ShareCard
        title={chapter.title}
        description={chapter.description}
        url={url}
        eyebrow="分享這一章"
        heading="覺得這章整理有幫助嗎？"
        subtext="轉給正在研究 SEO 的朋友，一起把自然流量做起來。"
      />

      <div class="mt-8 rounded-2xl border border-border bg-surface p-6">
        <h2 class="text-base font-extrabold text-text">深入閱讀</h2>
        <ul class="mt-4 space-y-3">
          {
            chapter.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm font-semibold text-primary hover:underline">
                  {link.label} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="mt-10 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:justify-between" aria-label="章節導覽">
        {
          prev ? (
            <a href={seoChapterUrl(prev.slug)} class="text-sm text-text-muted hover:text-primary">
              ← 第 {prev.no} 章：{prev.short}
            </a>
          ) : (
            <a href="/seo/" class="text-sm text-text-muted hover:text-primary">
              ← 回教學目錄
            </a>
          )
        }
        {
          next ? (
            <a href={seoChapterUrl(next.slug)} class="text-sm font-semibold text-primary hover:underline sm:text-right">
              第 {next.no} 章：{next.short} →
            </a>
          ) : (
            <a href="/blog/?theme=seo-content" class="text-sm font-semibold text-primary hover:underline sm:text-right">
              讀更多 SEO 文章 →
            </a>
          )
        }
      </nav>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</MarketingLayout>
