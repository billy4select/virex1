---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import SeriesHome from '@/components/series/SeriesHome.astro';
import '@/styles/series.css';
import { siteConfig } from '@/config';
import { seoChapters } from '@/lib/seo-series';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'SEO 教學',
  description: '從搜尋機制、意圖、關鍵字、文章結構、內部連結、技術面到 30 天計畫，七章走完一輪可執行的 SEO。',
  url: `${siteConfig.url}/seo/`,
  inLanguage: 'zh-Hant-TW',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: seoChapters.length,
    itemListElement: seoChapters.map((chapter, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: chapter.title,
      url: `${siteConfig.url}/seo/${chapter.slug}/`,
    })),
  },
};
---

<MarketingLayout
  title={`SEO 教學 - ${siteConfig.name}`}
  description="七章從零開始的 SEO 教學：搜尋機制、搜尋意圖、關鍵字、文章結構、內部連結、技術檢查與 30 天計畫。照順序讀完，能自己跑一輪。"
>
  <SeriesHome
    variant="sp-seo"
    crumbs={[
      { label: '首頁', href: '/' },
      { label: '教學', href: '/series/' },
      { label: 'SEO 教學', href: '/seo/' },
    ]}
    eyebrow="SEO 教學 · 從被找到開始"
    titleLead="先讓 Google 讀懂你，"
    titleAccent="再談排名"
    lead="不從工具開始，從「一個頁面怎麼被處理」開始。四道關卡、七個章節：機制、意圖、關鍵字、結構、內鏈、技術，最後是一份 30 天可執行的計畫。"
    stats={['7 章 · 約 5,500 字', '每章 5–8 分鐘', '12 篇延伸文章']}
    ctaHref="/seo/how-seo-works/"
    ctaLabel="從第 01 章開始"
    secondaryHref="/blog/?theme=seo-content"
    secondaryLabel="先看 SEO 文章"
    coreLabel="被找到"
    artNodes={['爬取', '索引', '排序', '呈現']}
    artNote="搜尋結果的第一屏，是這四步的結果"
    chapters={seoChapters.map((chapter) => ({
      slug: chapter.slug,
      no: chapter.no,
      title: chapter.title,
      lead: chapter.lead,
      outcome: chapter.outcome,
    }))}
    quick={[
      { label: '排名不是第一步', value: '先確認收錄，再談排序與點擊。' },
      { label: '一頁一種意圖', value: '資訊、比較、交易不要寫在同一頁。' },
      { label: '內鏈你能控制', value: '3 出 1 進，權重才不會被平均掉。' },
      { label: '時程 3–6 個月', value: '第一個月不會有主要關鍵字排名。' },
    ]}
    chapterBase="/seo/"
    pathSteps={[
      { title: '機制', desc: '爬取、索引、排序、呈現，先知道每段在修什麼。' },
      { title: '意圖', desc: '搜這個詞的人現在想幹什麼，決定你寫哪種內容。' },
      { title: '結構', desc: '標題、H2、內鏈、速度，把內容整理成機器讀得懂。' },
      { title: '計畫', desc: '30 天四週任務，用曝光與索引率判斷方向。' },
    ]}
    audience={[
      {
        title: '這套適合你，如果',
        items: [
          '有自己的網站或部落格，但文章沒有搜尋流量。',
          '會用關鍵字工具，卻不知道為什麼寫了沒排名。',
          '想把 SEO 當長期資產，而不是一次性的投放。',
        ],
      },
      {
        title: '這套不適合，如果',
        items: [
          '想找「三個月衝上首頁」的捷徑。',
          '期待買工具就有排名，不打算改內容結構。',
          '網站連收錄都還沒解決，卻想先優化 CTR。',
        ],
      },
    ]}
    authorNote="十多年行銷與產品經驗，寫過三本電子書；這個站就是這套流程的實驗場。"
  />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</MarketingLayout>
