---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PostCard from '@ui/PostCard.astro';
import BlogTagNav from '@/components/blog/BlogTagNav.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { getTagStats, sortByDate } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = getTagStats(posts);

  return tags.map(({ name }) => ({
    params: { tag: name },
    props: {
      posts: sortByDate(
        posts.filter((p) => (p.data.tags || []).map((t) => String(t).trim()).includes(name))
      ),
      tags,
    },
  }));
}

const { tag } = Astro.params;
const { posts, tags } = Astro.props;
---

<MarketingLayout
  title={`${tag} - ${siteConfig.name}`}
  description={`瀏覽所有關於 ${tag} 的文章。`}
  noindex={true}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '文章', href: '/blog/' },
      { label: `#${tag}` },
    ]}
  />

  <section class="bg-background pt-10 pb-8 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-text">{tag}</h1>
        <span class="text-xs text-text-muted">{posts.length} 篇文章</span>
      </div>

      <div class="border-b border-border pb-7">
        <BlogTagNav tags={tags} current={tag} />
      </div>
    </div>
  </section>

  <section class="bg-background pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-12">
        {posts.map((post) => <PostCard post={post} />)}
      </div>

      <div class="mt-16 pt-8 border-t border-border">
        <a href="/blog/" class="text-sm font-semibold text-[#FF6A00] hover:opacity-70 transition-opacity">
          ← 查看所有文章
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>
