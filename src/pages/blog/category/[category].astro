---
import { blogThemes } from '@/lib/themes';

export function getStaticPaths() {
  const legacyTargets: Record<string, string> = {
    'ai-tech': 'ai-workflow',
    'personal-brand': 'career-business',
    'investment-market': '',
    // 2026-11 第一版主題 slug
    'work-efficiency': 'ai-workflow',
    'learning-capability': 'career-business',
    'personal-development': 'career-business',
    // 更早的主題 slug
    'ability-learning': 'ai-workflow',
    'business-thinking': 'business-marketing',
    'personal-growth': 'career-business',
    'marketing-brand': 'business-marketing',
  };

  const current = blogThemes.map((theme) => ({
    params: { category: theme.slug },
    props: { target: theme.slug },
  }));

  const legacy = Object.entries(legacyTargets)
    .filter(([category]) => !blogThemes.some((t) => t.slug === category))
    .map(([category, target]) => ({
    params: { category },
    props: { target },
  }));

  return [...current, ...legacy];
}

const { target } = Astro.props;

return Astro.redirect(target ? `/topics/${target}/` : '/topics/', 301);
---
