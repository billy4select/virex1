---
import { blogThemes } from '@/lib/themes';

export function getStaticPaths() {
  const legacyTargets: Record<string, string> = {
    'ai-tech': 'work-efficiency',
    'business-marketing': 'business-marketing',
    'personal-brand': 'personal-development',
    'investment-market': '',
    // 舊主題 slug
    'ability-learning': 'work-efficiency',
    'business-thinking': 'business-marketing',
    'personal-growth': 'personal-development',
    'marketing-brand': 'business-marketing',
  };

  const current = blogThemes.map((theme) => ({
    params: { category: theme.slug },
    props: { target: theme.slug },
  }));

  const legacy = Object.entries(legacyTargets).map(([category, target]) => ({
    params: { category },
    props: { target },
  }));

  return [...current, ...legacy];
}

const { target } = Astro.props;

return Astro.redirect(target ? `/topics/${target}/` : '/topics/', 301);
---
