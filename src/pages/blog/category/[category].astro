---
import { blogThemes } from '@/lib/themes';

export function getStaticPaths() {
  // 目前的文章分類（沒有自己的頁面）→ /blog/ 的篩選；舊 slug → 對應的新領域頁
  const legacyTargets: Record<string, string> = {
    'ai-tech': '/topics/ai-workflow/',
    'personal-brand': '/topics/personal-business/',
    'investment-market': '/topics/',
    // 2026-11 第一版主題 slug
    'work-efficiency': '/topics/ai-workflow/',
    'learning-capability': '/topics/learning/',
    'personal-development': '/topics/career/',
    // 更早的主題 slug
    'ability-learning': '/topics/learning/',
    'business-thinking': '/topics/business-model/',
    'personal-growth': '/topics/career/',
    'marketing-brand': '/topics/marketing/',
    // 2026-11 舊分類（已拆成商業模式／行銷策略／廣告／SEO）
    'business-marketing': '/blog/?theme=marketing-strategy',
  };

  const current = blogThemes.map((theme) => ({
    params: { category: theme.slug },
    props: { target: `/blog/?theme=${theme.slug}` },
  }));

  const legacy = Object.entries(legacyTargets)
    .filter(([category]) => !blogThemes.some((t) => t.slug === category))
    .map(([category, target]) => ({
      params: { category },
      props: { target },
    }));

  return [...current, ...legacy];
}

const { target } = Astro.props;

return Astro.redirect(target, 301);
---
