---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Pagination from '@ui/Pagination.astro';
import PostCard from '@ui/PostCard.astro';
import BlogSearch from '@/components/blog/BlogSearch.astro';
import BlogTagNav from '@/components/blog/BlogTagNav.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { POSTS_PER_PAGE, getFeatured, getTagStats, postUrl, sortByDate } from '@/lib/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);
const tags = getTagStats(allPosts);
const boostedPosts = getFeatured(sortedPosts);

const remainingPosts = sortedPosts.filter((p) => !boostedPosts.some((b) => b.id === p.id));
const totalPages = Math.ceil(remainingPosts.length / POSTS_PER_PAGE);
---

<MarketingLayout title="文章" description={siteConfig.description}>
  <section class="bg-background pt-10 pb-8 md:pt-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-text">文章</h1>
        <span class="text-xs text-text-muted">{allPosts.length} 篇文章</span>
      </div>

      <BlogSearch />

      <div class="border-b border-border pb-7">
        <BlogTagNav tags={tags} current="all" />
      </div>
    </div>
  </section>

  <section class="bg-background pb-20">
    <div class="max-w-4xl mx-auto px-4">
      {
        boostedPosts.length > 0 && (
          <div class="mb-16">
            <div class="mb-7">
              <h2 class="text-xs font-bold text-text-muted uppercase tracking-[0.2em]">熱門文章</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {boostedPosts.map((post) => (
                <a
                  href={postUrl(post.id)}
                  class="group block p-6 rounded-2xl bg-surface border border-border hover:border-[#FF6A00]/40 hover:shadow-lg transition-all duration-300"
                >
                  <div class="flex flex-col h-full gap-3">
                    <div class="text-[10px] font-bold text-[#FF6A00] tracking-wider">
                      {post.data.boost ? '必讀' : '精選'}
                    </div>
                    <h3 class="text-lg font-bold text-text group-hover:text-[#FF6A00] transition-colors leading-snug">
                      {post.data.title}
                    </h3>
                    <p class="text-text-muted text-sm line-clamp-2 mt-auto leading-relaxed">
                      {post.data.description}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="mb-8 flex items-center justify-between border-b border-border pb-4">
        <h2 class="text-xs font-bold text-text-muted uppercase tracking-[0.2em]">最新文章</h2>
        <span class="text-xs text-text-muted">第 1 頁</span>
      </div>

      <div class="space-y-12">
        {remainingPosts.slice(0, POSTS_PER_PAGE).map((post) => <PostCard post={post} />)}
      </div>

      <div class="mt-16">
        <Pagination currentPage={1} totalPages={totalPages} basePath="/blog/" />
      </div>
    </div>
  </section>
</MarketingLayout>
