---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BlogTopicNav from '@/components/blog/BlogTopicNav.astro';
import ThemePostRow from '@/components/blog/ThemePostRow.astro';
import BlogSearch from '@/components/blog/BlogSearch.astro';
import { POSTS_PER_PAGE, sortByDate, getPublishedPosts } from '@/lib/blog';
import { getThemeCounts } from '@/lib/themes';

const allPosts = await getPublishedPosts();
const sortedPosts = sortByDate(allPosts);
const themeCounts = getThemeCounts(allPosts);
---

<MarketingLayout title="所有文章" description="比利陳的全部文章。依主題篩選，或直接搜尋想了解的問題。">
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '文章' }]} />

  <section class="page-band">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl" data-blog-heading>
        所有文章
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-text-muted md:text-lg" data-blog-description>
        探索所有文章，依主題篩選，或直接搜尋想了解的問題。
      </p>

      <BlogSearch
        id="blog-index-search"
        wrapperClass="mt-8 mb-0 max-w-2xl"
        placeholder="搜尋文章標題或內容……"
        pageMode
      />
    </div>
  </section>

  <section class="bg-background pb-20 pt-6" data-blog-browse>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <BlogTopicNav items={themeCounts} variant="pills" />

      <section
        id="blog-list"
        class="mt-8 border-t border-border"
        data-blog-list
        data-page-size={POSTS_PER_PAGE}
        aria-label="所有文章"
      >
        {sortedPosts.map((post) => <ThemePostRow post={post} />)}
      </section>

      <nav
        class="mt-10 flex flex-wrap items-center justify-center gap-2"
        data-blog-pagination
        aria-label="文章分頁"
      ></nav>
    </div>
  </section>

  <script is:inline src="/js/blog-index.js" defer></script>
</MarketingLayout>
