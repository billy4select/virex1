---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Pagination from '@ui/Pagination.astro';
import PostCard from '@ui/PostCard.astro';
import BlogSearchToggle from '@/components/blog/BlogSearchToggle.astro';
import BlogTopicNav from '@/components/blog/BlogTopicNav.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import {
  POSTS_PER_PAGE,
  getFeaturedPost,
  postUrl,
  sortByDate,
} from '@/lib/blog';
import { getThemeCounts } from '@/lib/themes';
import { calculateReadingTime, formatCompactDate } from '@/lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);
const themeCounts = getThemeCounts(allPosts);
const featuredPost = getFeaturedPost(sortedPosts);

const remainingPosts = featuredPost
  ? sortedPosts.filter((post) => post.id !== featuredPost.id)
  : sortedPosts;
const totalPages = Math.ceil(remainingPosts.length / POSTS_PER_PAGE);

const featuredDate = featuredPost
  ? formatCompactDate(featuredPost.data.publishedDate)
  : '';
const featuredReadingTime = featuredPost
  ? calculateReadingTime(featuredPost.body || '')
  : 0;
---

<MarketingLayout title="文章" description={siteConfig.description}>
  <section class="bg-background pt-12 md:pt-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <h1 class="text-4xl font-extrabold tracking-[-0.03em] text-text md:text-6xl">
            文章
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted md:text-lg">
            不同領域，不同問題。持續研究值得理解的新事物。
          </p>
        </div>
        <span class="pb-1 text-xs font-medium text-text-muted">
          {allPosts.length} 篇文章
        </span>
      </div>

      <div class="mt-9">
        <BlogTopicNav items={themeCounts} variant="tabs" />
      </div>
    </div>
  </section>

  <section class="bg-background pb-4 pt-8 md:pt-10">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      {
        featuredPost && (
          <a
            href={postUrl(featuredPost.id)}
            class="group block rounded-2xl border border-border bg-surface/70 p-6 transition-colors hover:border-primary/40 md:p-8"
          >
            <div class="flex flex-wrap items-center gap-2.5 text-[11px] font-medium text-text-muted">
              <span class="font-bold uppercase tracking-[0.2em] text-primary">精選文章</span>
              <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
              <span>{featuredPost.data.category}</span>
            </div>

            <h2 class="mt-4 max-w-4xl text-[1.45rem] font-extrabold leading-[1.3] tracking-tight text-text transition-colors group-hover:text-primary md:text-[2.4rem] md:leading-[1.25]">
              {featuredPost.data.title}
            </h2>

            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-text-muted md:text-base">
              {featuredPost.data.description}
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-x-2.5 gap-y-2 text-xs font-medium text-text-muted">
              <time datetime={featuredPost.data.publishedDate.toISOString()}>
                {featuredDate}
              </time>
              <span class="h-1 w-1 rounded-full bg-border" aria-hidden="true"></span>
              <span>{featuredReadingTime} 分鐘</span>
              <span class="ml-auto inline-flex items-center gap-2 font-semibold text-primary">
                閱讀文章
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        )
      }
    </div>
  </section>

  <section class="bg-background pb-20 pt-8 md:pt-10">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4 border-b border-border pb-4">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-text md:text-2xl">最新文章</h2>
          <p class="mt-1 text-xs text-text-muted">依發布時間排序</p>
        </div>
        <div class="flex items-center gap-4 pb-1">
          <span class="hidden text-xs text-text-muted sm:inline">{remainingPosts.length} 篇</span>
          <BlogSearchToggle />
        </div>
      </div>

      <div>
        {remainingPosts.slice(0, POSTS_PER_PAGE).map((post) => <PostCard post={post} />)}
      </div>

      <div class="mt-12">
        <Pagination currentPage={1} totalPages={totalPages} basePath="/blog/" />
      </div>
    </div>
  </section>
</MarketingLayout>
