
---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Pagination from '@ui/Pagination.astro';
import PostCard from '@ui/PostCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const sortedPosts = allPosts.sort(
    (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
  );

  const boostedPosts = sortedPosts
    .filter(post => post.data.boost === true || post.data.featured === true)
    .slice(0, 2);

  const remainingPosts = sortedPosts.filter(
    post => !boostedPosts.some(bp => bp.id === post.id)
  );

  return paginate(remainingPosts, {
    pageSize: 6,
    props: { boostedPosts, allPosts }
  });
}

const { page, boostedPosts, allPosts } = Astro.props;
const currentPage = page.currentPage;

const allTags = [
  ...new Set(
    allPosts.flatMap((post) => post.data.tags || [])
      .map(tag => String(tag).trim())
      .filter(tag => tag.length > 0)
  )
].sort((a, b) => a.localeCompare(b, 'zh-Hant'));

const featuredPostsCount = allPosts.filter(
  post => post.data.featured || post.data.boost
).length;
---

<MarketingLayout
  title={`文章 - 第 ${currentPage} 頁`}
  description={siteConfig.description}
>

  {/* 頁面標題與分類 */}
  <section class="bg-white pt-10 pb-8 md:pt-14">
    <div class="max-w-4xl mx-auto px-4">

      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
          文章
        </h1>

        <span class="text-xs text-gray-400">
          第 {currentPage} 頁
        </span>
      </div>

      <div class="border-b border-gray-100 pb-7">
        <div class="flex flex-wrap items-center gap-2">

          <a
            href="/blog"
            class="px-4 py-2 rounded-full text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all"
          >
            全部文章
          </a>

          {allTags.map((tag) => (
            <a
              href={`/blog/tag/${encodeURIComponent(tag)}`}
              class="px-4 py-2 rounded-full text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 border border-transparent transition-all"
            >
              {tag}
            </a>
          ))}

        </div>
      </div>

    </div>
  </section>

  {/* 文章列表 */}
  <section class="bg-white pb-20">
    <div class="max-w-4xl mx-auto px-4">

      <div class="mb-8 flex items-center justify-between border-b border-gray-100 pb-4">
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-[0.2em]">
          最新文章
        </h2>

        <span class="text-xs text-gray-400">
          第 {currentPage} 頁
        </span>
      </div>

      <div class="space-y-12">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>

      <div class="mt-16">
        <Pagination
          currentPage={currentPage}
          totalPages={page.lastPage}
          basePath="/blog"
        />
      </div>

    </div>
  </section>

</MarketingLayout>
