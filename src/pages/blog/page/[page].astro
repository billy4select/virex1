---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Pagination from '@ui/Pagination.astro';
import PostCard from '@ui/PostCard.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { POSTS_PER_PAGE, getFeaturedPost, sortByDate } from '@/lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sortedPosts = sortByDate(allPosts);
  const featuredPost = getFeaturedPost(sortedPosts);
  const remainingPosts = featuredPost
    ? sortedPosts.filter((post) => post.id !== featuredPost.id)
    : sortedPosts;

  // 第 1 頁就是 /blog/，這裡只產生第 2 頁以後，避免 /blog/page/1/ 變成重複頁面
  return paginate(remainingPosts, {
    pageSize: POSTS_PER_PAGE,
    props: { totalCount: allPosts.length },
  }).filter((p) => p.props.page.currentPage > 1);
}) satisfies GetStaticPaths;

const { page, totalCount } = Astro.props;
const currentPage = page.currentPage;
---

<MarketingLayout
  title={`文章 - 第 ${currentPage} 頁`}
  description={`比利陳的文章第 ${currentPage} 頁。AI、商業、行銷、投資與個人事業的研究與觀察。`}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '文章', href: '/blog/' },
      { label: `第 ${currentPage} 頁` },
    ]}
  />

  <section class="bg-background pt-12 pb-8 md:pt-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <h1 class="text-4xl font-extrabold tracking-[-0.03em] text-text md:text-5xl">
            文章
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-text-muted md:text-base">
            第 {currentPage} 頁，繼續看之前的文章。
          </p>
        </div>
        <span class="pb-1 text-xs font-medium text-text-muted">{totalCount} 篇文章</span>
      </div>
    </div>
  </section>

  <section class="bg-background pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between border-b border-border pb-4">
        <h2 class="text-xl font-bold tracking-tight text-text md:text-2xl">最新文章</h2>
        <span class="text-xs text-text-muted">第 {currentPage} 頁</span>
      </div>

      <div>
        {page.data.map((post) => <PostCard post={post} />)}
      </div>

      <div class="mt-12">
        <Pagination currentPage={currentPage} totalPages={page.lastPage} basePath="/blog/" />
      </div>
    </div>
  </section>
</MarketingLayout>
