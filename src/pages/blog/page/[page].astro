---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Pagination from '@ui/Pagination.astro';
import BlogTopicNav from '@/components/blog/BlogTopicNav.astro';
import ThemePostRow from '@/components/blog/ThemePostRow.astro';
import BlogSearch from '@/components/blog/BlogSearch.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { POSTS_PER_PAGE, sortByDate } from '@/lib/blog';
import { getThemeCounts } from '@/lib/themes';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sortedPosts = sortByDate(allPosts);

  // 第 1 頁就是 /blog/，這裡只產生第 2 頁以後，避免 /blog/page/1/ 變成重複頁面
  return paginate(sortedPosts, {
    pageSize: POSTS_PER_PAGE,
    props: { totalCount: allPosts.length },
  }).filter((p) => p.props.page.currentPage > 1);
}) satisfies GetStaticPaths;

const { page, totalCount } = Astro.props;
const currentPage = page.currentPage;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const themeCounts = getThemeCounts(allPosts);
---

<MarketingLayout
  title={`所有文章 - 第 ${currentPage} 頁`}
  description={`比利陳的全部文章，第 ${currentPage} 頁。`}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '文章', href: '/blog/' },
      { label: `第 ${currentPage} 頁` },
    ]}
  />

  <section class="border-b border-border bg-background pb-8 pt-10 md:pb-10 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
        <h1 class="text-3xl font-extrabold tracking-tight text-text md:text-5xl">
          所有文章
        </h1>
        <span class="mb-1 rounded-full bg-surface px-3 py-1 text-xs font-medium text-text-muted">
          {totalCount} 篇文章
        </span>
      </div>

      <BlogSearch
        id="blog-page-search"
        wrapperClass="mt-8 mb-0 max-w-2xl"
        placeholder="搜尋文章標題或內容……"
      />
    </div>
  </section>

  <section class="bg-background pb-20 pt-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <BlogTopicNav items={themeCounts} variant="pills" />

      <section class="mt-8 border-t border-border" aria-label="所有文章">
        {page.data.map((post) => <ThemePostRow post={post} />)}

        <div class="mt-10">
          <Pagination currentPage={currentPage} totalPages={page.lastPage} basePath="/blog/" />
        </div>
      </section>
    </div>
  </section>
</MarketingLayout>
