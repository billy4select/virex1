---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';

interface Props {
  title: string;
  displayTitle?: string;
  description?: string;
  publishedDate?: Date;
  author?: string;
  image?: string;
  tags?: string[];
  content?: string;
  schemaType?: string;
  steps?: any[];
  faq?: any[];
}

const {
  title,
  displayTitle,
  description,
  publishedDate,
  author,
  image,
  tags: currentPostTags = [],
  content = '',
  schemaType,
  steps,
  faq,
} = Astro.props;

// 取得所有文章並計算熱門標籤
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const tagCounts = allPosts
  .flatMap((post) => post.data.tags || [])
  .filter((tag) => tag && tag.trim() !== "")
  .reduce((acc, tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
  }, {} as Record<string, number>);

const tags = Object.keys(tagCounts)
  .sort((a, b) => tagCounts[b] - tagCounts[a])
  .slice(0, 12); // 只取前 12 個熱門 Tag
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description || siteConfig.description} />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <Header />

    <!-- 橘色 Hero 區塊與熱門標籤列 -->
    <section class="bg-[#FF6A00] border-b border-black/10 pt-12 pb-16 md:pt-16 md:pb-24">
      <div class="max-w-4xl mx-auto px-4 text-white">
        <div class="flex flex-col gap-10">
          <div class="space-y-4">
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">最新實戰心得</h1>
            <p class="text-white/80 text-sm md:text-base max-w-2xl leading-relaxed">
              分享行銷心得、AI 工具應用與自媒體經營筆記。
            </p>
          </div>

          <div class="flex flex-col gap-3">
            <span class="text-[10px] font-bold text-white/40 uppercase tracking-[0.2em]">按主題瀏覽</span>
            <div class="flex flex-wrap gap-2">
              <a href="/blog" class="px-4 py-1.5 text-xs font-bold bg-white text-[#FF6A00] rounded-full">全部</a>
              {tags.map((tag) => (
                <a href={`/blog/tag/${tag}`} class="px-4 py-1.5 text-xs font-bold bg-white/10 border border-white/10 text-white rounded-full hover:bg-white/20 transition-all">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 文章主要內容區塊 -->
    <main class="max-w-4xl mx-auto px-4 py-12">
      <slot name="content" />
      <slot />
    </main>

    <Footer />
  </body>
</html>
