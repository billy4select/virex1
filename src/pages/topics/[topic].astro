---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TopicCard from '@/components/topics/TopicCard.astro';
import NotebookLMHubGuide from '@/components/topics/NotebookLMHubGuide.astro';
import AIWorkflowHubGuide from '@/components/topics/AIWorkflowHubGuide.astro';
import BusinessModelHubGuide from '@/components/topics/BusinessModelHubGuide.astro';
import MarketingHubGuide from '@/components/topics/MarketingHubGuide.astro';
import CareerHubGuide from '@/components/topics/CareerHubGuide.astro';
import LearningHubGuide from '@/components/topics/LearningHubGuide.astro';
import BookGuidesHubGuide from '@/components/topics/BookGuidesHubGuide.astro';
import PersonalBusinessHubGuide from '@/components/topics/PersonalBusinessHubGuide.astro';
import { siteConfig } from '@/config';
import { entityConfig } from '@/config/entity';
import { getPublishedPosts } from '@/lib/blog';
import { topicAreas, getArea, getTopicsByArea, topicUrl } from '@/lib/topic-curation';

interface Props {
  slug: string;
}

export async function getStaticPaths() {
  return topicAreas.map((area) => ({
    params: { topic: area.slug },
    props: { slug: area.slug },
  }));
}

const { slug } = Astro.props;
const area = getArea(slug);
if (!area) throw new Error(`找不到領域：${slug}`);

const publishedIds = new Set((await getPublishedPosts()).map((post) => post.id));
const countOf = (ids: string[]) => ids.filter((id) => publishedIds.has(id)).length;
const areaTopics = getTopicsByArea(slug).filter((topic) => countOf(topic.articleIds) > 0);
const canonical = `${siteConfig.url}/topics/${slug}/`;

const hubMeta: Record<string, { title: string; description: string; heading: string }> = {
  notebooklm: {
    title: 'NotebookLM 實戰指南：從 PDF 處理到工作研究',
    description:
      '整理比利陳實測 NotebookLM 的 9 篇完整筆記，涵蓋掃描 PDF 轉檔、亂碼排錯、五種提問方法，以及與 Claude、Notion AI 的工具比較。',
    heading: 'NotebookLM 實戰指南',
  },
  'ai-workflow': {
    title: 'AI 工作流程與工具：從任務拆解到職場落地',
    description:
      '比利陳整理 17 篇 AI 工作流程實戰筆記，涵蓋任務拆解、ChatGPT 與 Claude 工具組合、會議與評論分析、品質檢查與資安底線。',
    heading: 'AI 工作流程與工具',
  },
  'business-model': {
    title: '商業模式與獲利：從需求驗證到定價結構',
    description:
      '比利陳整理商業模式、需求驗證、定價與獲利結構的實戰筆記，帶你用九個問題拆解一門生意到底靠什麼賺錢。',
    heading: '商業模式與獲利',
  },
  marketing: {
    title: '行銷策略與診斷：從定位、漏斗拆解到成長路徑',
    description:
      '比利陳整合 10 年 PM、品牌與廣告投放實戰經驗，整理行銷診斷公式、品牌定位、用戶評論分析，以及通往廣告、SEO 與文案專區的完整路線。',
    heading: '行銷策略與診斷',
  },
  career: {
    title: '職涯與轉型：35 歲以後的職場判斷力與 AI 時代定位',
    description:
      '比利陳給資深工作者與中階主管的職涯實戰筆記，涵蓋 AI 時代重新定位、可攜帶能力盤點、轉職決策評估與判斷力訓練。',
    heading: '職涯與轉型',
  },
  learning: {
    title: '學習與能力：AI 時代的知識管理與刻意練習',
    description:
      '比利陳整理個人知識管理、30 天 AI 學習路徑、T 型能力盤點與判斷力訓練筆記，幫你把輸入變成真正能交付的能力。',
    heading: '學習與能力',
  },
  'book-guides': {
    title: '書籍導讀：商業、行銷與職涯的實戰拆解筆記',
    description:
      '比利陳精選 9 本商業模式、行銷心理與職涯思維書單導讀，把厚重理論拆成職場與一人公司可以直接拿來用的判斷框架。',
    heading: '書籍導讀',
  },
  'personal-business': {
    title: '自媒體與個人事業：從零定位到一人公司交付系統',
    description:
      '比利陳分享自媒體起步、個人品牌信任累積、第一個付費 Offer 設計，以及用 AI 支撐一人公司穩定交付的完整實戰筆記。',
    heading: '自媒體與個人事業',
  },
};

const customMeta = hubMeta[slug];
const hasCustomHub = Boolean(customMeta);
const pageTitle = customMeta
  ? `${customMeta.title} - ${siteConfig.name}`
  : `${area.name} - ${siteConfig.name}`;
const pageDescription = customMeta ? customMeta.description : `${area.lead}${area.summary}`;
const heroHeading = customMeta ? customMeta.heading : area.name;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: heroHeading,
  description: pageDescription,
  url: canonical,
  inLanguage: 'zh-Hant-TW',
  author: { '@id': entityConfig.ids.person },
  publisher: { '@id': entityConfig.ids.person },
  isPartOf: { '@id': entityConfig.ids.website },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: areaTopics.length,
    itemListElement: areaTopics.map((topic, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: topic.name,
      url: `${siteConfig.url}${topicUrl(topic)}`,
    })),
  },
};
---

<MarketingLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={[schema]}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '主題', href: '/topics/' },
      { label: area.name },
    ]}
  />

  <section class="page-band">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold tracking-[0.15em] text-primary">知識主題指南</p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
        {heroHeading}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-muted md:text-lg">{area.lead}</p>
    </div>
  </section>

  {slug === 'notebooklm' && <NotebookLMHubGuide />}
  {slug === 'ai-workflow' && <AIWorkflowHubGuide />}
  {slug === 'business-model' && <BusinessModelHubGuide />}
  {slug === 'marketing' && <MarketingHubGuide />}
  {slug === 'career' && <CareerHubGuide />}
  {slug === 'learning' && <LearningHubGuide />}
  {slug === 'book-guides' && <BookGuidesHubGuide publishedIds={publishedIds} />}
  {slug === 'personal-business' && <PersonalBusinessHubGuide />}

  <section class="bg-background py-12 md:py-16" aria-labelledby="area-topics-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 id="area-topics-title" class="text-xl font-bold tracking-tight text-text md:text-2xl">
        {hasCustomHub ? '或依情境直接切入子主題路線' : '你現在遇到的是哪一種？'}
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          areaTopics.map((topic) => (
            <TopicCard
              href={topicUrl(topic)}
              name={topic.name}
              lead={topic.lead}
              count={countOf(topic.articleIds)}
            />
          ))
        }
      </div>
      <p class="mt-10 text-sm text-text-muted">
        想自己逛？
        <a
          href="/blog/"
          class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:text-primary-dark"
        >
          到文章列表自己逛
        </a>
      </p>
    </div>
  </section>
</MarketingLayout>
