---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { postUrl } from '@/lib/blog';
import { calculateReadingTime } from '@/lib/utils';
import { getThemeBySlug } from '@/lib/themes';
import { homeTopics, type HomeTopic } from '@/lib/homepage';
import { getTopicCuration } from '@/lib/topic-curation';

interface Props {
  topic: HomeTopic;
}

export async function getStaticPaths() {
  return homeTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const theme = getThemeBySlug(topic.category);

if (!theme) {
  throw new Error(`Topic ${topic.slug} 找不到對應的 theme：${topic.category}`);
}

const curation = getTopicCuration(topic.slug);

if (!curation) {
  throw new Error(`Topic ${topic.slug} 尚未設定編輯精選。`);
}

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const postById = new Map(allPosts.map((post) => [post.id, post]));

function resolvePost(id: string) {
  const post = postById.get(id);
  if (!post) {
    throw new Error(`主題 ${topic.slug} 找不到文章：${id}`);
  }
  return post;
}

const startPosts = curation.start.map((item) => ({
  ...item,
  post: resolvePost(item.id),
}));

const directions = curation.directions.map((direction) => ({
  ...direction,
  articles: direction.articleIds.map((id) => resolvePost(id)),
}));

const curatedPosts = [
  ...startPosts.map(({ post }) => post),
  ...directions.flatMap(({ articles }) => articles),
];

const topicPath = `/topics/${topic.slug}/`;
const canonical = `${siteConfig.url}${topicPath}`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: `${topic.name}主題`,
  description: curation.intro,
  url: canonical,
  inLanguage: 'zh-Hant-TW',
  about: {
    '@type': 'Thing',
    name: topic.name,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': `${siteConfig.url}/blog/#blog`,
    name: `${siteConfig.name} 文章`,
    url: `${siteConfig.url}/blog/`,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: curatedPosts.length,
    itemListElement: curatedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: `${siteConfig.url}${postUrl(post.id)}`,
    })),
  },
};

const schemas = [collectionSchema];
---

<MarketingLayout
  title={`${topic.name} - ${siteConfig.name}`}
  description={curation.intro}
  structuredData={schemas}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '主題', href: '/topics/' },
      { label: topic.name },
    ]}
  />

  {/* 1. 這頁是什麼 */}
  <section class="border-b border-border bg-background pb-12 pt-10 md:pb-14 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
        主題路徑 · 不是文章列表
      </p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-text md:text-5xl">
        {topic.name}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-muted md:text-lg">
        {curation.intro}
      </p>
      <div class="mt-6 max-w-3xl rounded-xl border border-border bg-background px-4 py-3 md:px-5 md:py-4">
        <p class="text-sm leading-relaxed text-text">
          <span class="font-semibold text-primary">適合誰讀：</span>
          {curation.audience}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          這一頁只放編輯精選：先讀起點，再依方向往下。完整文章在文章庫。
        </p>
      </div>
    </div>
  </section>

  {/* 2. 從這裡開始 */}
  <section class="border-b border-border bg-background py-12 md:py-16" aria-labelledby="topic-start-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-text-muted">
          第一步
        </p>
        <h2 id="topic-start-title" class="mt-2 text-2xl font-bold tracking-tight text-text md:text-3xl">
          從這裡開始
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-text-muted md:text-base">
          建議照 1 → 2 → 3 的順序讀：{curation.readingOrder}
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3 md:gap-5">
        {
          startPosts.map(({ post, role }, startIndex) => (
            <a
              href={postUrl(post.id)}
              class:list={[
                'group flex h-full flex-col rounded-2xl border bg-background p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg',
                role === '核心指南'
                  ? 'border-primary/50 hover:border-primary'
                  : 'border-border hover:border-primary/40',
              ]}
            >
              <div class="flex items-center justify-between gap-3">
                <span class="text-3xl font-extrabold leading-none text-primary/70" aria-hidden="true">
                  {startIndex + 1}
                </span>
                <span
                  class:list={[
                    'inline-flex w-fit rounded-full px-3 py-1 text-[11px] font-semibold',
                    role === '核心指南'
                      ? 'bg-primary text-white'
                      : 'border border-border text-text-muted',
                  ]}
                >
                  {role}
                </span>
              </div>
              <h3 class="mt-4 text-xl font-bold leading-snug text-text transition-colors group-hover:text-primary">
                {post.data.title}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
                {post.data.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                閱讀文章
                <span aria-hidden="true">→</span>
                <span class="ml-auto font-normal text-text-muted">
                  {calculateReadingTime(post.body || '')} 分鐘
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3. 依方向深入 */}
  <section class="border-b border-border bg-background py-12 md:py-16" aria-labelledby="topic-directions-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-text-muted">
          第二步
        </p>
        <h2 id="topic-directions-title" class="mt-2 text-2xl font-bold tracking-tight text-text md:text-3xl">
          依方向深入
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-text-muted md:text-base">
          讀完起點後，選一條你現在卡的方向，不要一次全讀。
        </p>
      </div>

      <div class="mt-10 space-y-12 md:space-y-14">
        {
          directions.map((direction, directionIndex) => (
            <section
              aria-labelledby={`topic-direction-${directionIndex}`}
              class="border-t border-border pt-10 first:border-t-0 first:pt-0"
            >
              <div class="max-w-3xl">
                <p class="text-xs font-semibold text-primary">
                  方向 {directionIndex + 1}
                </p>
                <h3
                  id={`topic-direction-${directionIndex}`}
                  class="mt-1 text-xl font-bold tracking-tight text-text md:text-2xl"
                >
                  {direction.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted md:text-base">
                  {direction.description}
                </p>
              </div>

              <div
                class:list={[
                  'mt-6 grid gap-4',
                  direction.articles.length === 1
                    ? 'max-w-3xl'
                    : direction.articles.length === 2 || direction.articles.length === 4
                      ? 'sm:grid-cols-2'
                      : 'sm:grid-cols-2 lg:grid-cols-3',
                ]}
              >
                {direction.articles.map((post) => (
                  <a
                    href={postUrl(post.id)}
                    class="group flex h-full flex-col rounded-2xl border border-border bg-background p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
                  >
                    <h4 class="text-base font-bold leading-snug text-text transition-colors group-hover:text-primary">
                      {post.data.title}
                    </h4>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">
                      {post.data.description}
                    </p>
                    <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                      閱讀文章
                      <span aria-hidden="true">→</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4. 下一步 */}
  <section class="bg-background py-12 md:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-border bg-background p-7 md:flex md:items-center md:justify-between md:gap-8 md:p-9">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-text-muted">
            看更多
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-text">
            這個主題的全部文章
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-muted">
            主題頁只放精選路徑。若要瀏覽完整列表，到文章庫篩選此主題。
          </p>
        </div>
        <a
          href={`/blog/?theme=${theme.slug}`}
          class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 md:mt-0"
        >
          前往所有文章
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        curation.series && (
          <p class="mt-6 text-sm leading-relaxed text-text-muted">
            想照順序學：
            <a
              href={curation.series.href}
              class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:text-primary-dark"
            >
              {curation.series.name}
            </a>
            <span class="ml-2">{curation.series.note}</span>
          </p>
        )
      }
    </div>
  </section>
</MarketingLayout>
