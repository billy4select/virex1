---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TopicCard from '@/components/topics/TopicCard.astro';
import NotebookLMHubGuide from '@/components/topics/NotebookLMHubGuide.astro';
import { siteConfig } from '@/config';
import { entityConfig } from '@/config/entity';
import { getPublishedPosts } from '@/lib/blog';
import { topicAreas, getArea, getTopicsByArea, topicUrl } from '@/lib/topic-curation';

interface Props {
  slug: string;
}

export async function getStaticPaths() {
  return topicAreas.map((area) => ({
    params: { topic: area.slug },
    props: { slug: area.slug },
  }));
}

const { slug } = Astro.props;
const area = getArea(slug);
if (!area) throw new Error(`找不到領域：${slug}`);

const publishedIds = new Set((await getPublishedPosts()).map((post) => post.id));
const countOf = (ids: string[]) => ids.filter((id) => publishedIds.has(id)).length;
const areaTopics = getTopicsByArea(slug).filter((topic) => countOf(topic.articleIds) > 0);
const canonical = `${siteConfig.url}/topics/${slug}/`;

const isNotebookLM = slug === 'notebooklm';
const pageTitle = isNotebookLM
  ? `NotebookLM 實戰指南：從 PDF 處理到工作研究 - ${siteConfig.name}`
  : `${area.name} - ${siteConfig.name}`;
const pageDescription = isNotebookLM
  ? '整理比利陳實測 NotebookLM 的 9 篇完整筆記，涵蓋掃描 PDF 轉檔、亂碼排錯、五種提問方法，以及與 Claude、Notion AI 的工具比較。'
  : `${area.lead}${area.summary}`;
const heroHeading = isNotebookLM ? 'NotebookLM 實戰指南' : area.name;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: heroHeading,
  description: pageDescription,
  url: canonical,
  inLanguage: 'zh-Hant-TW',
  author: { '@id': entityConfig.ids.person },
  publisher: { '@id': entityConfig.ids.person },
  isPartOf: { '@id': entityConfig.ids.website },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: areaTopics.length,
    itemListElement: areaTopics.map((topic, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: topic.name,
      url: `${siteConfig.url}${topicUrl(topic)}`,
    })),
  },
};
---

<MarketingLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={[schema]}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '主題', href: '/topics/' },
      { label: area.name },
    ]}
  />

  <section class="border-b border-border bg-surface pb-10 pt-8 md:pb-14 md:pt-12">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl lg:text-5xl">
        {heroHeading}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-text-muted md:text-xl">{area.lead}</p>
    </div>
  </section>

  {isNotebookLM && <NotebookLMHubGuide />}

  <section class="bg-background py-12 md:py-16" aria-labelledby="area-topics-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 id="area-topics-title" class="text-xl font-bold tracking-tight text-text md:text-2xl">
        {isNotebookLM ? '或依情境直接切入子主題路線' : '你現在遇到的是哪一種？'}
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          areaTopics.map((topic) => (
            <TopicCard
              href={topicUrl(topic)}
              name={topic.name}
              lead={topic.lead}
              count={countOf(topic.articleIds)}
            />
          ))
        }
      </div>
      <p class="mt-10 text-sm text-text-muted">
        想自己逛？
        <a
          href="/blog/"
          class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:text-primary-dark"
        >
          到文章列表自己逛
        </a>
      </p>
    </div>
  </section>
</MarketingLayout>
