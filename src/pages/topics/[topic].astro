---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ThemePostRow from '@/components/blog/ThemePostRow.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { sortByDate } from '@/lib/blog';
import { getThemeBySlug, getThemePosts } from '@/lib/themes';
import { homeTopics, type HomeTopic } from '@/lib/homepage';

interface Props {
  topic: HomeTopic;
}

export async function getStaticPaths() {
  return homeTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const theme = getThemeBySlug(topic.category);

if (!theme) {
  throw new Error(`Topic ${topic.slug} 找不到對應的 theme：${topic.category}`);
}

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);
const posts = getThemePosts(sortedPosts, theme);

const topicPath = `/topics/${topic.slug}/`;
const canonical = `${siteConfig.url}${topicPath}`;

const collectionSchema =
  posts.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': `${canonical}#collection`,
        name: `${topic.name}文章`,
        description: topic.description,
        url: canonical,
        inLanguage: 'zh-Hant-TW',
        about: {
          '@type': 'Thing',
          name: topic.name,
        },
        isPartOf: {
          '@type': 'Blog',
          '@id': `${siteConfig.url}/blog/#blog`,
          name: `${siteConfig.name} 文章`,
          url: `${siteConfig.url}/blog/`,
        },
        mainEntity: {
          '@type': 'ItemList',
          itemListOrder: 'https://schema.org/ItemListOrderDescending',
          numberOfItems: posts.length,
          itemListElement: posts.map((post, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: post.data.title,
            url: `${siteConfig.url}/blog/${post.id}/`,
          })),
        },
      }
    : null;

const schemas = collectionSchema ? [collectionSchema] : [];
---

<MarketingLayout
  title={`${topic.name} - ${siteConfig.name}`}
  description={topic.description}
  structuredData={schemas}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '主題', href: '/topics/' },
      { label: topic.name },
    ]}
  />

  <section class="border-b border-border bg-background pb-10 pt-10 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
        主題
      </p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-text md:text-5xl">
        {topic.name}
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-muted">
        {topic.description}
      </p>
      <p class="mt-5 text-xs font-medium text-text-muted">
        目前收錄 {posts.length} 篇文章
      </p>
    </div>
  </section>

  <section class="bg-background py-10 md:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {
        topic.featured.length > 0 && (
          <section aria-labelledby="topic-featured-title">
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border pb-3">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
                  精選文章
                </p>
                <h2 id="topic-featured-title" class="mt-3 text-2xl font-bold tracking-tight text-text">
                  不知道從哪裡開始，先讀這兩篇。
                </h2>
              </div>
              <span class="text-xs font-medium text-text-muted">
                {topic.featured.length} 篇
              </span>
            </div>

            <div class="mt-5 grid gap-4 md:grid-cols-2">
              {topic.featured.map((article) => (
                <a
                  href={article.href}
                  class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
                >
                  <h3 class="text-xl font-bold leading-snug text-text transition-colors group-hover:text-primary">
                    {article.label}
                  </h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
                    {article.note}
                  </p>
                  <span class="mt-5 inline-flex w-fit items-center gap-1 rounded-full border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-white">
                    閱讀文章
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        posts.length > 0 ? (
          <section class:list={['', topic.featured.length > 0 ? 'mt-12' : '']} aria-labelledby="topic-all-title">
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border pb-3">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
                  全部文章
                </p>
                <h2 id="topic-all-title" class="mt-3 text-2xl font-bold tracking-tight text-text">
                  這個主題的所有文章。
                </h2>
              </div>
              <span class="text-xs font-medium text-text-muted">
                依最新發布排序
              </span>
            </div>

            <div class="mt-2">
              {posts.map((post) => <ThemePostRow post={post} />)}
            </div>
          </section>
        ) : (
          <div class="rounded-2xl border border-dashed border-border bg-surface/60 p-8 text-center">
            <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">研究中</p>
            <h2 class="mt-3 text-2xl font-bold text-text">這個主題還沒有正式文章。</h2>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-text-muted">
              等第一個問題有足夠的資料、案例與判斷，才會發布。
            </p>
          </div>
        )
      }
    </div>
  </section>
</MarketingLayout>
