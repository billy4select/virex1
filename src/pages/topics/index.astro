---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TopicGrid from '@/components/home/TopicGrid.astro';
import { homeTopics } from '@/lib/homepage';
import { siteConfig } from '@/config';
---

<MarketingLayout
  title={`主題 - ${siteConfig.name}`}
  description="比利陳的三個研究主題：能力與學習、商業與思考、個人發展與事業。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '主題' }]} />
  <h1 class="sr-only">主題</h1>

  <TopicGrid topics={homeTopics} />
</MarketingLayout>
