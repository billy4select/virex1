---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/config';
import { getPublishedPosts } from '@/lib/blog';
import { topicAreas, getTopicsByArea } from '@/lib/topic-curation';

const publishedIds = new Set((await getPublishedPosts()).map((post) => post.id));
const countOf = (ids: string[]) => ids.filter((id) => publishedIds.has(id)).length;

const areas = topicAreas
  .map((area, index) => {
    const topics = getTopicsByArea(area.slug).filter(
      (topic) => countOf(topic.articleIds) > 0,
    );

    return {
      ...area,
      index: String(index + 1).padStart(2, '0'),
      topicCount: topics.length,
      articleCount: new Set(
        topics.flatMap((topic) => topic.articleIds).filter((id) => publishedIds.has(id)),
      ).size,
    };
  })
  .filter((area) => area.topicCount > 0);
---

<MarketingLayout
  title={`主題 - ${siteConfig.name}`}
  description="探索八大知識領域，從 AI 工作流程、商業模式、行銷到自媒體與個人事業，找到適合自己的閱讀主題。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '主題' }]} />

  <section class="page-band">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
        探索主題
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted md:text-lg">
        從八個知識領域開始，找到你現在想解決的問題。點進領域後，再挑選適合自己的閱讀路線。
      </p>
    </div>
  </section>

  <section class="bg-background pb-16 md:pb-24" aria-label="八大主題領域">
    <div class="mx-auto grid max-w-6xl gap-5 px-4 sm:px-6 md:grid-cols-2 lg:gap-6 lg:px-8">
      {
        areas.map((area) => (
          <a
            href={`/topics/${area.slug}/`}
            class="group relative flex min-h-64 flex-col overflow-hidden rounded-3xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5 md:min-h-72 md:p-8"
          >
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-sm font-semibold tracking-wider text-primary">
                {area.index}
              </span>
              <span class="rounded-full border border-border bg-background px-3 py-1.5 text-xs font-medium text-text-muted">
                {area.topicCount} 個主題
              </span>
            </div>

            <div class="mt-8 flex-1">
              <h2 class="text-xl font-bold tracking-tight text-text transition-colors group-hover:text-primary md:text-2xl">
                {area.name}
              </h2>
              <p class="mt-3 text-sm font-semibold leading-relaxed text-text md:text-base">
                {area.question}
              </p>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-muted">
                {area.summary}
              </p>
            </div>

            <div class="mt-8 flex items-center justify-between border-t border-border pt-4">
              <span class="text-xs text-text-muted">
                收錄 {area.articleCount} 篇文章
              </span>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary">
                探索領域
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</MarketingLayout>
