---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { homeTopics } from '@/lib/homepage';
import { getTopicCuration } from '@/lib/topic-curation';
import { siteConfig } from '@/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const postById = new Map(allPosts.map((p) => [p.id, p]));

// 每個主題：文章數 + 第一篇起點文章標題（讓讀者在進主題頁前就看到實際內容）
const topics = homeTopics.map((topic) => {
  const curation = getTopicCuration(topic.slug);
  const startPost = curation ? postById.get(curation.start[0]?.id) : undefined;
  return {
    ...topic,
    lead: curation?.lead ?? topic.question,
    count: allPosts.filter((p) => p.data.category === topic.name).length,
    startTitle: startPost?.data.title,
  };
});
---

<MarketingLayout
  title={`主題 - ${siteConfig.name}`}
  description="工作與效率、學習與能力、商業與行銷、個人發展與事業。從你現在想解決的問題開始。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '主題' }]} />

  <section class="bg-background pb-10 pt-10 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl lg:text-5xl">
        四大主題
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted">
        四個方向，每個都有一篇可以直接開始讀的文章。
      </p>
    </div>
  </section>

  <section class="bg-background pb-16 pt-4 md:pb-20 md:pt-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          topics.map((topic, index) => (
            <a
              href={topic.href}
              class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
            >
              <span class="font-mono text-sm font-medium tabular-nums text-primary">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="mt-4 text-xl font-extrabold tracking-tight text-text transition-colors group-hover:text-primary md:text-2xl">
                {topic.name}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">
                {topic.lead}
              </p>
              {topic.startTitle && (
                <div class="mt-5 flex-1 border-t border-border pt-4">
                  <p class="text-[11px] font-bold tracking-[0.15em] text-text-muted">從這篇開始</p>
                  <p class="mt-1.5 text-sm font-semibold leading-snug text-text">
                    {topic.startTitle}
                  </p>
                </div>
              )}
              <span class="mt-5 flex items-center justify-between text-sm">
                <span class="text-xs text-text-muted">{topic.count} 篇文章</span>
                <span class="inline-flex items-center gap-1 font-semibold text-primary">
                  進入主題
                  <span aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>
