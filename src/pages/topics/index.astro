---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TopicCard from '@/components/topics/TopicCard.astro';
import { siteConfig } from '@/config';
import { topicAreas, getTopicsByArea, topicUrl } from '@/lib/topic-curation';

const areas = topicAreas.map((area) => ({
  ...area,
  topics: getTopicsByArea(area.slug).map((topic) => ({
    href: topicUrl(topic),
    name: topic.name,
    lead: topic.lead,
    count: topic.articleIds.length,
  })),
}));
---

<MarketingLayout
  title={`主題 - ${siteConfig.name}`}
  description="從你現在遇到的處境開始：想用 AI 工作、讀懂 NotebookLM、驗證想法、改善行銷，或規劃職涯。每個主題都是一條整理好的閱讀路線。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '主題' }]} />

  <section class="bg-background pb-8 pt-10 md:pt-14">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl lg:text-5xl">
        主題
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted">
        從你現在遇到的處境開始，每個主題都是一條整理好的閱讀路線。
      </p>
    </div>
  </section>

  <section class="bg-background pb-16 md:pb-24">
    <div class="mx-auto max-w-5xl space-y-14 px-4 sm:px-6 lg:px-8">
      {
        areas.map((area) => (
          <div aria-labelledby={`area-${area.slug}`}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border pb-3">
              <h2 id={`area-${area.slug}`} class="text-xl font-bold tracking-tight text-text md:text-2xl">
                {area.name}
              </h2>
              <a
                href={`/topics/${area.slug}/`}
                class="text-sm font-semibold text-primary hover:text-primary-dark"
              >
                看整個領域 →
              </a>
            </div>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {area.topics.map((topic) => (
                <TopicCard {...topic} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</MarketingLayout>
