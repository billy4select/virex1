---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { homeTopics } from '@/lib/homepage';
import { siteConfig } from '@/config';

const topics = homeTopics;
---

<MarketingLayout
  title={`主題 - ${siteConfig.name}`}
  description="比利陳的四個長期內容主題：工作與效率、學習與能力、商業與行銷、個人發展與事業。每個主題都有編輯精選的入門路徑。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '主題' }]} />

  <section class="bg-background pb-10 pt-10 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-text md:text-5xl">
        選擇知識領域
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted">
        四個長期主題。每個主題都有編輯精選的入門路徑，不是文章分類列表。
      </p>
    </div>
  </section>

  <section class="bg-background pb-16 pt-4 md:pb-20 md:pt-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          topics.map((topic) => (
            <a
              href={topic.href}
              class="group flex h-full flex-col rounded-2xl border border-border bg-background p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
            >
              <h2 class="text-2xl font-extrabold tracking-tight text-text transition-colors group-hover:text-primary">
                {topic.name}
              </h2>
              <p class="mt-3 text-sm font-semibold leading-relaxed text-primary">
                {topic.question}
              </p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">
                {topic.description}
              </p>
              <span class="mt-6 inline-flex w-fit items-center gap-1 rounded-full border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-white">
                進入主題
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>
