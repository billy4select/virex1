---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { sortByDate } from '@/lib/blog';
import { getThemeBySlug, getThemePosts } from '@/lib/themes';
import { homeTopics } from '@/lib/homepage';
import { siteConfig } from '@/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);

const topics = homeTopics.map((topic) => {
  const theme = getThemeBySlug(topic.category);
  const posts = theme ? getThemePosts(sortedPosts, theme) : [];
  return { topic, count: posts.length };
});
---

<MarketingLayout
  title={`主題 - ${siteConfig.name}`}
  description="比利陳的三個內容主題：能力與學習、商業與思考、個人發展與事業。用主題找到相關文章。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '主題' }]} />

  <section class="bg-surface pb-10 pt-10 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
        內容目錄
      </p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-text md:text-5xl">
        探索主題
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted">
        三個長期研究主題，也是網站的內容分類。選一個你有興趣的方向，進去後直接找文章。
      </p>
    </div>
  </section>

  <section class="bg-background pb-4 pt-4 md:pb-6 md:pt-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="divide-y divide-border">
        {
          topics.map(({ topic, count }, index) => (
            <article class="grid gap-6 py-8 md:grid-cols-[56px_minmax(0,1fr)_360px] md:gap-8 md:py-10">
              <div class="hidden md:block">
                <span class="text-3xl font-black leading-none tracking-[-0.04em] text-primary">
                  0{index + 1}
                </span>
              </div>

              <div>
                <div class="flex items-center gap-3">
                  <span class="text-3xl font-black leading-none tracking-[-0.04em] text-primary md:hidden">
                    0{index + 1}
                  </span>
                  <h2 class="text-2xl font-extrabold tracking-tight text-text md:text-3xl">
                    <a href={topic.href} class="transition-colors hover:text-primary">
                      {topic.name}
                    </a>
                  </h2>
                </div>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-text-muted">
                  {topic.description}
                </p>
                <p class="mt-4 text-xs font-medium text-text-muted">
                  目前收錄 {count} 篇文章
                </p>
              </div>

              <div class="md:border-l md:border-border md:pl-8">
                <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-text-muted">
                  精選文章
                </p>
                <ul class="mt-3 space-y-2.5">
                  {topic.featured.map((article) => (
                    <li>
                      <a
                        href={article.href}
                        class="group flex items-start justify-between gap-3 text-sm leading-relaxed"
                      >
                        <span class="text-text transition-colors group-hover:text-primary">
                          {article.label}
                        </span>
                        <span aria-hidden="true" class="mt-0.5 shrink-0 text-primary">
                          →
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a
                  href={topic.href}
                  class="mt-4 inline-flex items-center gap-1 rounded-full border border-primary/30 px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white"
                >
                  進入主題
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>
