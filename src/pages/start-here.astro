---
/**
 * 從這裡開始 /start-here/
 *
 * 輕量級新訪客入門頁（3 屏內滑完、只選一條路走）：
 * 與完整全站目錄 /topics/ 做出明顯體感區隔，讓社群或首頁進來的新朋友無壓力認識比利陳並選一條路線出發。
 */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleAuthor from '@/components/blog/ArticleAuthor.astro';
import { siteConfig } from '@/config';
import { entityConfig } from '@/config/entity';

const canonical = `${siteConfig.url}/start-here/`;

const schemaLinks = [
  { name: 'AI 工作流程與工具', href: '/topics/ai-workflow/' },
  { name: 'NotebookLM 實戰指南', href: '/topics/notebooklm/' },
  { name: '行銷策略與診斷', href: '/topics/marketing/' },
  { name: '職涯與轉型', href: '/topics/career/' },
  { name: '自媒體與個人事業', href: '/topics/personal-business/' },
  { name: '教學總覽', href: '/series/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: '從這裡開始：第一次來到行銷裡的路人甲',
  description:
    '第一次來到比利陳的網站？花一分鐘看懂這裡在寫什麼，直接挑一條最符合你目前需求的路線開始。',
  url: canonical,
  inLanguage: 'zh-Hant-TW',
  author: { '@id': entityConfig.ids.person },
  publisher: { '@id': entityConfig.ids.person },
  isPartOf: { '@id': entityConfig.ids.website },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: schemaLinks.length,
    itemListElement: schemaLinks.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: new URL(item.href, siteConfig.url).href,
    })),
  },
};
---

<MarketingLayout
  title={`從這裡開始：第一次來到行銷裡的路人甲 - ${siteConfig.name}`}
  description="第一次來到比利陳的網站？花一分鐘看懂這裡在寫什麼，直接挑一條最符合你目前需求的路線開始。"
  structuredData={[schema]}
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '從這裡開始' }]} />

  <section class="page-band">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-[0.15em] text-primary">新朋友導覽</p>
        <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
          從這裡開始
        </h1>
        <div class="mt-5 space-y-4 text-base leading-8 text-text-muted md:text-lg">
          <p>站上有一百多篇文章，一次看全部很容易眼花。</p>
          <p>
            這個網站沒有每天追最新的 AI 新聞，也很少寫只講觀念的心靈雞湯（那種東西滑社群就看飽了）。
          </p>
          <p>
            我是比利陳，過去十年跑過 PM、品牌行銷跟廣告投放。這裡記錄的，是我實際放進工作跟生意裡之後，確定真的有用、留下來繼續用的判斷方法。
          </p>
          <p>
            如果你想先了解我的背景，可以先逛
            <a
              href="/about/"
              class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
            >
              關於比利陳
            </a>
            。如果想直接找答案，照你現在最在意的事選一個入口就好。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-12 md:py-16" aria-labelledby="pick-one-path">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 id="pick-one-path" class="text-2xl font-extrabold tracking-tight text-text md:text-3xl">
          你現在最想解決哪一件事
        </h2>

      <ol class="mt-7 space-y-4">
        <li class="rounded-2xl border border-border bg-surface/60 p-5 transition-colors hover:border-primary/40 sm:p-6">
          <div class="flex items-start gap-4">
            <span class="pt-0.5 font-mono text-sm font-bold text-primary">01</span>
            <div class="min-w-0 space-y-2">
              <h3 class="text-base font-extrabold leading-snug text-text sm:text-lg">
                想把 AI 放進日常工作，但工具太多不知道怎麼搭
              </h3>
              <p class="text-sm leading-7 text-text-muted sm:text-base">
                <span class="mr-1 font-semibold text-primary" aria-hidden="true">→</span>
                直接看
                <a
                  href="/topics/ai-workflow/"
                  class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  AI 工作流程與工具
                </a>
                （如果平常要處理大量 PDF 跟長報告，改看
                <a
                  href="/topics/notebooklm/"
                  class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  NotebookLM 實戰指南
                </a>
                ）。
              </p>
            </div>
          </div>
        </li>

        <li class="rounded-2xl border border-border bg-surface/60 p-5 transition-colors hover:border-primary/40 sm:p-6">
          <div class="flex items-start gap-4">
            <span class="pt-0.5 font-mono text-sm font-bold text-primary">02</span>
            <div class="min-w-0 space-y-2">
              <h3 class="text-base font-extrabold leading-snug text-text sm:text-lg">
                廣告越投越貴，或行銷做起來一直沒轉換
              </h3>
              <p class="text-sm leading-7 text-text-muted sm:text-base">
                <span class="mr-1 font-semibold text-primary" aria-hidden="true">→</span>
                先看
                <a
                  href="/topics/marketing/"
                  class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  行銷策略與診斷
                </a>
                ，搞懂是流量、轉換還是受眾出了問題。
              </p>
            </div>
          </div>
        </li>

        <li class="rounded-2xl border border-border bg-surface/60 p-5 transition-colors hover:border-primary/40 sm:p-6">
          <div class="flex items-start gap-4">
            <span class="pt-0.5 font-mono text-sm font-bold text-primary">03</span>
            <div class="min-w-0 space-y-2">
              <h3 class="text-base font-extrabold leading-snug text-text sm:text-lg">
                在想 35 歲後的職涯下一步，或想開始做個人品牌
              </h3>
              <p class="text-sm leading-7 text-text-muted sm:text-base">
                <span class="mr-1 font-semibold text-primary" aria-hidden="true">→</span>
                職場定位看
                <a
                  href="/topics/career/"
                  class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  職涯與轉型
                </a>
                ，想靠自己接案或變現看
                <a
                  href="/topics/personal-business/"
                  class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  自媒體與個人事業
                </a>
                。
              </p>
            </div>
          </div>
        </li>

        <li class="rounded-2xl border border-border bg-surface/60 p-5 transition-colors hover:border-primary/40 sm:p-6">
          <div class="flex items-start gap-4">
            <span class="pt-0.5 font-mono text-sm font-bold text-primary">04</span>
            <div class="min-w-0 space-y-2">
              <h3 class="text-base font-extrabold leading-snug text-text sm:text-lg">
                懶得一篇一篇找，想直接跟著完整教學或用免費工具
              </h3>
              <p class="text-sm leading-7 text-text-muted sm:text-base">
                <span class="mr-1 font-semibold text-primary" aria-hidden="true">→</span>
                直接逛
                <a
                  href="/series/"
                  class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
                >
                  教學總覽
                </a>
                ，裡面有排版好的實作專題、章節教學跟純前端工具。
              </p>
            </div>
          </div>
        </li>
      </ol>

      <div class="mt-12 border-t border-border pt-10">
        <h2 class="text-xl font-extrabold tracking-tight text-text md:text-2xl">
          想看全站目錄，或每週收一封整理
        </h2>
        <div class="mt-4 space-y-3 text-sm leading-7 text-text-muted sm:text-base">
          <p>
            如果你想自己慢慢挑文章分類，完整的知識地圖都在
            <a
              href="/topics/"
              class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
            >
              知識主題總覽
            </a>
            。
          </p>
          <p>
            如果你習慣每週花五分鐘看一篇濃縮過的實戰觀察，歡迎訂閱
            <a
              href="https://billy4select.substack.com/"
              target="_blank"
              rel="noopener noreferrer"
              data-conversion-cta="newsletter"
              data-conversion-target="substack"
              data-conversion-category="從這裡開始"
              class="font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:text-primary-dark"
            >
              比利陳 Substack 電子報
            </a>
            。
          </p>
        </div>

        <ArticleAuthor />
      </div>
      </div>
    </div>
  </section>

  <script>
    import '@/scripts/conversion';
  </script>
</MarketingLayout>
