---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import SeriesChapter from '@/components/series/SeriesChapter.astro';
import '@/styles/series.css';
import { siteConfig } from '@/config';
import { marketingChapters, type MarketingChapter } from '@/lib/marketing-series';

export function getStaticPaths() {
  return marketingChapters.map((chapter, index) => ({
    params: { chapter: chapter.slug },
    props: {
      chapter,
      prev: index > 0 ? marketingChapters[index - 1] : undefined,
      next: index < marketingChapters.length - 1 ? marketingChapters[index + 1] : undefined,
    },
  }));
}

interface Props {
  chapter: MarketingChapter;
  prev?: MarketingChapter;
  next?: MarketingChapter;
}

const { chapter, prev, next } = Astro.props;
const url = `${siteConfig.url}/marketing/${chapter.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: chapter.title,
  description: chapter.description,
  inLanguage: 'zh-Hant-TW',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@type': 'CollectionPage', name: '行銷教學', url: `${siteConfig.url}/marketing/` },
  author: { '@type': 'Person', name: '比利陳 Billy Chen' },
  publisher: { '@type': 'Organization', name: siteConfig.name },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: `${siteConfig.url}/` },
    { '@type': 'ListItem', position: 2, name: '教學', item: `${siteConfig.url}/series/` },
    { '@type': 'ListItem', position: 3, name: '行銷教學', item: `${siteConfig.url}/marketing/` },
    { '@type': 'ListItem', position: 4, name: `${chapter.no} ${chapter.short}`, item: url },
  ],
};
---

<MarketingLayout title={`${chapter.title} - ${siteConfig.name}`} description={chapter.description}>
  <SeriesChapter
    variant="sp-marketing"
    crumbs={[
      { label: '首頁', href: '/' },
      { label: '教學', href: '/series/' },
      { label: '行銷教學', href: '/marketing/' },
      { label: `${chapter.no} ${chapter.short}`, href: `/marketing/${chapter.slug}/` },
    ]}
    seriesLabel="行銷教學"
    seriesHref="/marketing/"
    chapter={chapter}
    all={marketingChapters.map((c) => ({ no: c.no, short: c.short, slug: c.slug }))}
    chapterBase="/marketing/"
    prev={prev}
    next={next}
    backLabel="行銷教學目錄"
    endHref="/blog/?theme=marketing-strategy"
    endLabel="讀更多行銷文章"
  />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</MarketingLayout>
