---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import SeriesHome from '@/components/series/SeriesHome.astro';
import '@/styles/series.css';
import { siteConfig } from '@/config';
import { marketingChapters } from '@/lib/marketing-series';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '行銷教學',
  description: '從三個角、業績診斷、受眾、定位、內容管道、廣告數字到決策與 90 天計畫，八章走完一輪可執行的行銷。',
  url: `${siteConfig.url}/marketing/`,
  inLanguage: 'zh-Hant-TW',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: marketingChapters.length,
    itemListElement: marketingChapters.map((chapter, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: chapter.title,
      url: `${siteConfig.url}/marketing/${chapter.slug}/`,
    })),
  },
};
---

<MarketingLayout
  title={`行銷教學 - ${siteConfig.name}`}
  description="八章從診斷開始的行銷教學：需求管道訊息、四段診斷、受眾、定位、內容與管道、廣告數字、決策與 90 天計畫。照順序讀完，能自己跑一輪。"
>
  <SeriesHome
    variant="sp-marketing"
    crumbs={[
      { label: '首頁', href: '/' },
      { label: '教學', href: '/series/' },
      { label: '行銷教學', href: '/marketing/' },
    ]}
    eyebrow="行銷教學 · 從哪一段壞了開始"
    titleLead="先找出哪一段掉下來，"
    titleAccent="再決定花錢"
    lead="工具不是起點，診斷才是。四段乘法定位問題，再處理受眾、定位、內容與廣告；八章之後，你會有一份 90 天可驗證的計畫，而不是一堆待辦清單。"
    stats={['8 章 · 約 6,000 字', '每章 5–8 分鐘', '20 篇延伸文章']}
    ctaHref="/marketing/three-corners/"
    ctaLabel="從第 01 章開始"
    secondaryHref="/blog/?theme=marketing-strategy"
    secondaryLabel="先看行銷文章"
    coreLabel="業績＝四段相乘"
    artNodes={['流量', '轉換', '客單價', '回購']}
    artNote="任何一段掉 20%，整體就掉 20%"
    chapters={marketingChapters.map((chapter) => ({
      slug: chapter.slug,
      no: chapter.no,
      title: chapter.title,
      lead: chapter.lead,
      outcome: chapter.outcome,
    }))}
    quick={[
      { label: '先診斷再加預算', value: '通常是轉換先掉，不是流量不夠。' },
      { label: '一次改一個變數', value: '同時改三件事，你不會知道哪件有用。' },
      { label: 'ROAS 損益兩平', value: '等於 1 ÷ 毛利率，不是固定 3 倍。' },
      { label: '樣本門檻', value: '50 次點擊或 10 筆轉換才有意義。' },
    ]}
    chapterBase="/marketing/"
    pathSteps={[
      { title: '診斷', desc: '先確認是流量、轉換、客單價還是回購出問題。' },
      { title: '修一段', desc: '一次只改一個變數，其餘先不動。' },
      { title: '驗證', desc: '50 次點擊或 10 筆轉換，才有統計意義。' },
      { title: '放大', desc: '有效就把預算移過去，無效就換下一個假設。' },
    ]}
    audience={[
      {
        title: '這套適合你，如果',
        items: [
          '有產品或服務，但業績不穩定、不知道卡在哪一段。',
          '會投廣告，卻只看 ROAS、說不出下一步該改什麼。',
          '想把行銷從「一直試」變成「一次驗證一件事」。',
        ],
      },
      {
        title: '這套不適合，如果',
        items: [
          '想找一套模板套用所有品類。',
          '還沒決定賣給誰，就想先優化轉換率。',
          '期待加了預算就會改善，而不打算動產品或價格。',
        ],
      },
    ]}
    authorNote="十多年行銷與產品經驗；這套順序來自我自己做過的診斷與踩過的坑。"
  />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</MarketingLayout>
