---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { postUrl } from '@/lib/blog';
import { calculateReadingTime } from '@/lib/utils';
import { getThemeBySlug } from '@/lib/themes';
import { homeTopics, type HomeTopic } from '@/lib/homepage';
import { getTopicCuration } from '@/lib/topic-curation';

interface Props {
  topic: HomeTopic;
}

export async function getStaticPaths() {
  return homeTopics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const theme = getThemeBySlug(topic.category);

if (!theme) {
  throw new Error(`Topic ${topic.slug} 找不到對應的 theme：${topic.category}`);
}

const curation = getTopicCuration(topic.slug);

if (!curation) {
  throw new Error(`Topic ${topic.slug} 尚未設定編輯精選。`);
}

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const postById = new Map(allPosts.map((post) => [post.id, post]));

function resolvePost(id: string) {
  const post = postById.get(id);
  if (!post) {
    throw new Error(`主題 ${topic.slug} 找不到文章：${id}`);
  }
  return post;
}

const startPosts = curation.start.map((item) => ({
  ...item,
  post: resolvePost(item.id),
}));

const directions = curation.directions.map((direction) => ({
  ...direction,
  articles: direction.articleIds.map((id) => resolvePost(id)),
}));

const curatedPosts = [
  ...startPosts.map(({ post }) => post),
  ...directions.flatMap(({ articles }) => articles),
];

const topicPath = `/topics/${topic.slug}/`;
const canonical = `${siteConfig.url}${topicPath}`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: `${topic.name}主題`,
  description: curation.intro,
  url: canonical,
  inLanguage: 'zh-Hant-TW',
  about: {
    '@type': 'Thing',
    name: topic.name,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': `${siteConfig.url}/blog/#blog`,
    name: `${siteConfig.name} 文章`,
    url: `${siteConfig.url}/blog/`,
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: curatedPosts.length,
    itemListElement: curatedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: `${siteConfig.url}${postUrl(post.id)}`,
    })),
  },
};

const schemas = [collectionSchema];

const readTime = (post: (typeof allPosts)[number]) =>
  calculateReadingTime(post.body || '');
const startMinutes = startPosts.reduce((sum, { post }) => sum + readTime(post), 0);
const themeTotal = allPosts.filter((p) => p.data.category === theme.name).length;
---

<MarketingLayout
  title={`${topic.name} - ${siteConfig.name}`}
  description={curation.intro}
  structuredData={schemas}
>
  <Breadcrumbs
    items={[
      { label: '首頁', href: '/' },
      { label: '主題', href: '/topics/' },
      { label: topic.name },
    ]}
  />

  {/* 1. 開頭：只放名稱與一句話 */}
  <section class="border-b border-border bg-surface pb-10 pt-8 md:pb-14 md:pt-12">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl lg:text-5xl">
        {topic.name}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-text-muted md:text-xl">
        {curation.lead}
      </p>
    </div>
  </section>

  {/* 2. 從這裡開始：單欄清單，照順序讀 */}
  <section class="bg-background pt-12 md:pt-16" aria-labelledby="topic-start-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 id="topic-start-title" class="text-xl font-bold tracking-tight text-text md:text-2xl">
          從這裡開始
        </h2>
        <p class="text-sm text-text-muted">照順序讀完，約 {startMinutes} 分鐘</p>
      </div>

      <ol class="mt-5 border-y border-border">
        {
          startPosts.map(({ post }, startIndex) => (
            <li class="border-b border-border last:border-b-0">
              <a
                href={postUrl(post.id)}
                class="group grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 py-5 transition-colors hover:bg-surface/70 sm:grid-cols-[2.5rem_minmax(0,1fr)_auto] sm:gap-x-4"
              >
                <span class="pt-1 font-mono text-sm font-medium tabular-nums text-primary">
                  {String(startIndex + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <h3 class="text-lg font-bold leading-snug text-text transition-colors group-hover:text-primary">
                    {post.data.title}
                  </h3>
                  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-text-muted">
                    {post.data.description}
                  </p>
                </div>
                <span class="col-start-2 mt-2 text-xs text-text-muted sm:col-start-3 sm:mt-1 sm:whitespace-nowrap">
                  {readTime(post)} 分鐘
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* 3. 依方向深入：只列標題，不重複放摘要 */}
  <section class="bg-background py-12 md:py-16" aria-labelledby="topic-directions-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 id="topic-directions-title" class="text-xl font-bold tracking-tight text-text md:text-2xl">
        想再深入，選一個方向
      </h2>

      <div class="mt-6 space-y-10">
        {
          directions.map((direction) => (
            <section>
              <h3 class="text-base font-bold text-text md:text-lg">{direction.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-text-muted">
                {direction.description}
              </p>
              <ul class="mt-3 border-t border-border">
                {direction.articles.map((post) => (
                  <li class="border-b border-border">
                    <a
                      href={postUrl(post.id)}
                      class="group flex items-baseline gap-3 py-3 transition-colors hover:bg-surface/70"
                    >
                      <span class="min-w-0 flex-1 text-[15px] font-semibold leading-snug text-text transition-colors group-hover:text-primary">
                        {post.data.title}
                      </span>
                      <span class="whitespace-nowrap text-xs text-text-muted">
                        {readTime(post)} 分鐘
                      </span>
                      <span
                        aria-hidden="true"
                        class="text-primary transition-transform group-hover:translate-x-0.5"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4. 收尾：一行連結，不再放大面板 */}
  <section class="border-t border-border bg-surface py-10 md:py-12">
    <div class="mx-auto flex max-w-4xl flex-col gap-4 px-4 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <div class="text-sm leading-relaxed text-text-muted">
        {
          curation.series && (
            <p>
              想照順序學：
              <a
                href={curation.series.href}
                class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:text-primary-dark"
              >
                {curation.series.name}
              </a>
              <span class="ml-1">{curation.series.note}</span>
            </p>
          )
        }
      </div>
      <a
        href={`/blog/?theme=${theme.slug}`}
        class="inline-flex w-fit items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        看「{topic.name}」全部 {themeTotal} 篇
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</MarketingLayout>
