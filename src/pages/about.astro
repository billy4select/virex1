
---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { topicAreas, topics as topicList } from '@/lib/topic-curation';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

/** 經驗以工作類型呈現；作者匿名經營，不公開任職公司與客戶名稱。 */
const experience = [
  '產業：傳統產業、3C 等多個產業',
  '產品：商品企劃、開發、維運',
  '行銷：廣告策略與投放、會員經營、網站管理',
  '內容：社群媒體、平面設計、內容製作、YouTube、Podcast',
  '數位產品：App 相關專案',
];

/** 領域（由 topic-curation.ts 產生，新增領域會自動出現） */
const topics = topicAreas.map((area) => ({
  name: area.name,
  href: `/topics/${area.slug}/`,
  description: area.summary,
}));

const sources = [
  {
    title: '工作經驗',
    description:
      '來自十多年在產品、廣告、會員、內容與平台經營上的實際判斷，包含做對的與做錯的。',
  },
  {
    title: '閱讀與研究',
    description:
      '整理公開資料、案例與研究，並盡量說明資料從哪裡來、判斷依據是什麼。',
  },
  {
    title: '親自實驗',
    description:
      'AI 工具、工作流程與內容經營，我會先自己動手試，再寫下測試條件與結果。',
  },
];

/** 獨立出版電子書（2025–2026），共四本。 */
const books = [
  {
    title: '從零開始自媒體',
    href: 'https://portaly.cc/billyselect4/product/ioeupgO66jK7vB24yJzY',
    description:
      '以行銷理論為基礎的自媒體經營指南，從目標受眾、內容、市場測試到變現與長期系統。',
  },
  {
    title: '寫給大家的行銷書',
    href: 'https://portaly.cc/billyselect4/product/FlzuxW1QbZpC79Op2zhE',
    description:
      '用「減法」看行銷：回到流量、轉換、客單價與回購的基本架構，先診斷問題出在哪裡。',
  },
  {
    title: '人人都做得到的知識變現',
    href: 'https://portaly.cc/billyselect4/product/icSVZ0k6BHdItavIKf9X',
    description:
      '為素人設計的知識整理方法，把經驗與技能萃取、結構化，做成課程或電子書等小型知識產品。',
  },
  {
    title: 'AI時代職場生存法則',
    href: 'https://portaly.cc/billyselect4/product/jLrib0ZgLmXWs2WOTiy8',
    description:
      '把 AI 放進日常工作的方法：任務拆解、工具選擇、協作流程與判斷邊界，讓效率提升而不是多一份焦慮。',
  },
  {
    title: '流量騙局',
    href: 'https://portaly.cc/billyselect4/product/khu55lTbwebNRjRtUCQ3',
    description:
      '拆解流量數字的錯覺：曝光、點擊與轉換之間差在哪，哪些指標值得追，哪些只是好看。',
  },
];
---

<MarketingLayout
  title={`關於我 - ${siteConfig.name}`}
  description="比利陳，十多年行銷與產品經驗，獨立出版四本電子書。讓工作與生活多一些值得探索的可能，分享工具、方法、閱讀與對行銷、商業、AI、工作與個人成長的觀察。"
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '關於我' }]} />

  <!-- 個人介紹 -->
  <section class="page-band">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-text md:text-4xl lg:text-5xl">
          關於比利
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-text-muted md:text-lg">
          認識 Billy 與這個知識庫的建立初衷。了解我如何整理複雜資訊，為你篩選出真正實用的解決方案。
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <section class="py-12 md:py-16">
      <div class="max-w-3xl">
        <div class="space-y-5 text-lg text-text-muted leading-relaxed">
          <p>
            我是比利陳（Billy Chen），有十多年的行銷與產品相關工作經驗，待過傳統產業與 3C 等不同產業，做過的工作從商品企劃、開發與維運，到網站管理、廣告策略與投放、會員經營，也包含平面設計、社群媒體、內容製作，以及 App、YouTube 與 Podcast 的經營。
          </p>

          <p>
            因為我以匿名方式經營這個網站，不公開任職公司與合作客戶的名稱，所以這裡只談做過的工作類型，以及從中得到的判斷。
          </p>

          <p>
            2025 到 2026 年，我獨立出版了四本電子書，也持續研究 AI 如何改變工作、內容與商業。
          </p>
        </div>

        <ul class="mt-8 space-y-2 text-base text-text-muted">
          {experience.map((item) => (
            <li class="flex gap-2">
              <span class="text-primary" aria-hidden="true">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 為什麼經營 -->
    <section class="py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          為什麼經營這個網站
        </h2>

        <div class="mt-6 space-y-5 text-text-muted leading-relaxed">
          <p>
            這些年做過不同工作，我發現真正有用的能力，大多不是某個工具或某個技巧，而是看懂問題、做出判斷、再把它變成行動。工具與平台一直在變，但這個過程不太會變。
          </p>
          <p>
            我經營這個網站，是想把自己學到、試過、做過的東西整理下來，讓同樣在工作、轉換跑道或探索發展的人，可以少走一些冤枉路。核心是：讓工作與生活，多一些值得探索的可能。
          </p>
        </div>
      </div>
    </section>

    <!-- 內容從哪裡來 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          內容從哪裡來
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          每篇文章的觀點，主要來自下面三種來源。文章會標示發布日期；內容有實質修改時，也會標示最後更新日期。
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          {sources.map((item) => (
            <div class="rounded-xl border border-border bg-surface p-6">
              <h3 class="font-semibold text-text">{item.title}</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 四個主題 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          這裡談哪些事
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          目前整理了 {topicList.length} 個主題，分成 {topics.length} 個領域，每個主題都是一條照順序讀的路線。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
          {topics.map((topic) => (
            <a
              href={topic.href}
              class="group rounded-xl border border-border bg-surface p-6 transition-colors hover:border-primary"
            >
              <h3 class="font-semibold text-text group-hover:text-primary">{topic.name}</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{topic.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 出版作品 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          出版作品
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          2025 到 2026 年獨立出版的四本電子書：自媒體、行銷、知識變現，以及 AI 時代的工作方法與流量判讀。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
          {books.map((book) => (
            <a
              href={book.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-xl border border-border bg-surface p-6 transition-colors hover:border-primary"
            >
              <h3 class="font-semibold text-text group-hover:text-primary">《{book.title}》</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{book.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                了解更多
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 其他平台 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          在其他平台找到我
        </h2>

        <p class="mt-4 text-text-muted leading-relaxed">
          除了這個網站，我也在不同平台分享內容。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
          <a
            href="https://www.youtube.com/@billyselect4"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-xl border border-border p-5 hover:border-primary transition-colors"
          >
            <h3 class="font-semibold text-text group-hover:text-primary">
              YouTube
            </h3>
            <p class="mt-2 text-sm text-text-muted">
              AI、自媒體、行銷與商業相關的長篇內容。
            </p>
          </a>

          <a
            href="https://www.threads.net/@billyselect4"
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-xl border border-border p-5 hover:border-primary transition-colors"
          >
            <h3 class="font-semibold text-text group-hover:text-primary">
              Threads
            </h3>
            <p class="mt-2 text-sm text-text-muted">
              日常觀察、想法與實際經驗。
            </p>
          </a>

          <a
            href="https://billy4select.substack.com/"
            class="group rounded-xl border border-border p-5 hover:border-primary transition-colors"
          >
            <h3 class="font-semibold text-text group-hover:text-primary">
              電子報
            </h3>
            <p class="mt-2 text-sm text-text-muted">
              整理值得深入研究的議題與近期觀察。
            </p>
          </a>
        </div>
      </div>
    </section>

    <!-- 文章入口 -->
    <CTA
      title="繼續探索"
      description="從主題挑一個開始，或直接看最新文章。"
      action={{ label: '看看最新文章', href: '/blog/' }}
      background="muted"
    />

  </div>
</MarketingLayout>
