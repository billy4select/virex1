
---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import ValuesSection from '@sections/team/ValuesSection.astro';
import TeamSection from '@sections/team/TeamSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

const values = [
  {
    title: 'AI 與工作方式',
    description:
      '持續研究 AI 工具與技術的發展，也實際把 AI 用在工作、內容製作與日常任務中。我關心的是，這些工具能帶來什麼改變，以及個人如何運用它們創造新的工作機會。',
  },
  {
    title: '內容與個人品牌',
    description:
      '從自媒體、社群經營到知識變現，我一直關注個人的經驗、專業與觀點，如何透過內容累積影響力，進一步發展成品牌、服務或商業模式。',
  },
  {
    title: '行銷與商業觀察',
    description:
      '從產品、品牌、消費者到市場變化，研究企業如何創造價值，以及一個商業模式如何運作。我也喜歡觀察新技術與新趨勢，會如何改變原本的產業規則。',
  },
];

const team = [
  {
    name: '比利陳 Billy Chen',
    role: '行銷工作者、內容創作者',
    bio: '擁有十多年行銷相關工作經驗，曾參與產品管理、品牌行銷、數位行銷、內容經營與廣告投放等工作。出版過《從零開始自媒體》、《寫給大家的行銷書》、《人人都做得到的知識變現》等書。除了工作，也持續經營自己的內容平台，透過文章、影片與社群記錄觀察、研究和實際嘗試。',
    avatar: '/avatar.webp',
  },
];
---

<MarketingLayout
  title={`關於我 - ${siteConfig.name}`}
  description="認識比利陳。擁有十多年行銷經驗，持續研究 AI、內容、個人品牌與商業世界的變化。"
>
  <PageHeader title="關於比利" align="center" maxWidth="lg">
    <div class="max-w-3xl mx-auto">
      <div class="mt-6 space-y-5 text-lg text-text-muted leading-relaxed">
        <p>
          我是比利陳（Billy Chen），一個做了十多年行銷的人。過去的工作經歷涵蓋產品管理、品牌行銷與數位行銷，也出版過《從零開始自媒體》、《寫給大家的行銷書》、《人人都做得到的知識變現》等書。
        </p>

        <p>
          這些年，我一直對行銷、科技、商業與內容之間的關係很感興趣。一個產品為什麼有人買？一個品牌如何建立影響力？內容如何累積價值？當科技與市場發生變化，個人的工作和發展機會又會受到什麼影響？
        </p>

        <p>
          最近幾年，AI 成為我投入很多時間研究的領域。我會使用不同的 AI 工具，也會把它們放進實際工作與內容製作流程中，測試哪些事情真的做得到，以及它們可能帶來什麼新的可能性。
        </p>

        <p>
          這個網站記錄我對這些事情的研究、觀察與實際經驗。內容不會只集中在單一領域，也不會只有工具教學。我更感興趣的是，一個新技術、一種新做法或一個市場現象，背後究竟正在發生什麼變化。
        </p>
      </div>
    </div>
  </PageHeader>

  <ValuesSection
    title="我持續關注的主題"
    items={values}
    variant="card"
    columns={3}
    background="muted"
  />

  <TeamSection
    title="工作與創作經歷"
    members={team}
    columns={1}
    background="default"
  />

  <CTA
    title="在不同平台繼續交流"
    description="除了這個網站，我也透過 YouTube、Threads 與電子報分享研究、觀察和實際經驗。"
    action={{ label: '看看最新文章', href: '/blog' }}
    secondaryAction={{ label: '前往 YouTube', href: 'https://www.youtube.com/@billyselect4' }}
    background="muted"
  />
</MarketingLayout>
