---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { topicAreas, topics as topicList } from '@/lib/topic-curation';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';
import { entityConfig } from '@/config/entity';

/** 經驗以工作類型呈現；作者匿名經營，不公開任職公司與客戶名稱。 */
const experience = [
  '產業：傳統產業、3C 等多個產業',
  '產品：商品企劃（PM）、開發、維運',
  '行銷：品牌策略、整合行銷、廣告策略與投放、會員經營、網站管理',
  '內容：社群媒體、平面設計、內容製作、YouTube、Podcast',
  '數位產品：App 相關專案',
];

/** 領域（由 topic-curation.ts 產生，新增領域會自動出現） */
const topics = topicAreas.map((area) => ({
  name: area.name,
  href: `/topics/${area.slug}/`,
  description: area.summary,
}));

const sources = [
  {
    title: '工作經驗',
    description:
      '來自十多年在產品、品牌、廣告、會員、內容與平台經營上的實際判斷，包含做對的與做錯的。',
  },
  {
    title: '閱讀與研究',
    description:
      '整理公開資料、官方文件、案例與研究，並盡量說明資料從哪裡來、判斷依據是什麼。',
  },
  {
    title: '親自實驗',
    description:
      'AI 工具、工作流程與內容經營，我會先自己動手試，再寫下測試日期、條件與實際結果。',
  },
];

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': entityConfig.ids.profilePage,
  url: entityConfig.aboutUrl,
  name: `關於 ${entityConfig.canonicalBrand}`,
  description: entityConfig.bio,
  inLanguage: 'zh-Hant-TW',
  isPartOf: {
    '@id': entityConfig.ids.website,
  },
  mainEntity: {
    '@id': entityConfig.ids.person,
  },
};

const booksSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${entityConfig.aboutUrl}#books`,
  name: `${entityConfig.personName} 獨立出版電子書`,
  numberOfItems: entityConfig.books.length,
  itemListElement: entityConfig.books.map((book, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Book',
      name: book.title,
      description: book.description,
      url: book.href,
      inLanguage: 'zh-Hant-TW',
      author: {
        '@id': entityConfig.ids.person,
      },
    },
  })),
};
---

<MarketingLayout
  title={`關於 ${entityConfig.canonicalBrand}`}
  description="比利陳｜行銷裡的路人甲（Billy Chen）。十多年 PM、品牌、整合行銷與廣告投放實戰經驗，獨立出版五本電子書，公開聯絡信箱 billy4select@gmail.com。分享 AI 工作流、行銷策略、SEO 與個人事業的實測與觀察。"
  structuredData={[profilePageSchema, booksSchema]}
>
  <Breadcrumbs items={[{ label: '首頁', href: '/' }, { label: '關於我' }]} />

  <!-- 個人基準檔案 -->
  <section class="page-band">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <img
            src={siteConfig.logo}
            alt={entityConfig.canonicalBrand}
            width="80"
            height="80"
            class="h-20 w-20 shrink-0 rounded-full border border-border object-cover shadow-xs"
          />
          <div>
            <p class="text-xs font-bold tracking-[0.16em] text-primary">關於作者</p>
            <h1 class="mt-1.5 text-2xl font-extrabold leading-tight tracking-tight text-text sm:text-3xl md:text-4xl">
              {entityConfig.canonicalBrand}
            </h1>
            <p class="mt-2 text-sm font-medium text-text-muted md:text-base">
              {entityConfig.shortCredentials}
            </p>
          </div>
        </div>

        <p class="mt-6 max-w-2xl text-base leading-relaxed text-text-muted md:text-lg">
          認識比利陳（Billy Chen）與這個知識庫的建立初衷。了解我如何結合十年實戰與親自實測，整理出可驗證、可執行的行銷與 AI 方法。
        </p>

        <dl class="mt-6 grid grid-cols-1 gap-3 rounded-2xl border border-border bg-background/80 p-4 text-xs sm:grid-cols-2 sm:p-5 sm:text-sm">
          <div>
            <dt class="font-semibold text-text-muted">唯一官方網站</dt>
            <dd class="mt-1 font-medium text-text">
              <a href={entityConfig.siteUrl} class="hover:text-primary hover:underline">
                www.billy4select.com
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-text-muted">公開聯絡信箱</dt>
            <dd class="mt-1 font-medium text-text">
              <a href={`mailto:${entityConfig.email}`} class="hover:text-primary hover:underline">
                {entityConfig.email}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <section class="py-12 md:py-16">
      <div class="max-w-3xl">
        <div class="space-y-5 text-lg text-text-muted leading-relaxed">
          <p>
            我是<strong>{entityConfig.canonicalBrand}</strong>（Billy Chen），擁有十多年的 PM、品牌、整合行銷與廣告投放實戰經驗。待過傳統產業與 3C 等不同產業，做過的工作從商品企劃、開發與維運，到網站管理、廣告策略與投放、會員經營，也包含平面設計、社群媒體、內容製作，以及 App、YouTube 與 Podcast 的經營。
          </p>

          <p>
            因為我以匿名方式經營這個網站，不公開任職公司與合作客戶的名稱，所以這裡只談做過的工作類型、可驗證的公開資料與親自實測的過程，以及從中得到的判斷。
          </p>

          <p>
            2025 到 2026 年，我獨立出版了五本電子書，也持續研究 AI 如何改變工作流程、內容行銷與一人商業模式。
          </p>
        </div>

        <ul class="mt-8 space-y-2 text-base text-text-muted">
          {experience.map((item) => (
            <li class="flex gap-2">
              <span class="text-primary" aria-hidden="true">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 為什麼經營 -->
    <section class="py-12 md:py-16 border-t border-border">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          為什麼經營這個網站
        </h2>

        <div class="mt-6 space-y-5 text-text-muted leading-relaxed">
          <p>
            這些年做過不同工作，我發現真正有用的能力，大多不是某個工具或某個技巧，而是看懂問題、做出判斷、再把它變成行動。工具與平台一直在變，但這個過程不太會變。
          </p>
          <p>
            我經營這個網站，是想把自己學到、試過、做過的東西整理下來，讓同樣在工作、轉換跑道或探索發展的人，可以少走一些冤枉路。核心是：讓工作與生活，多一些值得探索的可能。
          </p>
        </div>
      </div>
    </section>

    <!-- 內容從哪裡來 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          內容從哪裡來與查核原則
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          每篇文章的觀點，主要來自下面三種來源。文章會標示發布日期；內容有實質修改時，也會標示最後更新日期，涉及工具規格或額度時盡量附上官方文件與實測條件。
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          {sources.map((item) => (
            <div class="rounded-2xl border border-border bg-surface p-6">
              <h3 class="font-semibold text-text">{item.title}</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 這裡談哪些事 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          這裡長期深耕的主題
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          目前整理了 {topicList.length} 個主題，分成 {topics.length} 個領域，每個主題都是一條照順序讀的路線。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
          {topics.map((topic) => (
            <a
              href={topic.href}
              class="group rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-primary"
            >
              <h3 class="font-semibold text-text group-hover:text-primary">{topic.name}</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{topic.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 出版作品 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          出版作品
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          2025 到 2026 年獨立出版的五本電子書：自媒體經營、行銷架構、知識變現、AI 時代的工作方法，以及流量判讀。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
          {entityConfig.books.map((book) => (
            <a
              href={book.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-primary"
            >
              <h3 class="font-semibold text-text group-hover:text-primary">《{book.title}》</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{book.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary">
                了解更多
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 官方外部平台 -->
    <section class="py-14 border-t border-border">
      <div class="max-w-6xl">
        <h2 class="text-2xl font-bold tracking-tight text-text md:text-3xl">
          官方外部平台與聯絡方式
        </h2>

        <p class="mt-4 max-w-3xl text-text-muted leading-relaxed">
          以下皆為「{entityConfig.canonicalBrand}」本人經營的官方帳號與電子報。合作或讀者來信請寄至
          <a href={`mailto:${entityConfig.email}`} class="font-semibold text-primary hover:underline">
            {entityConfig.email}
          </a>
          。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
          {entityConfig.externalProfiles.map((profile) => (
            <a
              href={profile.href}
              target="_blank"
              rel="me noopener noreferrer"
              class="group rounded-2xl border border-border p-5 transition-colors hover:border-primary"
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-semibold text-text group-hover:text-primary">
                  {profile.name}
                </h3>
                <span class="text-xs text-text-muted group-hover:text-primary" aria-hidden="true">↗</span>
              </div>
              <p class="mt-1 font-mono text-xs text-primary/80">{profile.handle}</p>
              <p class="mt-2 text-sm text-text-muted leading-relaxed">
                {profile.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- 文章入口 -->
  <CTA
    title="繼續探索"
    description="從主題挑一個開始，或直接看最新文章。"
    action={{ label: '看看最新文章', href: '/blog/' }}
    background="muted"
  />
</MarketingLayout>
