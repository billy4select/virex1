---
/**
 * Index Page - Billy Chen Personal Media
 * 個人知識平台首頁
 *
 * 首頁只負責組裝。主題、專題、問題入口集中在 src/lib/homepage.ts。
 * 最新文章由 blog collection 自動產生，不在首頁手動維護。
 */
import { getCollection } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import TopicGrid from '@/components/home/TopicGrid.astro';
import SeriesGrid from '@/components/home/SeriesGrid.astro';
import QuestionGrid from '@/components/home/QuestionGrid.astro';
import AboutSection from '@/components/home/AboutSection.astro';
import ReaderFeedback from '@/components/home/ReaderFeedback.astro';
import ThemePostRow from '@/components/blog/ThemePostRow.astro';
import { sortByDate } from '@/lib/blog';
import {
  homeQuestions,
  homeSeries,
  homeTopics,
  homepageConfig,
} from '@/lib/homepage';
import { siteConfig } from '@/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);
const latestPosts = sortedPosts.slice(0, homepageConfig.latestCount);

const allTestimonials = await getCollection(
  'testimonials',
  ({ data }) => !data.draft
);
const featuredTestimonials = allTestimonials.filter((item) => item.data.featured);
const readerFeedback = (featuredTestimonials.length > 0 ? featuredTestimonials : allTestimonials)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, homepageConfig.feedbackCount)
  .map((item) => ({
    quote: item.data.quote,
    author: item.data.author,
    role: item.data.role,
    company: item.data.company,
    avatar: item.data.avatar,
  }));
---

<MarketingLayout
  title={`${siteConfig.name}`}
  description="比利陳的自我成長知識平台，從能力與學習、商業與思考、個人發展與事業、行銷與品牌四個方向，分享研究、實驗與觀察。"
>
  <!-- \u2060 是零寬不換行字元，避免「更／多」在手機被拆成兩行 -->
  <Hero
    title={"持續學習，讓自己有更\u2060多可能。"}
    subtitle="透過知識、工具、實驗與觀察，理解正在發生的變化，提升自己的能力，探索更多發展機會。"
    trustLine="比利陳｜十多年行銷相關經驗、出版三本書，持續整理學習、商業、行銷與個人發展的研究、實驗與觀察。"
    primaryCTA={{
      label: '探索主題',
      href: '#topics'
    }}
    secondaryCTA={{
      label: '從這裡開始',
      href: '#questions'
    }}
    minHeight="large"
  />

  <TopicGrid topics={homeTopics} />

  <QuestionGrid questions={homeQuestions} />

  {readerFeedback.length > 0 && <ReaderFeedback testimonials={readerFeedback} />}

  <SeriesGrid series={homeSeries} />

  <section id="latest" class="bg-surface py-16 md:py-20" aria-labelledby="latest-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="latest-title" class="text-3xl font-extrabold tracking-tight text-text md:text-4xl">
          {homepageConfig.latestTitle}
        </h2>
        <a
          href="/blog/"
          class="inline-flex items-center gap-1 text-sm font-semibold text-primary underline decoration-primary/30 decoration-1 underline-offset-4 transition-colors hover:text-primary-dark hover:decoration-primary"
        >
          查看全部文章
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-6 border-t border-border">
        {
          latestPosts.map((post) => (
            <ThemePostRow post={post} />
          ))
        }
      </div>
    </div>
  </section>

  <AboutSection postCount={allPosts.length} />
</MarketingLayout>
