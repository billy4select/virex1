---
/**
 * Index Page - Billy Chen Personal Media
 * 個人知識平台首頁
 *
 * 首頁只負責組裝。主題、專題、問題入口集中在 src/lib/homepage.ts。
 * 最新文章由 blog collection 自動產生，不在首頁手動維護。
 */
import { getCollection } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import TopicGrid from '@/components/home/TopicGrid.astro';
import SeriesGrid from '@/components/home/SeriesGrid.astro';
import QuestionGrid from '@/components/home/QuestionGrid.astro';
import AboutSection from '@/components/home/AboutSection.astro';
import ReaderFeedback from '@/components/home/ReaderFeedback.astro';
import FeaturedPostCard from '@/components/home/FeaturedPostCard.astro';
import ThemePostRow from '@/components/blog/ThemePostRow.astro';
import { sortByDate } from '@/lib/blog';
import {
  homeQuestions,
  homeSeries,
  homeTopics,
  homepageConfig,
} from '@/lib/homepage';
import { siteConfig } from '@/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);
const featuredPost =
  sortedPosts.find((post) => post.id === homepageConfig.featuredPostId) ??
  sortedPosts[0];
const latestPosts = sortedPosts
  .filter((post) => post.id !== featuredPost?.id)
  .slice(0, homepageConfig.latestCount);

const allTestimonials = await getCollection(
  'testimonials',
  ({ data }) => !data.draft
);
const featuredTestimonials = allTestimonials.filter((item) => item.data.featured);
const readerFeedback = (featuredTestimonials.length > 0 ? featuredTestimonials : allTestimonials)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, homepageConfig.feedbackCount)
  .map((item) => ({
    quote: item.data.quote,
    author: item.data.author,
    role: item.data.role,
    company: item.data.company,
    avatar: item.data.avatar,
  }));
---

<MarketingLayout
  title={`${siteConfig.name}`}
  description="比利陳的個人知識平台。以自我發展為核心，整理 AI、商業與個人發展的研究、實驗與觀察。"
>
  <Hero
    title="持續學習，讓自己有更多可能。"
    subtitle="透過知識、工具、實驗與觀察，理解正在發生的變化，提升自己的能力，探索更多發展機會。"
    trustLine="比利陳｜10 年整合行銷、出版三本書，現在整理 AI、商業與個人發展的研究與實驗。"
    primaryCTA={{
      label: '探索主題',
      href: '#topics'
    }}
    secondaryCTA={{
      label: '從這裡開始',
      href: '#questions'
    }}
    minHeight="compact"
  />

  <TopicGrid topics={homeTopics} />

  <QuestionGrid questions={homeQuestions} />

  {readerFeedback.length > 0 && <ReaderFeedback testimonials={readerFeedback} />}

  <SeriesGrid series={homeSeries} />

  <section id="latest" class="bg-background py-16 md:py-20" aria-labelledby="latest-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary">
            持續累積
          </p>
          <h2 id="latest-title" class="mt-3 text-3xl font-extrabold tracking-tight text-text md:text-4xl">
            {homepageConfig.latestTitle}
          </h2>
          <p class="mt-3 text-base leading-relaxed text-text-muted">
            {homepageConfig.latestDescription}
          </p>
        </div>
        <a
          href="/blog/"
          class="inline-flex items-center gap-1 text-sm font-semibold text-primary transition-colors hover:text-primary-dark"
        >
          查看全部文章
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-8">
        {featuredPost && (
          <FeaturedPostCard post={featuredPost} label={homepageConfig.featuredLabel} />
        )}
      </div>

      <div class="mt-10 flex flex-wrap items-end justify-between gap-3 border-b border-border pb-3">
        <h3 class="text-xl font-bold tracking-tight text-text">最新文章</h3>
        <span class="text-xs font-medium text-text-muted">依發布時間</span>
      </div>

      <div>
        {
          latestPosts.map((post) => (
            <ThemePostRow post={post} />
          ))
        }
      </div>
    </div>
  </section>

  <AboutSection postCount={allPosts.length} />
</MarketingLayout>
