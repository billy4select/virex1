---
/**
 * Index Page - 比利陳｜行銷裡的路人甲
 * 個人知識平台首頁（2026-11 改版）
 */
import { getCollection } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import ExploreGrid from '@/components/home/ExploreGrid.astro';
import ThinkingSection from '@/components/home/ThinkingSection.astro';
import SeriesGrid from '@/components/home/SeriesGrid.astro';
import AboutSection from '@/components/home/AboutSection.astro';
import ReaderFeedback from '@/components/home/ReaderFeedback.astro';
import ThemePostRow from '@/components/blog/ThemePostRow.astro';
import { sortByDate } from '@/lib/blog';
import {
  homeExploreEntries,
  homeSeries,
  homeThinkingPosts,
  homepageConfig,
} from '@/lib/homepage';
import { siteConfig } from '@/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortByDate(allPosts);
const latestPosts = sortedPosts.slice(0, homepageConfig.latestCount);

const postById = new Map(allPosts.map((p) => [p.id, p]));
const thinkingPosts = homeThinkingPosts
  .map((id) => postById.get(id))
  .filter((p): p is NonNullable<typeof p> => !!p)
  .slice(0, homepageConfig.thinkingCount);

const allTestimonials = await getCollection(
  'testimonials',
  ({ data }) => !data.draft
);
const featuredTestimonials = allTestimonials.filter((item) => item.data.featured);
const readerFeedback = (featuredTestimonials.length > 0 ? featuredTestimonials : allTestimonials)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, homepageConfig.feedbackCount)
  .map((item) => ({
    quote: item.data.quote,
    author: item.data.author,
    role: item.data.role,
    company: item.data.company,
    avatar: item.data.avatar,
  }));
---

<MarketingLayout
  title={`${siteConfig.name}`}
  description={siteConfig.description}
>
  <Hero
    title={"讓工作與生活，\n多一些值得探索的可能。"}
    subtitle="分享值得使用的工具、值得學習的方法、值得閱讀的內容，以及對行銷、商業、AI、工作與個人成長的觀察。"
    primaryCTA={{
      label: '探索文章',
      href: '/blog/',
    }}
    secondaryCTA={{
      label: '認識比利',
      href: '/about/',
    }}
    minHeight="large"
  />

  <!-- 01 從你感興趣的事情開始 -->
  <ExploreGrid entries={homeExploreEntries} />

  <!-- 02 一些值得思考的事 -->
  {thinkingPosts.length > 0 && <ThinkingSection posts={thinkingPosts} />}

  <!-- 03 深入學習 -->
  <SeriesGrid series={homeSeries} />

  <!-- 04 最新文章 -->
  <section id="latest" class="bg-background py-16 md:py-24" aria-labelledby="latest-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="latest-title" class="text-2xl font-extrabold tracking-tight text-text md:text-3xl">
            {homepageConfig.latestTitle}
          </h2>
        </div>
        <a
          href="/blog/"
          class="inline-flex items-center gap-1 text-sm font-semibold text-primary transition-colors hover:underline"
        >
          查看全部文章
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-10 space-y-2">
        {
          latestPosts.map((post) => (
            <ThemePostRow post={post} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 05 讀者怎麼說 -->
  {readerFeedback.length > 0 && <ReaderFeedback testimonials={readerFeedback} />}

  <!-- 06 關於比利陳 + 把新文章寄給你 -->
  <AboutSection postCount={allPosts.length} />
</MarketingLayout>
