
---
import { getCollection } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { siteConfig } from '@/config';
import { calculateReadingTime } from '@/lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const latestPosts = allPosts
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 4);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<MarketingLayout
  title={siteConfig.name}
  description="比利陳的個人網站。分享 AI、商業、行銷、投資與工作上的研究、實驗和觀察。"
>
  <main class="bg-white dark:bg-gray-950">

    <!-- 個人介紹 -->
    <section class="max-w-5xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-6">
          Billy Chen
        </p>

        <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight text-gray-900 dark:text-white">
          關於 AI、商業、行銷，<br class="hidden md:block" />
          以及正在發生的變化。
        </h1>

        <p class="mt-8 text-lg leading-relaxed text-gray-600 dark:text-gray-300 max-w-2xl">
          我是比利陳，做了十幾年行銷。
          平常喜歡研究 AI、商業、投資、個人品牌，以及各種正在改變工作與生活的新事物。
          這裡記錄我的研究、實驗與觀察。
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/blog"
            class="inline-flex items-center px-5 py-3 rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900 text-sm font-semibold hover:opacity-80 transition"
          >
            閱讀文章
            <span class="ml-2">→</span>
          </a>

          <a
            href="/about"
            class="inline-flex items-center px-5 py-3 rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-semibold hover:bg-gray-50 dark:hover:bg-gray-900 transition"
          >
            關於我
          </a>
        </div>
      </div>
    </section>

    <!-- 最新文章 -->
    <section class="border-t border-gray-100 dark:border-gray-800">
      <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">

        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-3">
              Latest Articles
            </p>
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
              最新文章
            </h2>
          </div>

          <a
            href="/blog"
            class="text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white transition"
          >
            所有文章 →
          </a>
        </div>

        <div class="divide-y divide-gray-100 dark:divide-gray-800">
          {latestPosts.map((post) => (
            <article class="py-7 first:pt-0 last:pb-0">
              <a href={`/blog/${post.id}`} class="group block">
                <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400 mb-3">
                  <time>{formatDate(post.data.publishedDate)}</time>
                  <span>·</span>
                  <span>{calculateReadingTime(post.body || '')} 分鐘閱讀</span>
                  {post.data.category && (
                    <>
                      <span>·</span>
                      <span>{post.data.category}</span>
                    </>
                  )}
                </div>

                <h3 class="text-xl md:text-2xl font-semibold leading-snug text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                  {post.data.title}
                </h3>

                <p class="mt-3 text-sm md:text-base leading-relaxed text-gray-500 dark:text-gray-400 max-w-3xl">
                  {post.data.description}
                </p>
              </a>
            </article>
          ))}
        </div>

        <div class="mt-12">
          <a
            href="/blog"
            class="text-sm font-semibold text-gray-900 dark:text-white hover:opacity-60 transition"
          >
            瀏覽所有文章 →
          </a>
        </div>

      </div>
    </section>

    <!-- 保持聯繫 -->
    <section class="border-t border-gray-100 dark:border-gray-800">
      <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            保持聯繫
          </h2>

          <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">
            如果你也喜歡探索新事物，歡迎透過社群持續交流。
          </p>

          <a
            href="https://line.me/ti/g2/RSL2m-6lcwDLR6RJ-XfMGMZnomMixnbD3jrBUw"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center mt-6 text-sm font-semibold text-gray-900 dark:text-white hover:opacity-60 transition"
          >
            加入 LINE 社群 →
          </a>
        </div>
      </div>
    </section>

  </main>
</MarketingLayout>
