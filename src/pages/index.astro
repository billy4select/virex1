---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import BentoGrid from '@sections/marketing/BentoGrid.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
const featuredPosts = [
  ...posts.filter((post) => post.data.featured),
  ...posts.filter((post) => post.data.boost && !post.data.featured),
  ...posts.filter((post) => !post.data.featured && !post.data.boost),
].slice(0, 3);
const latestPosts = posts.slice(0, 4);
const dateLabel = (date: Date) => date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });

const topics = [
  { title: 'AI 與工作方式', description: '從工具實測到工作流程，觀察 AI 如何改變個人與組織的工作。', icon: 'lucide:cpu', size: 'large' as const, accent: 'blue' as const, href: '/blog' },
  { title: '內容與個人品牌', description: '內容、自媒體、知識產品，以及個人如何建立自己的事業。', icon: 'lucide:pen-tool', accent: 'purple' as const, href: '/blog' },
  { title: '商業與行銷', description: '從品牌、產品與企業案例，理解生意如何運作。', icon: 'lucide:briefcase-business', accent: 'orange' as const, href: '/blog' },
  { title: '市場與投資', description: '觀察公司、產業與市場變化，理解價格背後的商業邏輯。', icon: 'lucide:chart-no-axes-combined', accent: 'green' as const, href: '/blog' },
];
---

<MarketingLayout
  title={siteConfig.name}
  description="比利陳的個人網站。關注 AI、內容、商業、行銷與市場，記錄研究、實驗與觀察。"
>
  <main class="billy-home-v2">
    <section class="hero-v2">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="hero-v2-inner">
        <div class="hero-v2-copy">
          <div class="hero-kicker"><span class="kicker-dot"></span> BILLY CHEN · IDEAS IN MOTION</div>
          <h1>看懂正在發生的事，<br /><span>找到背後的商業邏輯。</span></h1>
          <p>我是比利陳，做了十多年行銷。這裡記錄我對 AI、內容、商業與市場的研究、實驗和觀察，也整理那些值得花時間理解的問題。</p>
          <div class="hero-buttons">
            <a class="hero-button-main" href="/blog">從文章開始 <Icon name="lucide:arrow-up-right" /></a>
            <a class="hero-button-sub" href="/about">認識比利 <Icon name="lucide:arrow-right" /></a>
          </div>
          <div class="hero-footnote"><span>MARKETING · TECHNOLOGY · BUSINESS</span><span>TAIPEI, TAIWAN</span></div>
        </div>
        <div class="hero-visual" aria-label="關注領域示意">
          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>
          <div class="visual-core"><span>觀察</span><strong>→</strong><span>理解</span></div>
          <div class="visual-node node-ai"><Icon name="lucide:cpu" /><span>AI</span></div>
          <div class="visual-node node-content"><Icon name="lucide:book-open" /><span>內容</span></div>
          <div class="visual-node node-business"><Icon name="lucide:briefcase-business" /><span>商業</span></div>
          <div class="visual-node node-market"><Icon name="lucide:chart-no-axes-combined" /><span>市場</span></div>
          <div class="visual-caption">從不同領域，追問相似的問題</div>
        </div>
      </div>
      <div class="hero-bottom-line"><span>RESEARCH NOTES / 2026</span><span>SCROLL TO EXPLORE ↓</span></div>
    </section>

    <section class="intro-strip">
      <div class="intro-strip-label">WHY THIS SITE</div>
      <div class="intro-strip-copy">
        <h2>一個新工具、一家公司，或一個市場現象，背後通常都有值得理解的原因。</h2>
        <p>我會從具體案例、資料與實際使用經驗出發，把正在研究的問題寫成文章。主題不一定相同，但都和我們如何工作、創造價值，以及理解這個世界有關。</p>
      </div>
    </section>

    <BentoGrid
      title="我持續關注的四個領域"
      subtitle="從 AI 到商業，從內容到市場。每個領域都有不同的問題值得追下去。"
      items={topics}
      background="muted"
    />

    <section class="featured-v2">
      <div class="section-topline">
        <div><span class="section-eyebrow">SELECTED READING</span><h2>從這幾篇開始</h2></div>
        <a href="/blog" class="section-more">所有文章 <Icon name="lucide:arrow-up-right" /></a>
      </div>
      <div class="featured-layout">
        {featuredPosts.map((post, index) => (
          <a href={`/blog/${post.id}`} class:list={['featured-card', `featured-card-${index + 1}`]}>
            <div class="featured-card-top"><span>{post.data.category}</span><span>{dateLabel(post.data.publishedDate)}</span></div>
            {post.data.image ? <img class="featured-image" src={post.data.image} alt={post.data.title} loading="lazy" /> : <div class="featured-art"><span>{String(index + 1).padStart(2, '0')}</span><Icon name={index === 0 ? 'lucide:lightbulb' : index === 1 ? 'lucide:layers-3' : 'lucide:compass'} /></div>}
            <div class="featured-card-copy"><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-link">閱讀文章 <Icon name="lucide:arrow-up-right" /></span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="latest-v2">
      <div class="section-topline">
        <div><span class="section-eyebrow">THE LATEST</span><h2>最近的文章</h2></div>
        <p>持續更新的研究、實驗與觀察。</p>
      </div>
      <div class="latest-v2-list">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="latest-v2-row">
            <span class="latest-v2-date">{dateLabel(post.data.publishedDate)}</span>
            <span class="latest-v2-category">{post.data.category}</span>
            <strong>{post.data.title}</strong>
            <Icon name="lucide:arrow-up-right" />
          </a>
        ))}
      </div>
    </section>

    <section class="books-v2">
      <div class="books-v2-heading"><span class="section-eyebrow">BOOKS & PROJECTS</span><h2>也有一些累積下來的作品</h2><p>過去出版與參與的作品，整理在這裡。</p></div>
      <div class="book-items">
        <a href="https://portaly.cc/billyselect4/product/ioeupgO66jK7vB24yJzY" target="_blank" rel="noopener noreferrer"><span class="book-symbol book-symbol-a"><Icon name="lucide:book-open" /></span><span><strong>《從零開始自媒體》</strong><small>自媒體與內容經營</small></span><Icon name="lucide:arrow-up-right" /></a>
        <a href="https://portaly.cc/billyselect4/product/jLrib0ZgLmXWs2WOTiy8" target="_blank" rel="noopener noreferrer"><span class="book-symbol book-symbol-b"><Icon name="lucide:brain-circuit" /></span><span><strong>《AI時代職場生存法則》</strong><small>AI、工作與個人能力</small></span><Icon name="lucide:arrow-up-right" /></a>
        <a href="https://portaly.cc/billyselect4" target="_blank" rel="noopener noreferrer"><span class="book-symbol book-symbol-c"><Icon name="lucide:library" /></span><span><strong>其他出版作品</strong><small>行銷、流量與知識變現</small></span><Icon name="lucide:arrow-up-right" /></a>
      </div>
    </section>

    <CTA
      title="如果你也對這些問題有興趣"
      description="歡迎到社群交流，分享你正在觀察的現象，或是最近遇到的問題。"
      action={{ label: '加入 LINE 社群', href: 'https://line.me/ti/g2/RSL2m-6lcwDLR6RJ-XfMGMZnomMixnbD3jrBUw' }}
      secondaryAction={{ label: '追蹤 Threads', href: 'https://www.threads.net/@billy4select' }}
      background="muted"
    />
  </main>
</MarketingLayout>

<style>
  .billy-home-v2 { color: var(--color-text); overflow: hidden; }
  .hero-v2 { position: relative; overflow: hidden; background: #101d35; color: #fff; padding: clamp(4.5rem, 8vw, 7.5rem) max(1.5rem, calc((100vw - 1180px) / 2)) 1.4rem; }
  .hero-v2::before { content: ''; position: absolute; inset: 0; opacity: .18; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 54px 54px; mask-image: linear-gradient(90deg, #000, transparent 90%); }
  .hero-glow { position: absolute; border-radius: 50%; filter: blur(2px); pointer-events: none; }
  .hero-glow-one { width: 520px; height: 520px; background: #315d9a; opacity: .25; right: 4%; top: -42%; }
  .hero-glow-two { width: 380px; height: 380px; background: #e28b54; opacity: .12; right: 28%; bottom: -60%; }
  .hero-v2-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: center; }
  .hero-kicker, .hero-footnote, .hero-bottom-line, .section-eyebrow { font-size: .68rem; letter-spacing: .16em; font-weight: 700; }
  .hero-kicker { color: #a9bdd9; display: flex; align-items: center; gap: .65rem; }
  .kicker-dot { width: 7px; height: 7px; background: #f0a66f; border-radius: 50%; box-shadow: 0 0 0 5px #f0a66f22; }
  .hero-v2 h1 { margin: 1.7rem 0 1.4rem; font-size: clamp(2.6rem, 5vw, 4.65rem); line-height: 1.2; letter-spacing: -.055em; font-weight: 800; }
  .hero-v2 h1 span { color: #f2ad7c; }
  .hero-v2-copy > p { max-width: 600px; color: #c2ccda; line-height: 2; font-size: 1rem; }
  .hero-buttons { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.2rem; }
  .hero-button-main, .hero-button-sub { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; font-size: .88rem; font-weight: 700; }
  .hero-button-main { background: #f0a66f; color: #18243a; padding: .95rem 1.25rem; border-radius: .55rem; }
  .hero-button-main:hover { background: #ffc08f; }
  .hero-button-sub { color: #fff; }
  .hero-button-main :global(svg), .hero-button-sub :global(svg) { width: 17px; height: 17px; }
  .hero-footnote { display: flex; gap: 1.4rem; color: #7f93af; font-size: .58rem; margin-top: 4rem; }
  .hero-visual { min-height: 390px; position: relative; display: flex; align-items: center; justify-content: center; }
  .visual-orbit { position: absolute; border: 1px solid #8ba5c333; border-radius: 50%; transform: rotate(-22deg); }
  .orbit-one { width: 340px; height: 230px; }
  .orbit-two { width: 270px; height: 350px; transform: rotate(55deg); border-color: #f0a66f44; }
  .visual-core { width: 150px; height: 150px; border-radius: 36px; background: linear-gradient(145deg, #f3b27f, #d67a54); box-shadow: 0 25px 80px #0005; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #19253a; transform: rotate(-7deg); }
  .visual-core span { font-size: 1rem; font-weight: 750; }
  .visual-core strong { font-size: 1.4rem; line-height: 1.1; }
  .visual-node { position: absolute; display: flex; align-items: center; gap: .55rem; padding: .7rem .9rem; border: 1px solid #ffffff28; border-radius: 12px; background: #ffffff12; backdrop-filter: blur(10px); color: #e7edf7; font-size: .82rem; font-weight: 650; box-shadow: 0 12px 35px #0002; }
  .visual-node :global(svg) { width: 18px; height: 18px; color: #f0a66f; }
  .node-ai { top: 13%; left: 14%; }.node-content { top: 22%; right: 4%; }.node-business { bottom: 20%; left: 4%; }.node-market { bottom: 12%; right: 12%; }
  .visual-caption { position: absolute; bottom: 0; color: #8094b0; font-size: .68rem; letter-spacing: .08em; }
  .hero-bottom-line { max-width: 1180px; margin: 4rem auto 0; padding-top: 1rem; border-top: 1px solid #ffffff26; display: flex; justify-content: space-between; color: #8194ae; font-size: .58rem; }
  .intro-strip { max-width: 1180px; margin: 0 auto; padding: 5rem 1.5rem; display: grid; grid-template-columns: .45fr 1.55fr; gap: 3rem; align-items: start; }
  .intro-strip-label { color: #c4774e; font-size: .68rem; font-weight: 800; letter-spacing: .15em; padding-top: .55rem; }
  .intro-strip-copy h2 { max-width: 850px; margin: 0; font-size: clamp(1.65rem, 3vw, 2.45rem); line-height: 1.45; letter-spacing: -.04em; }
  .intro-strip-copy p { max-width: 780px; color: var(--color-text-muted); line-height: 2; margin: 1.25rem 0 0; }
  .featured-v2, .latest-v2, .books-v2 { max-width: 1180px; margin: 0 auto; padding: 5rem 1.5rem; }
  .featured-v2 { border-top: 1px solid var(--color-border); }
  .section-topline { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .section-eyebrow { color: #c4774e; display: block; margin-bottom: .7rem; }
  .section-topline h2, .books-v2 h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -.045em; }
  .section-more { display: inline-flex; gap: .5rem; align-items: center; text-decoration: none; color: var(--color-text); font-weight: 700; font-size: .85rem; }
  .section-more :global(svg) { width: 17px; }
  .featured-layout { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 1rem; }
  .featured-card { min-width: 0; text-decoration: none; color: inherit; border-radius: 1rem; overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border); transition: transform .2s ease, box-shadow .2s ease; }
  .featured-card:hover { transform: translateY(-5px); box-shadow: 0 18px 45px #00000012; }
  .featured-card-top { display: flex; justify-content: space-between; gap: .5rem; padding: 1rem 1.1rem 0; color: var(--color-text-muted); font-size: .68rem; }
  .featured-image, .featured-art { display: flex; width: calc(100% - 2.2rem); height: 150px; object-fit: cover; margin: 1rem 1.1rem 0; border-radius: .7rem; }
  .featured-art { align-items: center; justify-content: space-between; padding: 1.2rem; background: linear-gradient(135deg, #dce8f4, #f1dfd1); color: #355274; }
  .featured-card-2 .featured-art { background: linear-gradient(135deg, #e5e0f2, #dce9e8); color: #66568a; }
  .featured-card-3 .featured-art { background: linear-gradient(135deg, #f1e7d3, #e8d8d1); color: #a15e43; }
  .featured-art span { font-size: 3.8rem; font-weight: 850; letter-spacing: -.08em; opacity: .65; }
  .featured-art :global(svg) { width: 48px; height: 48px; }
  .featured-card-copy { padding: 1.2rem 1.2rem 1.3rem; }
  .featured-card-copy h3 { margin: 0 0 .7rem; font-size: 1.15rem; line-height: 1.5; }
  .featured-card-copy p { margin: 0; color: var(--color-text-muted); font-size: .82rem; line-height: 1.8; }
  .read-link { display: flex; align-items: center; gap: .4rem; margin-top: 1.2rem; font-size: .75rem; font-weight: 750; color: #bd704a; }
  .read-link :global(svg) { width: 15px; }
  .latest-v2 { border-top: 1px solid var(--color-border); }
  .latest-v2 .section-topline > p { margin: 0 0 .3rem; color: var(--color-text-muted); font-size: .85rem; }
  .latest-v2-list { border-top: 1px solid var(--color-border); }
  .latest-v2-row { display: grid; grid-template-columns: 110px 120px minmax(0,1fr) 22px; gap: 1rem; align-items: center; padding: 1.2rem .2rem; border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
  .latest-v2-row:hover strong, .latest-v2-row:hover :global(svg) { color: #bd704a; }
  .latest-v2-date, .latest-v2-category { color: var(--color-text-muted); font-size: .72rem; }
  .latest-v2-row strong { font-size: .92rem; line-height: 1.55; }
  .latest-v2-row :global(svg) { width: 17px; color: #bd704a; }
  .books-v2 { border-top: 1px solid var(--color-border); display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; }
  .books-v2-heading p { color: var(--color-text-muted); font-size: .88rem; }
  .book-items { display: flex; flex-direction: column; }
  .book-items a { display: grid; grid-template-columns: 48px minmax(0,1fr) 20px; gap: 1rem; align-items: center; padding: .8rem 0; border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
  .book-items a:first-child { border-top: 1px solid var(--color-border); }
  .book-items a > :global(svg) { width: 17px; color: #bd704a; }
  .book-symbol { width: 44px; height: 50px; border-radius: 6px 10px 10px 6px; display: grid; place-items: center; box-shadow: inset 4px 0 #00000012; }
  .book-symbol :global(svg) { width: 20px; height: 20px; }
  .book-symbol-a { background: #dce8f4; color: #355274; }.book-symbol-b { background: #f2dfd2; color: #a15e43; }.book-symbol-c { background: #e4e1ef; color: #66568a; }
  .book-items strong, .book-items small { display: block; }.book-items strong { font-size: .9rem; }.book-items small { margin-top: .3rem; color: var(--color-text-muted); font-size: .72rem; }
  @media (max-width: 850px) { .hero-v2-inner { grid-template-columns: 1fr; }.hero-visual { min-height: 330px; max-width: 520px; width: 100%; margin: 0 auto; }.intro-strip { grid-template-columns: 1fr; gap: 1rem; }.featured-layout { grid-template-columns: 1fr 1fr; }.featured-card:first-child { grid-column: span 2; }.books-v2 { grid-template-columns: 1fr; gap: 1.5rem; } }
  @media (max-width: 560px) { .hero-v2 { padding-top: 4rem; }.hero-v2 h1 { font-size: 2.55rem; }.hero-visual { min-height: 290px; transform: scale(.9); }.orbit-one { width: 280px; }.orbit-two { height: 300px; }.node-ai { left: 0; }.node-content { right: 0; }.node-business { left: 0; }.node-market { right: 0; }.hero-footnote { flex-direction: column; gap: .5rem; margin-top: 3rem; }.hero-bottom-line { margin-top: 2.5rem; }.intro-strip, .featured-v2, .latest-v2, .books-v2 { padding-top: 3.5rem; padding-bottom: 3.5rem; }.section-topline { align-items: start; flex-direction: column; gap: .8rem; }.featured-layout { grid-template-columns: 1fr; }.featured-card:first-child { grid-column: auto; }.latest-v2-row { grid-template-columns: 1fr 20px; gap: .35rem .8rem; }.latest-v2-date { grid-column: 1; }.latest-v2-category { display: none; }.latest-v2-row strong { grid-column: 1; }.latest-v2-row > :global(svg) { grid-column: 2; grid-row: 1 / span 2; } }
</style>
